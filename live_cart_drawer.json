  <style>
    .password-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #fff0f5 0%, #fde5eb 100%);
      padding: 24px;
      text-align: center;
      font-family: Poppins, Arial, sans-serif;
    }
    .password-card {
      max-width: 480px;
      width: 100%;
      background: #ffffff;
      border: 1px solid #ffdeea;
      border-radius: 16px;
      padding: 40px 32px;
      box-shadow: 0 10px 30px rgba(249, 54, 133, 0.08);
    }
    .password-logo {
      width: 140px;
      height: auto;
      margin: 0 auto 20px;
      display: block;
    }
    .password-title {
      font-family: 'Times New Roman', serif;
      font-size: 28px;
      color: #101010;
      margin-bottom: 12px;
    }
    .password-title span {
      color: #f93685;
      font-family: Allura, cursive;
      font-size: 34px;
      display: block;
    }
    .password-desc {
      font-size: 13px;
      color: #666;
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .password-form input {
      width: 100%;
      height: 44px;
      border: 1px solid #f3dce6;
      border-radius: 8px;
      padding: 0 16px;
      font-size: 13px;
      margin-bottom: 12px;
      box-sizing: border-box;
    }
    .password-form button {
      width: 100%;
      height: 44px;
      background: linear-gradient(110deg, #ed4c9b, #f3388c);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 0.5px;
      cursor: pointer;
    }
  </style>
