{%- assign design_block = section.blocks | where: 'type', 'mega_menu_design' | first -%}
{%- assign b_d = design_block.settings -%}
<div id="shop-by-design-menu" class="shop-by-design-menu" hidden aria-label="Shop By Design menu" data-mega-menu-target="shop-by-design-menu" {{ design_block.shopify_attributes }}>
  <div class="shop-by-design-pointer" aria-hidden="true"></div>
  <div class="shop-by-design-body">
    <!-- Col 1: Shapes -->
    <div class="sbd-col">
      <div>
        <h3 class="sbd-col-title">{{ b_d.shapes_title | default: section.settings.menu_design_1 | default: 'SHOP BY SHAPE' | escape }} <span class="sbd-heart">💕</span></h3>
        <div class="sbd-items">
          <a class="sbd-shape-item" href="{{ routes.root_url }}pages/shop-by-design?shape=almond" data-shape="almond">
            <img class="sbd-shape-icon" src="{{ 'shape-almond.png' | asset_url }}" alt="Almond shape" loading="lazy" width="25" height="42">
            <strong>{{ section.settings.menu_design_2 | default: 'Almond' | escape }}</strong>
          </a>
          <a class="sbd-shape-item" href="{{ routes.root_url }}pages/shop-by-design?shape=square" data-shape="square">
            <img class="sbd-shape-icon" src="{{ 'shape-square.png' | asset_url }}" alt="Square shape" loading="lazy" width="25" height="42">
            <strong>{{ section.settings.menu_design_3 | default: 'Square' | escape }}</strong>
          </a>
          <a class="sbd-shape-item" href="{{ routes.root_url }}pages/shop-by-design?shape=oval" data-shape="oval">
            <img class="sbd-shape-icon" src="{{ 'shape-oval.png' | asset_url }}" alt="Oval shape" loading="lazy" width="25" height="42">
            <strong>{{ section.settings.menu_design_4 | default: 'Oval' | escape }}</strong>
          </a>
          <a class="sbd-shape-item" href="{{ routes.root_url }}pages/shop-by-design?shape=coffin" data-shape="coffin">
            <img class="sbd-shape-icon" src="{{ 'shape-coffin.png' | asset_url }}" alt="Coffin shape" loading="lazy" width="25" height="42">
            <strong>{{ section.settings.menu_design_5 | default: 'Coffin' | escape }}</strong>
          </a>
          <a class="sbd-shape-item" href="{{ routes.root_url }}pages/shop-by-design?shape=ballerina" data-shape="ballerina">
            <img class="sbd-shape-icon" src="{{ 'shape-ballerina.png' | asset_url }}" alt="Ballerina shape" loading="lazy" width="25" height="42">
            <strong>{{ section.settings.menu_design_6 | default: 'Ballerina' | escape }}</strong>
          </a>
        </div>
      </div>
      <a class="sbd-action-btn" href="{{ b_d.shapes_btn_url | default: section.settings.menu_design_btn_1_url | default: routes.root_url | append: 'pages/shop-by-design' }}">
        {{ b_d.shapes_btn_text | default: section.settings.menu_design_7 | default: 'VIEW ALL SHAPES' | escape }}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
      </a>
    </div>

    <!-- Col 2: Lengths -->
    <div class="sbd-col">
      <div>
        <h3 class="sbd-col-title">{{ b_d.lengths_title | default: section.settings.menu_design_8 | default: 'SHOP BY LENGTH' | escape }} <span class="sbd-heart">💕</span></h3>
        <div class="sbd-items">
          <a class="sbd-length-item" href="{{ routes.root_url }}pages/shop-by-design?length=short" data-length="short">
            <img class="sbd-length-img" src="{{ 'length-short.png' | asset_url }}" alt="Short length" loading="lazy" width="37" height="63">
            <span class="sbd-length-text">
              <strong>{{ section.settings.menu_design_9 | default: 'Short' | escape }}</strong>
              <small>{{ section.settings.menu_design_10 | default: 'Natural & chic' | escape }}</small>
            </span>
          </a>
          <a class="sbd-length-item" href="{{ routes.root_url }}pages/shop-by-design?length=medium" data-length="medium">
            <img class="sbd-length-img" src="{{ 'length-medium.png' | asset_url }}" alt="Medium length" loading="lazy" width="37" height="65">
            <span class="sbd-length-text">
              <strong>{{ section.settings.menu_design_11 | default: 'Medium' | escape }}</strong>
              <small>{{ section.settings.menu_design_12 | default: 'Everyday perfect' | escape }}</small>
            </span>
          </a>
          <a class="sbd-length-item" href="{{ routes.root_url }}pages/shop-by-design?length=long" data-length="long">
            <img class="sbd-length-img" src="{{ 'length-long.png' | asset_url }}" alt="Long length" loading="lazy" width="37" height="67">
            <span class="sbd-length-text">
              <strong>{{ section.settings.menu_design_13 | default: 'Long' | escape }}</strong>
              <small>{{ section.settings.menu_design_14 | default: 'Bold & glamorous' | escape }}</small>
            </span>
          </a>
        </div>
      </div>
      <a class="sbd-action-btn" href="{{ b_d.lengths_btn_url | default: section.settings.menu_design_btn_2_url | default: routes.root_url | append: 'pages/shop-by-design' }}">
        {{ b_d.lengths_btn_text | default: section.settings.menu_design_15 | default: 'VIEW ALL LENGTHS' | escape }}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
      </a>
    </div>

    <!-- Col 3: Colours -->
    <div class="sbd-col">
      <div>
        <h3 class="sbd-col-title">{{ b_d.colours_title | default: section.settings.menu_design_16 | default: 'SHOP BY COLOUR' | escape }} <span class="sbd-heart">💕</span></h3>
        <div class="sbd-colours-grid">
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=pink" data-colour="pink"><span class="sbd-dot" style="background:#ff7aa5;"></span><strong>{{ section.settings.menu_design_17 | default: 'Pink' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=white" data-colour="white"><span class="sbd-dot" style="background:#ffffff; border: 1rem solid #e5d8dc;"></span><strong>{{ section.settings.menu_design_18 | default: 'White' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=blue" data-colour="blue"><span class="sbd-dot" style="background:#84b6f4;"></span><strong>{{ section.settings.menu_design_19 | default: 'Blue' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=black" data-colour="black"><span class="sbd-dot" style="background:#1a1a1a;"></span><strong>{{ section.settings.menu_design_20 | default: 'Black' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=orange" data-colour="orange"><span class="sbd-dot" style="background:#ff9f43;"></span><strong>{{ section.settings.menu_design_21 | default: 'Orange' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=yellow" data-colour="yellow"><span class="sbd-dot" style="background:#ffd32a;"></span><strong>{{ section.settings.menu_design_22 | default: 'Yellow' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=purple" data-colour="purple"><span class="sbd-dot" style="background:#a55eea;"></span><strong>{{ section.settings.menu_design_23 | default: 'Purple' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=green" data-colour="green"><span class="sbd-dot" style="background:#26de81;"></span><strong>{{ section.settings.menu_design_24 | default: 'Green' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=red" data-colour="red"><span class="sbd-dot" style="background:#eb3b5a;"></span><strong>{{ section.settings.menu_design_25 | default: 'Red' | escape }}</strong></a>
          <a class="sbd-colour-item" href="{{ routes.root_url }}pages/shop-by-design?colour=gems" data-colour="gems"><img class="sbd-dot sbd-gems-img" src="{{ 'swatch-gems.png' | asset_url }}" alt="Gems swatch" loading="lazy" width="24" height="24"><strong>{{ section.settings.menu_design_26 | default: 'Gems' | escape }}</strong></a>
        </div>
      </div>
      <a class="sbd-action-btn" href="{{ b_d.colours_btn_url | default: section.settings.menu_design_btn_3_url | default: routes.root_url | append: 'pages/shop-by-design' }}">
        {{ b_d.colours_btn_text | default: section.settings.menu_design_27 | default: 'VIEW ALL COLOURS' | escape }}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
      </a>
    </div>
  </div>
</div>
