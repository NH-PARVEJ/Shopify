<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} &ndash; Opening Soon</title>
  {{ 'style.css' | asset_url | stylesheet_tag }}
  {{ 'refinements.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <style>
    .password-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #fff0f5 0%, #fde5eb 100%);
      padding: 24px;
      text-align: center;
      font-family: Poppins, Arial, sans-serif;
    }
    .password-card {
      max-width: 480px;
      width: 100%;
      background: #ffffff;
      border: 1px solid #ffdeea;
      border-radius: 16px;
      padding: 40px 32px;
      box-shadow: 0 10px 30px rgba(249, 54, 133, 0.08);
    }
    .password-logo {
      width: 140px;
      height: auto;
      margin: 0 auto 20px;
      display: block;
    }
    .password-title {
      font-family: 'Times New Roman', serif;
      font-size: 28px;
      color: #101010;
      margin-bottom: 12px;
    }
    .password-title span {
      color: #f93685;
      font-family: Allura, cursive;
      font-size: 34px;
      display: block;
    }
    .password-desc {
      font-size: 13px;
      color: #666;
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .password-form input {
      width: 100%;
      height: 44px;
      border: 1px solid #f3dce6;
      border-radius: 8px;
      padding: 0 16px;
      font-size: 13px;
      margin-bottom: 12px;
      box-sizing: border-box;
    }
    .password-form button {
      width: 100%;
      height: 44px;
      background: linear-gradient(110deg, #ed4c9b, #f3388c);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 0.5px;
      cursor: pointer;
    }
  </style>
</head>
<body class="password-page">
  <div class="password-card">
    <img src="{{ 'logo-hq-v2.png' | asset_url }}" alt="{{ shop.name }}" class="password-logo" width="2172" height="724">
    <h1 class="password-title">Quick press, <span>instant beauty ♡</span></h1>
    <p class="password-desc">Our salon-quality press-on nail collections are coming soon! Enter your store password below to preview.</p>
    {% form 'storefront_password', class: 'password-form' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" id="password" placeholder="Enter store password" required>
      <button type="submit">ENTER STORE 👑</button>
    {% endform %}
  </div>
{{ content_for_layout }}</body>
</html>
