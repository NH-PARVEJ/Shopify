<div class="content-container customer-order" style="max-width: 800px; margin: 50px auto; padding: 0 16px; min-height: 60vh;">
  <div style="border-bottom: 1px solid #ffdeea; padding-bottom: 16px; margin-bottom: 24px;">
    <h1 style="font-family: 'Times New Roman', serif; font-size: 32px; margin: 0 0 6px;">
      Order {{ order.name }} <span style="color: #f93685; font-family: Allura, cursive; font-size: 36px;">♡</span>
    </h1>
    <a href="{{ routes.account_url }}" style="font-size: 12px; color: #ed4c9b; text-decoration: underline;">← Back to Account</a>
  </div>

  <div style="border: 1px solid #ffdeea; border-radius: 8px; padding: 20px; background: #fff; margin-bottom: 24px;">
    <p style="margin: 0 0 8px; font-size: 13px;">Placed on {{ order.created_at | date: "%B %d, %Y at %I:%M%p" }}</p>
    <p style="margin: 0; font-size: 13px;">Status: <strong>{{ order.fulfillment_status_label }}</strong> • Payment: <strong>{{ order.financial_status_label }}</strong></p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 12px;">
    {%- for line_item in order.line_items -%}
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 12px; font-size: 13px;">
        <div>
          <strong>{{ line_item.title }}</strong>
          <span style="color: #666;"> × {{ line_item.quantity }}</span>
        </div>
        <span style="font-weight: bold; color: #ed4c9b;">{{ line_item.final_line_price | money }}</span>
      </div>
    {%- endfor -%}
  </div>

  <div style="margin-top: 24px; text-align: right; font-size: 16px; font-weight: bold;">
    Total: <span style="color: #ed4c9b;">{{ order.total_price | money }}</span>
  </div>
</div>
