<div class="content-container">
<section class="why" data-section-id="{{ section.id }}">
  <div class="why-copy">
    <h2>{{ section.settings.heading | default: 'Why Press By Heart?' }} <span>♡</span></h2>
    <ul>
      {%- assign bullet_blocks = section.blocks | where: 'type', 'bullet_point' -%}
      {%- if bullet_blocks.size > 0 -%}
        {%- for block in bullet_blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      {%- else -%}
        <li>{{ section.settings.copy_1 | default: 'Salon quality nails at home' | escape }}</li>
        <li>{{ section.settings.copy_2 | default: 'Long lasting & durable' | escape }}</li>
        <li>{{ section.settings.copy_3 | default: 'Reusable up to 2+ weeks' | escape }}</li>
        <li>{{ section.settings.copy_4 | default: '100% handmade with love' | escape }}</li>
        <li>{{ section.settings.copy_5 | default: 'Inclusive sizes for every nail shape' | escape }}</li>
      {%- endif -%}
    </ul>
  </div>

  {%- if section.settings.center_image != blank -%}
    <img src="{{ section.settings.center_image | image_url: width: 180 }}" alt="{{ section.settings.center_image.alt | default: 'Golden crowned heart' | escape }}" loading="lazy" width="90" height="95">
  {%- else -%}
    <img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'heart-hq.png' | asset_url }}{% endif %}" alt="Golden crowned heart" loading="lazy" width="90" height="95">
  {%- endif -%}

  {%- assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' -%}
  {%- if testimonial_blocks.size > 0 -%}
    <div class="testimonial" role="region" aria-roledescription="carousel" aria-label="Customer reviews" tabindex="0" data-active-review="0" data-total-reviews="{{ testimonial_blocks.size }}">
      <script type="application/json" class="testimonials-json">
        [
          {%- for block in testimonial_blocks -%}
            {
              "id": {{ block.id | json }},
              "text": {{ block.settings.quote | json }},
              "author": {{ block.settings.author | json }},
              "stars": {{ block.settings.stars | default: '★★★★★' | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
      {%- assign first_review = testimonial_blocks.first -%}
      <div class="stars" aria-label="5 out of 5 stars">{{ first_review.settings.stars | default: '★★★★★' }}</div>
      <div class="quote-line">
        <button type="button" class="review-prev" aria-label="Previous review">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"/></svg>
        </button>
        <blockquote aria-live="polite" aria-atomic="true" {{ first_review.shopify_attributes }}>
          <span class="review-text">{{ first_review.settings.quote }}</span>
          <cite>{{ first_review.settings.author }}</cite>
        </blockquote>
        <button type="button" class="review-next" aria-label="Next review">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"/></svg>
        </button>
      </div>
      <div class="review-dots" aria-label="Choose a review">
        {%- for block in testimonial_blocks -%}
          <button type="button" aria-label="Show review {{ forloop.index }} of {{ testimonial_blocks.size }}" data-review="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}></button>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="testimonial" role="region" aria-roledescription="carousel" aria-label="Customer reviews" tabindex="0"
      data-active-review="0"
      data-total-reviews="3"
      data-review-0-text="{{ section.settings.review_1_text | default: '“The quality is unreal! They last for weeks and I get so many compliments.”' | escape }}"
      data-review-0-author="{{ section.settings.review_1_author | default: '- Sarah J.' | escape }}"
      data-review-1-text="{{ section.settings.review_2_text | default: '“So easy to apply, with a beautiful salon-style finish at home.”' | escape }}"
      data-review-1-author="{{ section.settings.review_2_author | default: '- Emily R.' | escape }}"
      data-review-2-text="{{ section.settings.review_3_text | default: '“Love the glossy designs and being able to switch up my nails.”' | escape }}"
      data-review-2-author="{{ section.settings.review_3_author | default: '- Chloe M.' | escape }}">
      <script type="application/json" class="testimonials-json">
        [
          {
            "id": "review_1",
            "text": {{ section.settings.review_1_text | default: '“The quality is unreal! They last for weeks and I get so many compliments.”' | json }},
            "author": {{ section.settings.review_1_author | default: '- Sarah J.' | json }},
            "stars": "★★★★★"
          },
          {
            "id": "review_2",
            "text": {{ section.settings.review_2_text | default: '“So easy to apply, with a beautiful salon-style finish at home.”' | json }},
            "author": {{ section.settings.review_2_author | default: '- Emily R.' | json }},
            "stars": "★★★★★"
          },
          {
            "id": "review_3",
            "text": {{ section.settings.review_3_text | default: '“Love the glossy designs and being able to switch up my nails.”' | json }},
            "author": {{ section.settings.review_3_author | default: '- Chloe M.' | json }},
            "stars": "★★★★★"
          }
        ]
      </script>
      <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
      <div class="quote-line">
        <button type="button" class="review-prev" aria-label="Previous review">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"/></svg>
        </button>
        <blockquote aria-live="polite" aria-atomic="true">
          <span class="review-text">{{ section.settings.review_1_text | default: '“The quality is unreal! They last for weeks and I get so many compliments.”' }}</span>
          <cite>{{ section.settings.review_1_author | default: '- Sarah J.' }}</cite>
        </blockquote>
        <button type="button" class="review-next" aria-label="Next review">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"/></svg>
        </button>
      </div>
      <div class="review-dots" aria-label="Choose a review">
        <button type="button" aria-label="Show review 1 of 3" data-review="0" aria-current="true"></button>
        <button type="button" aria-label="Show review 2 of 3" data-review="1" aria-current="false"></button>
        <button type="button" aria-label="Show review 3 of 3" data-review="2" aria-current="false"></button>
      </div>
    </div>
  {%- endif -%}
</section>
</div>


