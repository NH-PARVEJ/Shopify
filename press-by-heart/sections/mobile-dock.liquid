{% if section.settings.show_dock %}<nav class="mobile-app-dock" aria-label="Mobile navigation" style="--dock-items:5;margin:0!important;left:0!important;right:0!important;width:100%!important">{% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}{% assign defaults = 'home,grid,sparkles,crown,menu' | split: ',' %}{% assign tab_idx = 0 %}{% for link in section.settings.menu.links %}{% assign link_title_down = link.title | downcase %}{% if link.url == routes.cart_url or link_title_down == 'bag' or link_title_down == 'cart' %}{% elsif link.url == '#menu' or link_title_down == 'menu' %}<button type="button" class="app-tab app-tab-menu app-menu-btn" data-drawer-trigger aria-label="{{ 'general.accessibility.menu' | t | default: 'Menu' }}" aria-controls="mobile-app-drawer"><span class="app-tab-icon">{% render 'icon', name: 'menu' %}</span><span class="app-tab-label">Menu</span></button>{% else %}{% assign item_icon = defaults[tab_idx] | default: 'heart' %}{% assign tab_idx = tab_idx | plus: 1 %}{% assign custom_image = nil %}{% for block in section.blocks %}{% if block.settings.link == link.url %}{% assign item_icon = block.settings.icon %}{% assign custom_image = block.settings.image %}{% endif %}{% endfor %}<a href="{{ link.url }}" class="app-tab{% if link.active or link.current %} active{% endif %}"><span class="app-tab-icon">{% if custom_image %}{{ custom_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}{% else %}{% render 'icon', name: item_icon %}{% endif %}</span><span class="app-tab-label">{{ link.title | escape }}</span></a>{% endif %}{% endfor %}<button type="button" class="app-tab app-tab-menu app-menu-btn" data-drawer-trigger aria-label="{{ 'general.accessibility.menu' | t | default: 'Menu' }}" aria-controls="mobile-app-drawer"><span class="app-tab-icon">{% render 'icon', name: 'menu' %}</span><span class="app-tab-label">Menu</span></button>{% else %}<a href="{{ routes.root_url }}" class="app-tab{% if template.name == 'index' %} active{% endif %}"><span class="app-tab-icon">{% render 'icon', name: 'home' %}</span><span class="app-tab-label">Home</span></a><a href="/collections/all" class="app-tab{% if template.name == 'collection' and template.suffix != 'kids' %} active{% endif %}"><span class="app-tab-icon">{% render 'icon', name: 'grid' %}</span><span class="app-tab-label">Shop All</span></a><a href="/pages/shop-by-design" class="app-tab{% if template.suffix == 'shop-by-design' %} active{% endif %}"><span class="app-tab-icon">{% render 'icon', name: 'sparkles' %}</span><span class="app-tab-label">Designs</span></a><a href="/collections/kids" class="app-tab{% if template.suffix == 'kids' %} active{% endif %}"><span class="app-tab-icon">{% render 'icon', name: 'crown' %}</span><span class="app-tab-label">Kids</span></a><button type="button" class="app-tab app-tab-menu app-menu-btn" data-drawer-trigger aria-label="{{ 'general.accessibility.menu' | t | default: 'Menu' }}" aria-controls="mobile-app-drawer"><span class="app-tab-icon">{% render 'icon', name: 'menu' %}</span><span class="app-tab-label">Menu</span></button>{% endif %}</nav>{% endif %}{% render 'mobile-app-drawer' %}
