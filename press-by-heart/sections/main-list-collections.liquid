<div class="content-container" style="padding-top: 30px; padding-bottom: 60px;">
  <section id="collections" class="collections">
    <h1 class="collections-title" style="font-family: 'Times New Roman', serif; font-size: clamp(28px, 4vw, 36px); text-align: center; margin-bottom: 12px; letter-spacing: 1px;">
      {{ section.settings.title | default: 'ALL COLLECTIONS' }} <span style="color: #f93685; font-family: Allura, cursive; font-size: 1.2em;">♡</span>
    </h1>
    <p class="intro" style="text-align: center; color: #666; font-size: 14px; max-width: 580px; margin: 0 auto 36px auto;">
      {{ section.settings.intro | default: 'Explore our full range of handcrafted press-on collections, custom shapes and signature designs.' }}
    </p>

    <div class="collection-grid" id="collection-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <article class="collection">
            {%- if collection.featured_image != blank -%}
              <img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" loading="lazy" width="200" height="200">
            {%- else -%}
              {%- assign default_idx = forloop.index0 | modulo: 6 -%}
              <img src="{{ 'collection-' | append: default_idx | append: '.png' | asset_url }}" alt="{{ collection.title | escape }}" loading="lazy" width="200" height="200">
            {%- endif -%}
            <h2>{{ collection.title }}</h2>
            <p>{{ collection.description | strip_html | truncatewords: 14 | default: 'Handcrafted salon-quality press-on nails.' }}</p>
            <a class="outline" href="{{ collection.url }}" aria-label="Shop {{ collection.title | escape }} collection">
              <span class="collection-button-label">{{ section.settings.copy_1 | escape }}</span>
              <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
            </a>
          </article>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
</div>


{% schema %}{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ALL COLLECTIONS"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Paragraph",
      "default": "Explore our full range of handcrafted press-on collections, custom shapes and signature designs."
    },
    {
      "type": "text",
      "id": "copy_1",
      "label": "Copy: SHOP COLLECTION",
      "default": "SHOP COLLECTION"
    }
  ]
}{% endschema %}
