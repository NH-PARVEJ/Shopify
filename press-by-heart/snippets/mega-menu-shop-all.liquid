{%- assign shop_block = section.blocks | where: 'type', 'mega_menu_shop_all' | first -%}
{%- assign b_s = shop_block.settings -%}
<div id="shop-all-menu" class="shop-all-menu" hidden aria-label="Shop All collection menu" data-mega-menu-target="shop-all-menu" {{ shop_block.shopify_attributes }}>
  <div class="shop-all-menu-pointer" aria-hidden="true"></div>
  <div class="shop-all-menu-body">
    <div class="shop-all-menu-col">
      <div class="shop-all-menu-links">
        <a href="{{ b_s.link_1_url | default: section.settings.menu_shop_1_url | default: routes.all_products_collection_url | append: '/new-arrivals' }}" data-filter="new-arrivals">
          <span class="shop-all-glyph" data-menu-icon="sparkles" aria-hidden="true"></span>
          <span class="shop-all-text">
            <strong>{{ b_s.link_1_title | default: section.settings.menu_shop_1 | default: 'NEW ARRIVALS' | escape }}</strong>
            <small>{{ b_s.link_1_subtitle | default: section.settings.menu_shop_2 | default: 'Fresh picks just in' | escape }}</small>
          </span>
        </a>
        <a href="{{ b_s.link_2_url | default: section.settings.menu_shop_2_url | default: routes.all_products_collection_url | append: '/best-sellers' }}" data-filter="best-sellers">
          <span class="shop-all-glyph" data-menu-icon="flame" aria-hidden="true"></span>
          <span class="shop-all-text">
            <strong>{{ b_s.link_2_title | default: section.settings.menu_shop_3 | default: 'BEST SELLERS' | escape }}</strong>
            <small>{{ b_s.link_2_subtitle | default: section.settings.menu_shop_4 | default: 'Our most loved sets' | escape }}</small>
          </span>
        </a>
        <a href="{{ b_s.link_3_url | default: section.settings.menu_shop_3_url | default: routes.collections_url | append: '/kids' }}" data-filter="kids">
          <span class="shop-all-glyph" data-menu-icon="kids" aria-hidden="true"></span>
          <span class="shop-all-text">
            <strong>{{ b_s.link_3_title | default: section.settings.menu_shop_5 | default: 'KIDS' | escape }}</strong>
            <small>{{ b_s.link_3_subtitle | default: section.settings.menu_shop_6 | default: 'Perfect for little queens' | escape }}</small>
          </span>
        </a>
        <a href="{{ b_s.link_4_url | default: section.settings.menu_shop_4_url | default: routes.all_products_collection_url }}" data-filter="all">
          <span class="shop-all-glyph" data-menu-icon="bag" aria-hidden="true"></span>
          <span class="shop-all-text">
            <strong>{{ b_s.link_4_title | default: section.settings.menu_shop_7 | default: 'SHOP ALL' | escape }}</strong>
            <small>{{ b_s.link_4_subtitle | default: section.settings.menu_shop_8 | default: 'View everything' | escape }}</small>
          </span>
        </a>
      </div>
      <a class="shop-all-action shop-all-action-outline" href="{{ b_s.view_all_url | default: section.settings.menu_shop_9_url | default: routes.all_products_collection_url }}">
        {{ b_s.view_all_label | default: section.settings.menu_shop_9 | default: 'VIEW ALL COLLECTIONS' | escape }}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
      </a>
    </div>
    <div class="shop-all-menu-col">
      <div class="shop-all-menu-img-wrap">
        {%- assign feat_img = b_s.image | default: section.settings.menu_shop_image -%}
        {%- if feat_img != blank -%}
          <img class="shop-all-menu-product" src="{{ feat_img | image_url: width: 600 }}" alt="{{ feat_img.alt | default: 'Press By Heart boxed nail sets' | escape }}" width="265" height="305">
        {%- else -%}
          <img class="shop-all-menu-product" src="{{ 'shop-all-menu-product.png' | asset_url }}" alt="Press By Heart boxed nail sets" width="265" height="305">
        {%- endif -%}
      </div>
      <a class="shop-all-action shop-all-action-primary" href="{{ b_s.button_url | default: section.settings.menu_shop_10_url | default: routes.all_products_collection_url | append: '/new-arrivals' }}">
        {{ b_s.button_label | default: section.settings.menu_shop_10 | default: 'SHOP NEW ARRIVALS' | escape }}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
      </a>
    </div>
  </div>
</div>