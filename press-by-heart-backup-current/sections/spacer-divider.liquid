{%- style -%}
  .spacer-{{ section.id }} {
    height: {{ section.settings.desktop_height | default: 40 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spacer-divider-line-{{ section.id }} {
    width: 100%;
    height: 1px;
    background: {{ section.settings.divider_color | default: '#f5d5df' }};
  }
  @media (max-width: 768px) {
    .spacer-{{ section.id }} {
      height: {{ section.settings.mobile_height | default: 24 }}px;
    }
  }
{%- endstyle -%}

<div class="spacer-divider-section" data-section-id="{{ section.id }}">
  <div class="{% if section.settings.full_width %}content-container-fluid{% else %}content-container{% endif %}">
    <div class="spacer-{{ section.id }}">
      {%- if section.settings.show_divider -%}
        <div class="spacer-divider-line-{{ section.id }}"></div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Spacer & Divider",
  "tag": "section",
  "class": "section-spacer",
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 4,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Height",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Divider Line",
      "default": false
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Line Color",
      "default": "#f5d5df"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Spacer & Divider"
    }
  ]
}
{% endschema %}
