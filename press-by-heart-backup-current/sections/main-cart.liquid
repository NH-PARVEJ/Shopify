<div class="content-container" style="padding: 40px 16px; max-width: 900px; margin: 0 auto; min-height: 60vh;">
  <h1 style="font-family: 'Times New Roman', serif; font-size: 32px; text-align: center; margin-bottom: 24px;">
    {{ section.settings.copy_1 | escape }} <span style="color: #f93685; font-family: Allura, cursive; font-size: 38px;">♡</span>
  </h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty-state" style="text-align: center; padding: 40px 20px;">
      <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 8px;">{{ section.settings.copy_2 | escape }}</h2>
      <p style="color: #666; font-size: 13px; margin-bottom: 24px;">{{ section.settings.copy_3 | escape }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="shop-button" style="display: inline-flex; text-decoration: none;">
        {{ section.settings.copy_4 | escape }} <span>👑</span>
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-page-form">
      <div class="cart-page-items" style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 30px;">
        {%- for item in cart.items -%}
          <div class="cart-item-card" style="display: flex; gap: 16px; padding: 16px; border: 1px solid #ffdeea; border-radius: 12px; background: #fff;">
            <a href="{{ item.url }}" style="flex-shrink: 0; width: 80px; height: 80px; border-radius: 8px; overflow: hidden;">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" width="{{ item.image.width }}" height="{{ item.image.height }}">
              {%- else -%}
                <img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'product-0.png' | asset_url }}{% endif %}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" width="141" height="109">
              {%- endif -%}
            </a>
            <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <h3 style="font-size: 14px; font-weight: 600; margin: 0 0 4px;"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                {%- unless item.product.has_only_default_variant -%}
                  <p style="font-size: 11px; color: #888; margin: 0;">{{ item.variant.title }}</p>
                {%- endunless -%}
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <label>{{ section.settings.copy_5 | escape }} <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}"></label><span style="font-size: 13px; font-weight: bold; color: #ed4c9b;">{{ item.final_line_price | money }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size: 11px; color: #999; text-decoration: underline;">{{ section.settings.copy_6 | escape }}</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-page-summary" style="padding: 24px; border: 1px solid #ffdeea; border-radius: 12px; background: #fff5f8; max-width: 400px; margin-left: auto;">
        <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: bold; margin-bottom: 16px;">
          <span>{{ section.settings.copy_7 | escape }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size: 11px; color: #666; margin-bottom: 20px;">{{ section.settings.copy_8 | escape }}</p>
        <button type="submit" name="update" class="add">{{ section.settings.copy_9 | escape }}</button><button type="submit" name="checkout" class="cart-checkout-btn" style="width: 100%; height: 46px; background: linear-gradient(110deg, #ed4c9b, #f3388c); color: #fff; border: none; border-radius: 8px; font-weight: bold; font-size: 12px; cursor: pointer;">
          {{ section.settings.copy_10 | escape }} <span>👑</span>
        </button>
      </div>
    </form>
  {%- endif -%}
</div>


{% schema %}{
  "name": "Cart Page",
  "settings": [
    {
      "type": "text",
      "id": "copy_1",
      "label": "Copy: Your Shopping Bag",
      "default": "Your Shopping Bag"
    },
    {
      "type": "text",
      "id": "copy_2",
      "label": "Copy: Your shopping bag is empty",
      "default": "Your shopping bag is empty"
    },
    {
      "type": "text",
      "id": "copy_3",
      "label": "Copy: Explore our salon-quality press-on nails and find your perf",
      "default": "Explore our salon-quality press-on nails and find your perfect set!"
    },
    {
      "type": "text",
      "id": "copy_4",
      "label": "Copy: START SHOPPING",
      "default": "START SHOPPING"
    },
    {
      "type": "text",
      "id": "copy_5",
      "label": "Copy: Quantity",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "copy_6",
      "label": "Copy: Remove",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "copy_7",
      "label": "Copy: Subtotal",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "copy_8",
      "label": "Copy: Taxes and shipping calculated at checkout.",
      "default": "Taxes and shipping calculated at checkout."
    },
    {
      "type": "text",
      "id": "copy_9",
      "label": "Copy: Update bag",
      "default": "Update bag"
    },
    {
      "type": "text",
      "id": "copy_10",
      "label": "Copy: CHECKOUT NOW",
      "default": "CHECKOUT NOW"
    },
    {
      "type": "image_picker",
      "id": "art_1",
      "label": "Image: product-0.png"
    }
  ]
}{% endschema %}
