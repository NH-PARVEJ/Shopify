{%- style -%}
  .section-{{ section.id }}-benefits {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }
  .section-{{ section.id }}-benefits .benefits {
    {% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }} !important;{% endif %}
  }
  {% if section.settings.icon_color != blank %}
    .section-{{ section.id }}-benefits .benefits i {
      color: {{ section.settings.icon_color }} !important;
    }
  {% endif %}
  {% if section.settings.title_color != blank %}
    .section-{{ section.id }}-benefits .benefits b {
      color: {{ section.settings.title_color }} !important;
    }
  {% endif %}
  {% if section.settings.sub_color != blank %}
    .section-{{ section.id }}-benefits .benefits span {
      color: {{ section.settings.sub_color }} !important;
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-benefits { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-benefits { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="content-container section-{{ section.id }}-benefits">
<section class="benefits" data-section-id="{{ section.id }}" aria-label="Customer benefits">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.show_item -%}
        <div {{ block.shopify_attributes }}>
          {%- if section.settings.show_icons and block.settings.icon != blank -%}
            <i>{{ block.settings.icon | default: '♡' }}</i>
          {%- endif -%}
          <p>
            <b>{{ block.settings.title }}</b>
            {%- if section.settings.show_subtitles and block.settings.subtitle != blank -%}
              <span>{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    <div>{% if section.settings.show_icons %}<i>♧</i>{% endif %}<p><b>{{ section.settings.item_1_title | default: 'REUSABLE & DURABLE' }}</b>{% if section.settings.show_subtitles %}<span>{{ section.settings.item_1_sub | default: 'Wear again & again' }}</span>{% endif %}</p></div>
    <div>{% if section.settings.show_icons %}<i>♢</i>{% endif %}<p><b>{{ section.settings.item_2_title | default: 'SALON QUALITY' }}</b>{% if section.settings.show_subtitles %}<span>{{ section.settings.item_2_sub | default: 'Premium finish' }}</span>{% endif %}</p></div>
    <div>{% if section.settings.show_icons %}<i>◷</i>{% endif %}<p><b>{{ section.settings.item_3_title | default: 'QUICK & EASY' }}</b>{% if section.settings.show_subtitles %}<span>{{ section.settings.item_3_sub | default: 'Apply in minutes' }}</span>{% endif %}</p></div>
    <div>{% if section.settings.show_icons %}<i>♡</i>{% endif %}<p><b>{{ section.settings.item_4_title | default: 'CRUELTY FREE' }}</b>{% if section.settings.show_subtitles %}<span>{{ section.settings.item_4_sub | default: 'Made with love' }}</span>{% endif %}</p></div>
  {%- endif -%}
</section>
</div>

{% schema %}
{
  "name": "Benefits Bar",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show Benefit Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_subtitles",
      "label": "Show Subtitles / Descriptions",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff1f5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Symbol Color",
      "default": "#ff2b78"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Text Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subtitle Text Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Spacing & Responsive"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Fallback Items (if no blocks used)"
    },
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Benefit 1 Title",
      "default": "REUSABLE & DURABLE"
    },
    {
      "type": "text",
      "id": "item_1_sub",
      "label": "Benefit 1 Subtitle",
      "default": "Wear again & again"
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Benefit 2 Title",
      "default": "SALON QUALITY"
    },
    {
      "type": "text",
      "id": "item_2_sub",
      "label": "Benefit 2 Subtitle",
      "default": "Premium finish"
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Benefit 3 Title",
      "default": "QUICK & EASY"
    },
    {
      "type": "text",
      "id": "item_3_sub",
      "label": "Benefit 3 Subtitle",
      "default": "Apply in minutes"
    },
    {
      "type": "text",
      "id": "item_4_title",
      "label": "Benefit 4 Title",
      "default": "CRUELTY FREE"
    },
    {
      "type": "text",
      "id": "item_4_sub",
      "label": "Benefit 4 Subtitle",
      "default": "Made with love"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_item",
          "label": "Enable this Item",
          "default": true
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Symbol (e.g. ♧, ♢, ◷, ♡)",
          "default": "♡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SALON QUALITY"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Premium finish"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Bar"
    }
  ]
}
{% endschema %}
