{%- style -%}
  .section-{{ section.id }}-instagram {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    {% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}
  }
  {% if section.settings.heading_color != blank %}
    .section-{{ section.id }}-instagram .social h2 {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-instagram { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-instagram { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="content-container section-{{ section.id }}-instagram">
<section class="social" data-section-id="{{ section.id }}">
  {%- if section.settings.show_heading -%}
    <h2>{{ section.settings.heading | default: 'FOLLOW US' }} {%- if section.settings.show_handle -%}<a href="{{ section.settings.instagram_url | default: 'https://instagram.com/pressbyheart' }}" target="_blank" rel="noopener">{{ section.settings.account_handle | default: '@PRESSBYHEART' }}</a>{%- endif -%}</h2>
  {%- endif -%}

  <div id="social-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <a class="instagram-card" href="{{ block.settings.url | default: section.settings.instagram_url | default: 'https://instagram.com/pressbyheart' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.caption | default: 'Press By Heart Instagram nail inspiration' | escape }}" loading="lazy" width="138" height="138">
          {%- else -%}
            {%- assign default_idx = forloop.index0 | modulo: 6 -%}
            <img src="{{ 'social-' | append: default_idx | append: '.png' | asset_url }}" alt="{{ block.settings.caption | default: 'Press By Heart Instagram nail inspiration' | escape }}" loading="lazy" width="138" height="138">
          {%- endif -%}
          {%- if section.settings.show_overlay -%}
            <span class="instagram-overlay">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              {%- if section.settings.show_captions and block.settings.caption != blank -%}
                <span>{{ block.settings.caption }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_handle",
      "label": "Show @Account Handle Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Instagram Hover Icon Overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show Image Captions on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "FOLLOW US"
    },
    {
      "type": "text",
      "id": "account_handle",
      "label": "Account Handle",
      "default": "@PRESSBYHEART"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile Link"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#101010"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Photo"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Hover Caption"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Post URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed"
    }
  ]
}
{% endschema %}
