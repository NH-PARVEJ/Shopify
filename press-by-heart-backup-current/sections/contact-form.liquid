{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
  }
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  }
  .contact-section-wrap-{{ section.id }} {
    max-width: 620px;
    margin: 0 auto;
  }
  .contact-section-wrap-{{ section.id }} .contact-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .contact-section-wrap-{{ section.id }} h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 8px 0;
  }
  .contact-section-wrap-{{ section.id }} h2 span {
    color: #fa4087;
  }
  .contact-section-wrap-{{ section.id }} p {
    font-family: Poppins, Arial, sans-serif;
    font-size: 13.5px;
    color: #6d5b62;
    margin: 0;
  }
  .contact-form-inner-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #fffbfa;
    border: 1.5px solid #fee8f0;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(80, 20, 36, 0.05);
  }
  .contact-field-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-align: left;
  }
  .contact-field-group label {
    font-family: Poppins, Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #2b1f24;
  }
  .contact-field-group input,
  .contact-field-group textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid #f1dde4;
    border-radius: 8px;
    background: #ffffff;
    font-family: Poppins, Arial, sans-serif;
    font-size: 13.5px;
    color: #1a1a1a;
    outline: none;
    box-sizing: border-box;
  }
  .contact-submit-btn-{{ section.id }} {
    height: 44px;
    background: linear-gradient(105deg, #fa4087, #f13d84);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-family: Poppins, Arial, sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(250, 64, 135, 0.28);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 6px;
  }
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="contact-form-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="content-container">
    <div class="contact-section-wrap-{{ section.id }}">
      <div class="contact-header">
        {%- if section.settings.show_heading -%}
          <h2>{{ section.settings.heading | default: 'GET IN TOUCH' }} <span>♡</span></h2>
        {%- endif -%}
        {%- if section.settings.show_subheading and section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {% form 'contact', class: 'contact-form' %}
        <div class="contact-form-inner-{{ section.id }}">
          {{ form.errors | default_errors }}
          {% if form.posted_successfully? %}
            <div style="padding: 12px; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 8px; color: #166534; font-family: Poppins, Arial, sans-serif; font-size: 13.5px;">
              🌸 <strong>Thank you for contacting us!</strong><br>We’ve received your message and will get back to you shortly.
            </div>
          {% else %}
            <div class="contact-field-group">
              <label for="ContactFormName">Your Name</label>
              <input type="text" id="ContactFormName" name="contact[name]" placeholder="e.g. Sarah Jenkins" required>
            </div>
            <div class="contact-field-group">
              <label for="ContactFormEmail">Email Address</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="e.g. sarah@example.com" required>
            </div>
            {%- if section.settings.show_phone_field -%}
              <div class="contact-field-group">
                <label for="ContactFormPhone">Phone Number (Optional)</label>
                <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="e.g. 07944 545 406">
              </div>
            {%- endif -%}
            <div class="contact-field-group">
              <label for="ContactFormMessage">Your Message</label>
              <textarea id="ContactFormMessage" name="contact[body]" rows="4" placeholder="How can we help you?" required></textarea>
            </div>
            <button type="submit" class="contact-submit-btn-{{ section.id }}">
              {{ section.settings.button_text | default: 'SEND MESSAGE' }} <span>✨</span>
            </button>
          {% endif %}
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Main Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_subheading",
      "label": "Show Subheading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone_field",
      "label": "Show Phone Input Field",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have a question about sizing, custom orders or shipping? We'd love to help!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Label",
      "default": "SEND MESSAGE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
