      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_menu_2",
      "label": "Show Menu 2 Column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_contact_column",
      "label": "Show Contact Column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show Phone Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show Email Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_location",
      "label": "Show Physical Location",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_newsletter_column",
      "label": "Show Newsletter Column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
