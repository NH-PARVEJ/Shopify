    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "QUICK LINKS"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Select Menu 1"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "CUSTOMER CARE"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Select Menu 2"
    },
    {
      "type": "header",
      "content": "Contact Info"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact Column Title",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone Number",
      "default": "07944 545 406"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email Address",
      "default": "hello@pressbyheart.co.uk"
    },
    {
      "type": "text",
      "id": "contact_location",
