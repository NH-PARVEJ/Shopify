{%- style -%}
  .section-{{ section.id }}-footer {
    padding-top: {{ section.settings.padding_top | default: 17 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 7 }}px;
    {% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }} !important;{% endif %}
  }
  {% if section.settings.heading_color != blank %}
    .section-{{ section.id }}-footer h3 {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.text_color != blank %}
    .section-{{ section.id }}-footer p,
    .section-{{ section.id }}-footer .copyright {
      color: {{ section.settings.text_color }} !important;
    }
  {% endif %}
  {% if section.settings.link_color != blank %}
    .section-{{ section.id }}-footer a {
      color: {{ section.settings.link_color }} !important;
    }
  {% endif %}
  {% if section.settings.border_color != blank %}
    .section-{{ section.id }}-footer .footer-grid > div + div {
      border-left-color: {{ section.settings.border_color }} !important;
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-footer { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-footer { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<footer id="shopify-section-footer" class="section-{{ section.id }}-footer" data-section-id="{{ section.id }}">
  <div class="footer-inner">
    <div class="footer-grid">
      {%- if section.settings.show_brand_column -%}
        <div class="brand">
          {%- if section.settings.show_logo -%}
            {%- if section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="115" height="38" loading="lazy">
            {%- else -%}
              <img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'logo-hq-v2.png' | asset_url }}{% endif %}" alt="{{ shop.name }}" width="115" height="38" loading="lazy">
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.show_brand_text and section.settings.brand_text != blank -%}
            <p>{{ section.settings.brand_text }}</p>
          {%- endif -%}
          {%- if section.settings.show_social_icons -%}
            <div class="social-icons">
              <a href="{{ section.settings.social_instagram | default: settings.social_instagram_url | default: 'https://www.instagram.com/pressbyheart/' }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer">◎</a>
              <a href="{{ section.settings.social_tiktok | default: settings.social_tiktok_url | default: 'https://www.tiktok.com/@pressbyheart' }}" aria-label="TikTok" target="_blank" rel="noopener noreferrer">♪</a>
              <a href="tel:{{ section.settings.contact_phone | default: settings.contact_phone | default: '07944545406' }}" aria-label="WhatsApp / Call">☏</a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_menu_1 -%}
        <div>
          <h3>{{ section.settings.menu_1_title | default: 'QUICK LINKS' }}</h3>
          {%- assign f_menu_1 = section.settings.menu_1 -%}
          {%- if f_menu_1 != blank and f_menu_1.links.size > 0 -%}
            {%- for link in f_menu_1.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_menu_2 -%}
        <div>
          <h3>{{ section.settings.menu_2_title | default: 'CUSTOMER CARE' }}</h3>
          {%- assign f_menu_2 = section.settings.menu_2 -%}
          {%- if f_menu_2 != blank and f_menu_2.links.size > 0 -%}
            {%- for link in f_menu_2.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_contact_column -%}
        <div class="contact">
          <h3>{{ section.settings.contact_title | default: 'CONTACT US' }}</h3>
          {%- if section.settings.show_phone and section.settings.contact_phone != blank -%}
            <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}">
              <em>♧</em>{{ section.settings.contact_phone }}
            </a>
          {%- endif -%}
          {%- if section.settings.show_email and section.settings.contact_email != blank -%}
            <a href="mailto:{{ section.settings.contact_email }}">
              <em>✉</em>{{ section.settings.contact_email }}
            </a>
          {%- endif -%}
          {%- if section.settings.show_location and section.settings.contact_location != blank -%}
            <p><em>♧</em>{{ section.settings.contact_location }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter_column -%}
        <div class="newsletter">
          <h3>{{ section.settings.newsletter_title | default: 'JOIN THE HEART CLUB' }}</h3>
          {%- if section.settings.newsletter_sub != blank -%}
            <p>{{ section.settings.newsletter_sub }}</p>
          {%- endif -%}
          {%- form 'customer', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="sr-only" for="newsletter-email">{{ section.settings.copy_14 | default: 'Your email' | escape }}</label>
            <input id="newsletter-email" type="email" name="contact[email]" placeholder="Enter your email" required aria-required="true">
            <button type="submit" aria-label="Join newsletter club">
              {{ section.settings.newsletter_btn | default: 'JOIN THE CLUB' }}
              <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/>
                <path d="M5 16h14M7 22h10"/>
              </svg>
            </button>
          {%- endform -%}
          {%- if section.settings.show_payment_methods -%}
            <div class="payment-methods" role="list" aria-label="Accepted payment methods">
              <span role="listitem"><img src="{{ 'apple_pay.svg' | asset_url }}" alt="Apple Pay" width="38" height="24" loading="lazy"></span>
              <span role="listitem"><img src="{{ 'google_pay.svg' | asset_url }}" alt="Google Pay" width="38" height="24" loading="lazy"></span>
              <span role="listitem"><img src="{{ 'master.svg' | asset_url }}" alt="Mastercard" width="38" height="24" loading="lazy"></span>
              <span role="listitem"><img src="{{ 'paypal.svg' | asset_url }}" alt="PayPal" width="38" height="24" loading="lazy"></span>
              <span role="listitem"><img src="{{ 'american_express.svg' | asset_url }}" alt="American Express" width="38" height="24" loading="lazy"></span>
              <span role="listitem"><img src="{{ 'visa.svg' | asset_url }}" alt="Visa" width="38" height="24" loading="lazy"></span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.show_copyright -%}
      <p class="copyright">{{ section.settings.copyright_text | default: '© 2025 Press By Heart. All rights reserved.' }}</p>
    {%- endif -%}
  </div>
</footer>

