{%- style -%}
  .section-{{ section.id }}-promos {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    {% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}
  }
  {% if section.settings.card_bg != blank %}
    .section-{{ section.id }}-promos .feature {
      background: {{ section.settings.card_bg }} !important;
    }
  {% endif %}
  {% if section.settings.heading_color != blank %}
    .section-{{ section.id }}-promos .feature h2 {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.text_color != blank %}
    .section-{{ section.id }}-promos .feature p {
      color: {{ section.settings.text_color }} !important;
    }
  {% endif %}
  {% if section.settings.link_color != blank %}
    .section-{{ section.id }}-promos .feature a {
      color: {{ section.settings.link_color }} !important;
    }
  {% endif %}
  {% if section.settings.columns_desktop != blank %}
    @media (min-width: 901px) {
      .section-{{ section.id }}-promos .features {
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr)) !important;
      }
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-promos { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-promos { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="content-container section-{{ section.id }}-promos">
<section class="features" id="features" data-section-id="{{ section.id }}">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <article class="feature" {{ block.shopify_attributes }}>
        {%- if section.settings.show_card_image -%}
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="200" height="99">
          {%- else -%}
            {%- assign default_idx = forloop.index0 | modulo: 4 -%}
            <img src="{{ 'feature-' | append: default_idx | append: '.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="200" height="99">
          {%- endif -%}
        {%- endif -%}
        <div class="feature-content">
          {%- if section.settings.show_card_title -%}
            <h2>{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.show_card_desc and block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if section.settings.show_card_button -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              {{ block.settings.button_text | default: 'SHOP NOW' }} {%- if section.settings.show_arrow -%}<span>→</span>{%- endif -%}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  {%- endif -%}
</section>
</div>

{% schema %}
{
  "name": "Featured Promo Grid",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_card_image",
      "label": "Show Promo Card Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_title",
      "label": "Show Promo Title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_desc",
      "label": "Show Description Text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_button",
      "label": "Show Action Link / Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#fff1f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Card Heading Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card Description Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Button Link Color",
      "default": "#ff0061"
    },
    {
      "type": "header",
      "content": "Spacing & Responsive"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "NEW ARRIVALS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text",
          "default": "Shop the latest drop"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Promo Grid"
    }
  ]
}
{% endschema %}
