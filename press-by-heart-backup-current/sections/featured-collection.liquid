{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 44 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 44 }}px;
  }
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  }
  .fc-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .fc-header-{{ section.id }} h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }
  .fc-header-{{ section.id }} h2 span {
    color: #fa4087;
  }
  .fc-header-{{ section.id }} .fc-view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #ffdce6;
    color: #ff0055;
    border-radius: 6px;
    font-family: Poppins, Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fc-header-{{ section.id }} .fc-view-all:hover {
    background: #ffc2d4;
    transform: translateY(-1px);
  }
  .fc-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 900px) {
    .fc-grid-{{ section.id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
  }
  @media (max-width: 600px) {
    .fc-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
      gap: 10px;
    }
  }
{%- endstyle -%}

<div class="featured-collection-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="content-container">
    <div class="fc-header-{{ section.id }}">
      <div>
        <h2>{{ section.settings.title | default: 'FEATURED COLLECTION' }} <span>♡</span></h2>
        {%- if section.settings.subheading != blank -%}
          <p style="margin: 4px 0 0; font-family: Poppins, Arial, sans-serif; font-size: 13px; color: #7a6e74;">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <a class="fc-view-all" href="{{ section.settings.collection.url }}">
          {{ section.settings.view_all_text | default: 'VIEW ALL' }} <span>→</span>
        </a>
      {%- endif -%}
    </div>

    <div class="fc-grid-{{ section.id }}">
      {%- assign featured_collection = section.settings.collection -%}
      {%- assign limit = section.settings.products_to_show | default: 8 -%}
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for product in featured_collection.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div style="border: 1px solid #fee8f0; border-radius: 8px; padding: 12px; text-align: center; background: #fffcfd;">
            <div style="width: 100%; aspect-ratio: 1; background: #fff2f6; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fa4087; margin-bottom: 8px;">💅</div>
            <p style="font-family: Poppins, Arial, sans-serif; font-size: 12px; font-weight: 600; margin: 4px 0; color: #1a1a1a;">Select a Collection</p>
            <p style="font-family: Poppins, Arial, sans-serif; font-size: 11px; color: #fa4087; font-weight: 700; margin: 0;">£14.99</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FEATURED COLLECTION"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 2,
      "label": "Maximum Products to Show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Label",
      "default": "VIEW ALL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
