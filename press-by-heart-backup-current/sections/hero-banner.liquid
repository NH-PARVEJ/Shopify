{%- style -%}
  .section-{{ section.id }}-hero {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    {% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}
  }
  {% if section.settings.heading_color != blank %}
    .section-{{ section.id }}-hero #hero-title {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.accent_color != blank %}
    .section-{{ section.id }}-hero .script-line,
    .section-{{ section.id }}-hero .eyebrow span {
      color: {{ section.settings.accent_color }} !important;
    }
  {% endif %}
  {% if section.settings.desc_color != blank %}
    .section-{{ section.id }}-hero .hero-description {
      color: {{ section.settings.desc_color }} !important;
    }
  {% endif %}
  {% if section.settings.btn_bg != blank %}
    .section-{{ section.id }}-hero .shop-button {
      background: {{ section.settings.btn_bg }} !important;
    }
  {% endif %}
  {% if section.settings.btn_text_color != blank %}
    .section-{{ section.id }}-hero .shop-button {
      color: {{ section.settings.btn_text_color }} !important;
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-hero { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-hero { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<section class="hero section-{{ section.id }}-hero" aria-labelledby="hero-title" data-section-id="{{ section.id }}">
  {%- if section.settings.show_background_image -%}
    {%- if section.settings.image != blank -%}
      <img class="hero-background"
        src="{{ section.settings.image | image_url: width: 1881 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading_main | escape }}"
        width="1881"
        height="836"
        loading="eager">
    {%- else -%}
      <img class="hero-background"
        src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'hero-expanded.png' | asset_url }}{% endif %}"
        alt="Pink Press By Heart press-on nail set, pink satin ribbon and gold crowned-heart emblem"
        width="1881"
        height="836"
        loading="eager">
    {%- endif -%}
  {%- endif -%}

  <div class="hero-container">
    <div class="hero-copy">
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'PRESS BY HEART' }} <span>♡</span></p>
      {%- endif -%}

      {%- if section.settings.show_heading -%}
        <h1 id="hero-title">
          {{ section.settings.heading_main | default: 'QUICK PRESS,' }}
          <span class="script-line">
            {{ section.settings.heading_script | default: 'instant beauty' }}
            {%- if section.settings.show_flourish -%}
              <svg class="flourish" viewBox="0 0 30 45" aria-hidden="true">
                <path d="M8 36C22 27 27 9 21 7C16 4 15 13 15 13S13 3 8 6C0 10 9 27 22 33"/>
              </svg>
            {%- endif -%}
          </span>
        </h1>
      {%- endif -%}

      {%- if section.settings.show_description and section.settings.description != blank -%}
        <p class="hero-description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.show_button -%}
        {%- if section.settings.button_link != blank -%}
          <a class="shop-button" href="{{ section.settings.button_link }}">
            {{ section.settings.button_text | default: 'SHOP NOW' }}
            {%- if section.settings.show_button_icon -%}
              <span>
                <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/>
                  <path d="M5 16h14M7 22h10"/>
                </svg>
              </span>
            {%- endif -%}
          </a>
        {%- else -%}
          <button class="shop-button" type="button" onclick="if(document.getElementById('best-sellers')){document.getElementById('best-sellers').scrollIntoView({behavior:'smooth'})}else{window.location.href='{{ routes.all_products_collection_url }}'}">
            {{ section.settings.button_text | default: 'SHOP NOW' }}
            {%- if section.settings.show_button_icon -%}
              <span>
                <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/>
                  <path d="M5 16h14M7 22h10"/>
                </svg>
              </span>
            {%- endif -%}
          </button>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_background_image",
      "label": "Show Background Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show Eyebrow Subtitle",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Main Headline",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_flourish",
      "label": "Show Script Flourish Ornament",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description Text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button_icon",
      "label": "Show Crown Icon in Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Banner (Desktop & Mobile)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "PRESS BY HEART"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Main Headline (Serif)",
      "default": "QUICK PRESS,"
    },
    {
      "type": "text",
      "id": "heading_script",
      "label": "Script Accent Headline (Cursive)",
      "default": "instant beauty"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Salon quality press-on nails<br>delivered to your door."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "CTA Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA Button Destination (Leave blank to scroll to Best Sellers)"
    },
    {
      "type": "image_picker",
      "id": "art_1",
      "label": "Alternative Art Image (hero-expanded.png)"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#fff0f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headline Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Script / Accent Pink Color",
      "default": "#ff2375"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background Color",
      "default": "#ffeaf0"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ff0054"
    },
    {
      "type": "header",
      "content": "Spacing & Responsive"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop Screens",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile Screens",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
