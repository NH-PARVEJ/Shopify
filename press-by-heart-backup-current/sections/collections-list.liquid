{%- style -%}
  .section-{{ section.id }}-collections {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    {% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}
  }
  {% if section.settings.heading_color != blank %}
    .section-{{ section.id }}-collections .collections-title {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.intro_color != blank %}
    .section-{{ section.id }}-collections .intro {
      color: {{ section.settings.intro_color }} !important;
    }
  {% endif %}
  {% if section.settings.card_bg != blank %}
    .section-{{ section.id }}-collections .collection {
      background: {{ section.settings.card_bg }} !important;
    }
  {% endif %}
  {% if section.settings.columns_desktop != blank %}
    @media (min-width: 901px) {
      .section-{{ section.id }}-collections .collection-grid {
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr)) !important;
      }
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-collections { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-collections { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="content-container section-{{ section.id }}-collections">
<section id="collections" class="collections" data-section-id="{{ section.id }}">
  {%- if section.settings.show_heading -%}
    <h2 class="collections-title">{{ section.settings.title | default: 'SHOP BY COLLECTION' }} {%- if section.settings.show_heart -%}<span>♡</span>{%- endif -%}</h2>
  {%- endif -%}
  {%- if section.settings.show_intro and section.settings.intro != blank -%}
    <p class="intro">{{ section.settings.intro }}</p>
  {%- endif -%}
  <div class="collection-grid" id="collection-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign coll_title = block.settings.title | default: coll.title | default: 'Collection' -%}
        {%- assign coll_url = block.settings.link | default: coll.url | default: routes.all_products_collection_url -%}
        {%- assign coll_desc = block.settings.description | default: coll.description -%}
        <article class="collection" {{ block.shopify_attributes }}>
          {%- if section.settings.show_card_image -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ coll_title | escape }} press-on nail designs" loading="lazy" width="130" height="154">
            {%- elsif coll.featured_image != blank -%}
              <img src="{{ coll.featured_image | image_url: width: 300 }}" alt="{{ coll_title | escape }} press-on nail designs" loading="lazy" width="130" height="154">
            {%- else -%}
              {%- assign default_img_index = forloop.index0 | modulo: 6 -%}
              <img src="{{ 'collection-' | append: default_img_index | append: '.png' | asset_url }}" alt="{{ coll_title | escape }} press-on nail designs" loading="lazy" width="130" height="154">
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.show_card_title -%}
            <h2>{{ coll_title }}</h2>
          {%- endif -%}
          {%- if section.settings.show_card_desc and coll_desc != blank -%}
            <p>{{ coll_desc }}</p>
          {%- endif -%}
          {%- if section.settings.show_card_button -%}
            <a class="outline" href="{{ coll_url }}" aria-label="Shop {{ coll_title | escape }} collection">
              <span class="collection-button-label">{{ block.settings.button_text | default: 'SHOP COLLECTION' }}</span>
              {%- if section.settings.show_button_icon -%}
                <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
              {%- endif -%}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Shop by Collection",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Section Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heart",
      "label": "Show Heart in Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Show Subtitle / Intro",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_image",
      "label": "Show Card Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_title",
      "label": "Show Card Title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_desc",
      "label": "Show Card Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_button",
      "label": "Show Card Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button_icon",
      "label": "Show Button Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Content & Layout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "SHOP BY COLLECTION"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Subtitle / Intro",
      "default": "Find the perfect set for every mood, moment and occasion."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Intro Text Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color"
    },
    {
      "type": "header",
      "content": "Spacing & Responsive"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Source Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override",
          "default": "The Classics"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Override",
          "default": "Timeless styles you’ll never get tired of."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "SHOP COLLECTION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Collection"
    }
  ]
}
{% endschema %}
