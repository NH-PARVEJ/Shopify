{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 44 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 44 }}px;
  }
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#fff2f6' }};
  }
  .newsletter-section-wrap-{{ section.id }} {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }
  .newsletter-section-wrap-{{ section.id }} h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 8px 0;
  }
  .newsletter-section-wrap-{{ section.id }} h2 span {
    color: #fa4087;
  }
  .newsletter-section-wrap-{{ section.id }} p {
    font-family: Poppins, Arial, sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: #634f56;
    margin: 0 0 20px 0;
  }
  .newsletter-section-wrap-{{ section.id }} .newsletter-form-inner {
    display: flex;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
  }
  .newsletter-section-wrap-{{ section.id }} input[type="email"] {
    flex: 1;
    height: 44px;
    padding: 0 16px;
    border: 1.5px solid #f1dde4;
    border-radius: 8px;
    background: #ffffff;
    font-family: Poppins, Arial, sans-serif;
    font-size: 13.5px;
    outline: none;
    box-sizing: border-box;
  }
  .newsletter-section-wrap-{{ section.id }} button {
    height: 44px;
    padding: 0 24px;
    background: linear-gradient(105deg, #fa4087, #f13d84);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-family: Poppins, Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(250, 64, 135, 0.28);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 540px) {
    .newsletter-section-wrap-{{ section.id }} .newsletter-form-inner {
      flex-direction: column;
    }
    .newsletter-section-wrap-{{ section.id }} button {
      width: 100%;
      justify-content: center;
    }
  }
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="newsletter-banner-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="content-container">
    <div class="newsletter-section-wrap-{{ section.id }}">
      {%- if section.settings.show_heading -%}
        <h2>{{ section.settings.heading | default: 'JOIN THE CLUB' }} <span>♡</span></h2>
      {%- endif -%}
      {%- if section.settings.show_subheading and section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {% form 'customer', id: 'newsletter-section-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <div style="padding: 12px; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 8px; color: #166534; font-family: Poppins, Arial, sans-serif; font-size: 13px;">
            🎉 Thank you for subscribing! Check your inbox for your welcome perk.
          </div>
        {% else %}
          <div class="newsletter-form-inner">
            <input type="email" name="contact[email]" placeholder="Enter your email address..." required autocomplete="email">
            <button type="submit">
              {{ section.settings.button_text | default: 'SUBSCRIBE' }} <span>👑</span>
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter Banner",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Main Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_subheading",
      "label": "Show Subtitle Description",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE CLUB"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Subscribe for exclusive drops, secret sales & 10% off your first order."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff2f6"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner"
    }
  ]
}
{% endschema %}
