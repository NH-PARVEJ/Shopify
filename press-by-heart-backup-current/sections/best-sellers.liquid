{%- style -%}
  .section-{{ section.id }}-best-sellers {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    {% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}
  }
  {% if section.settings.heading_color != blank %}
    .section-{{ section.id }}-best-sellers .section-heading h2 {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.view_all_bg != blank %}
    .section-{{ section.id }}-best-sellers .view-all {
      background: {{ section.settings.view_all_bg }} !important;
    }
  {% endif %}
  {% if section.settings.view_all_color != blank %}
    .section-{{ section.id }}-best-sellers .view-all {
      color: {{ section.settings.view_all_color }} !important;
    }
  {% endif %}
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { .section-{{ section.id }}-best-sellers { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { .section-{{ section.id }}-best-sellers { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="content-container section-{{ section.id }}-best-sellers">
<section class="best-sellers" id="best-sellers">
  {%- if section.settings.show_header -%}
    <div class="section-heading">
      <h2>{{ section.settings.title | default: 'BEST SELLERS' }} {%- if section.settings.show_heart -%}<span>♡</span>{%- endif -%}</h2>
      {%- if section.settings.show_view_all -%}
        <a class="view-all" href="{{ section.settings.view_all_url | default: routes.all_products_collection_url }}">
          {{ section.settings.view_all_text | default: 'VIEW ALL' }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="product-wrap">
    {%- if section.settings.show_arrows -%}
      <button class="arrow prev" type="button" aria-label="Previous products">‹</button>
    {%- endif -%}
    <div class="products" id="products">
      {%- assign featured_collection = section.settings.collection -%}
      {%- assign limit = section.settings.products_to_show | default: 5 -%}
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for product in featured_collection.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- render 'product-card', product: block.settings.product -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.show_arrows -%}
      <button class="arrow next" type="button" aria-label="Next products">›</button>
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Best Sellers Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Heading Row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heart",
      "label": "Show Decorative Heart Symbol",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Prev/Next Arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Content & Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 16,
      "step": 1,
      "label": "Maximum Products to Show",
      "default": 5
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All Destination Link"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "view_all_bg",
      "label": "View All Button Background",
      "default": "#ffdce6"
    },
    {
      "type": "color",
      "id": "view_all_color",
      "label": "View All Button Text",
      "default": "#ff0055"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Featured Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Custom Price"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Carousel"
    }
  ]
}
{% endschema %}
