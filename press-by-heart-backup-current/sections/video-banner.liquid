{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 44 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 44 }}px;
  }
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  }
  .video-section-wrap-{{ section.id }} {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }
  .video-header-{{ section.id }} {
    margin-bottom: 22px;
  }
  .video-header-{{ section.id }} h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 8px 0;
  }
  .video-header-{{ section.id }} h2 span {
    color: #fa4087;
  }
  .video-header-{{ section.id }} p {
    font-family: Poppins, Arial, sans-serif;
    font-size: 13.5px;
    color: #6d5b62;
    margin: 0;
  }
  .video-box-{{ section.id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #111111;
    box-shadow: 0 10px 30px rgba(80, 20, 36, 0.12);
  }
  .video-box-{{ section.id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
{%- endstyle -%}

<div class="video-banner-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="content-container">
    <div class="video-section-wrap-{{ section.id }}">
      {%- if section.settings.heading != blank -%}
        <div class="video-header-{{ section.id }}">
          <h2>{{ section.settings.heading | escape }} <span>♡</span></h2>
          {%- if section.settings.subheading != blank -%}
            <p>{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="video-box-{{ section.id }}">
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1" title="{{ section.settings.heading | escape }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}" title="{{ section.settings.heading | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {%- else -%}
          <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #ffd2e2; font-family: Poppins, Arial, sans-serif; font-size: 14px; flex-direction: column; gap: 8px;">
            <span style="font-size: 32px;">🎬</span>
            <span>Paste a YouTube or Vimeo URL in the section settings</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "section-video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW TO APPLY IN 5 MINUTES"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch our step-by-step application tutorial for a 3-week wear."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video Link",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
