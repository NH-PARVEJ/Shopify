<style>

/* ==========================================================================
   BULLETPROOF HEADER CART BAG ICON (GLOBAL DESKTOP & MOBILE)
   ========================================================================== */
header .nav-bag,
.site-header .nav-bag,
.nav-bag {
  position: relative !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 34rem !important;
  height: 34rem !important;
  min-width: 34px !important;
  min-height: 34px !important;
  border-radius: 50% !important;
  color: #1a1a1a !important;
  text-decoration: none !important;
  transition: transform 0.2s ease, color 0.2s ease !important;
  flex-shrink: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  vertical-align: middle !important;
  box-sizing: border-box !important;
}

header .nav-bag:hover,
.site-header .nav-bag:hover,
.nav-bag:hover {
  color: #fa4087 !important;
  transform: scale(1.08) !important;
}

header .nav-bag svg,
header .nav-bag .bag-icon,
header .nav-bag .icon.bag-icon,
.site-header .nav-bag svg,
.site-header .nav-bag .bag-icon,
.site-header .nav-bag .icon.bag-icon,
.nav-bag svg,
.nav-bag .bag-icon,
.nav-bag .icon.bag-icon {
  display: block !important;
  width: 18rem !important;
  height: 18rem !important;
  min-width: 18px !important;
  min-height: 18px !important;
  stroke: currentColor !important;
  stroke-width: 1.8 !important;
  fill: none !important;
  flex-shrink: 0 !important;
  box-sizing: border-box !important;
}

header .nav-bag .bag-count,
.site-header .nav-bag .bag-count,
.nav-bag .bag-count {
  position: absolute !important;
  top: 1rem !important;
  right: 1rem !important;
  min-width: 15rem !important;
  height: 15rem !important;
  min-width: 15px !important;
  min-height: 15px !important;
  padding: 0 4rem !important;
  background: #fa4087 !important;
  color: #ffffff !important;
  border-radius: 999px !important;
  font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important;
  font-size: 8.5rem !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  pointer-events: none !important;
  box-sizing: border-box !important;
}

@media (max-width: 700px) {
  header .nav-bag,
  .site-header .nav-bag,
  .nav-bag {
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
  }
  header .nav-bag svg,
  header .nav-bag .bag-icon,
  .site-header .nav-bag svg,
  .site-header .nav-bag .bag-icon,
  .nav-bag svg,
  .nav-bag .bag-icon {
    width: 16px !important;
    height: 16px !important;
    min-width: 16px !important;
    min-height: 16px !important;
  }
  header .nav-bag .bag-count,
  .site-header .nav-bag .bag-count,
  .nav-bag .bag-count {
    top: -2px !important;
    right: -2px !important;
    font-size: 8px !important;
    min-width: 14px !important;
    height: 14px !important;
    min-height: 14px !important;
    padding: 0 2px !important;
  }
}

</style>
<header id="site-header" class="site-header">
  <button type="button" class="mobile-app-menu-btn" id="mobile-app-menu-btn" aria-label="{{ 'general.accessibility.menu' | t }}">{% render 'icon', name: 'menu' %}</button>
  <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {% if section.settings.logo %}{{ section.settings.logo | image_url: width: 600 | image_tag: class: 'logo', widths: '150,300,600', alt: shop.name }}{% else %}<img class="logo" src="{{ 'logo-hq-v2.png' | asset_url }}" alt="{{ shop.name | escape }}" width="300" height="100">{% endif %}
  </a>
  <nav aria-label="Main navigation">
    {% assign navigation = section.settings.menu %}
    {% for link in navigation.links %}
      {% assign mega = nil %}
      {% assign link_key = link.title | handleize %}
      {% for block in section.blocks %}
        {% assign trigger_key = block.settings.trigger_title | handleize %}
        {% if block.settings.trigger_link == link.url or trigger_key == link_key %}{% assign mega = block %}{% break %}{% endif %}
      {% endfor %}
      {% if mega %}
        <a class="{{ mega.settings.layout }}-menu-toggle{% if link.active %} active{% endif %}" href="{{ link.url }}" data-mega-toggle aria-controls="MegaMenu-{{ section.id }}-{{ mega.id }}" aria-expanded="false"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}{% render 'icon', name: 'chevron_down', class: 'nav-chevron' %}</a>
      {% elsif link.links.size > 0 %}
        <div class="nav-dropdown-item"><a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title | escape }}{% render 'icon', name: 'chevron_down', class: 'nav-chevron' %}</a><div class="nav-dropdown-menu">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</div></div>
      {% else %}<a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
    {% endfor %}
  </nav>
  <a class="nav-bag" href="{{ routes.cart_url }}" data-cart-trigger aria-label="{{ 'sections.cart.title' | t }}" style="position: relative !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; width: 34px !important; height: 34px !important; min-width: 34px !important; min-height: 34px !important; border-radius: 50% !important; color: #1a1a1a !important; text-decoration: none !important; margin: 0 !important; line-height: 1 !important; flex-shrink: 0 !important; vertical-align: middle !important;"><svg class="icon bag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="display: block !important; width: 18px !important; height: 18px !important; min-width: 18px !important; min-height: 18px !important; stroke: currentColor !important; stroke-width: 1.8 !important; fill: none !important; flex-shrink: 0 !important;"><path d="M5 8h14l1 14H4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 9V6a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="bag-count" style="position: absolute !important; top: -3px !important; right: -3px !important; min-width: 15px !important; height: 15px !important; padding: 0 4px !important; background: #fa4087 !important; color: #ffffff !important; border-radius: 999px !important; font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important; font-size: 9px !important; font-weight: 700 !important; display: flex !important; align-items: center !important; justify-content: center !important; line-height: 1 !important; pointer-events: none !important; box-sizing: border-box !important; box-shadow: 0 2px 4px rgba(250, 64, 135, 0.35) !important;">{{ cart.item_count }}</span></a>
  {% if section.settings.show_booking %}<a class="book" href="{{ section.settings.booking_link }}">{{ section.settings.booking_button_text | escape }}{% render 'icon', name: 'crown', class: 'crown-icon' %}</a>{% endif %}
  {% for block in section.blocks %}{% if block.type == 'mega_menu' %}{% render 'mega-menu', block: block, section: section %}{% endif %}{% endfor %}
</header>
