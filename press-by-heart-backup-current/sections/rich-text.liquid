{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
  }
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#1a1a1a' }};
  }
  .rich-text-wrap-{{ section.id }} {
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    max-width: {{ section.settings.max_width | default: '720px' }};
    margin: 0 auto;
  }
  .rich-text-wrap-{{ section.id }} .rich-text-eyebrow {
    font-family: Poppins, Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: {{ section.settings.accent_color | default: '#fa4087' }};
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  .rich-text-wrap-{{ section.id }} .rich-text-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: {% if section.settings.heading_size == 'small' %}24px{% elsif section.settings.heading_size == 'large' %}38px{% else %}30px{% endif %};
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 16px 0;
    color: inherit;
  }
  .rich-text-wrap-{{ section.id }} .rich-text-heading span {
    color: {{ section.settings.accent_color | default: '#fa4087' }};
    font-family: Arial, sans-serif;
  }
  .rich-text-wrap-{{ section.id }} .rich-text-body {
    font-family: Poppins, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: #4a383f;
    margin: 0 0 24px 0;
  }
  .rich-text-wrap-{{ section.id }} .rich-text-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: linear-gradient(105deg, #fa4087, #f13d84);
    color: #ffffff;
    font-family: Poppins, Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(250, 64, 135, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .rich-text-wrap-{{ section.id }} .rich-text-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(250, 64, 135, 0.38);
  }
  {% if section.settings.hide_desktop %}
    @media (min-width: 701px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {% endif %}
  {% if section.settings.hide_mobile %}
    @media (max-width: 700px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {% endif %}
{%- endstyle -%}

<div class="rich-text-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="content-container">
    <div class="rich-text-wrap-{{ section.id }}">
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <p class="rich-text-eyebrow">{{ section.settings.eyebrow | escape }} ♡</p>
      {%- endif -%}
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="rich-text-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_text and section.settings.text != blank -%}
        <div class="rich-text-body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.show_button and section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="rich-text-btn">
          {{ section.settings.button_label | escape }}
          <span>👑</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich Text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "header",
      "content": "Element Toggles (On / Off)"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show Eyebrow Subtitle",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Main Heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Show Body Text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Action Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subtitle",
      "default": "HANDCRAFTED LUXURY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SALON QUALITY AT YOUR FINGERTIPS"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Discover premium handcrafted press-on nails designed to give you a glamorous salon finish in minutes. Reusable, ultra-durable, and made with love.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE ALL DESIGNS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content Width",
      "options": [
        { "value": "560px", "label": "Narrow" },
        { "value": "760px", "label": "Standard" },
        { "value": "980px", "label": "Wide" }
      ],
      "default": "760px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#fa4087"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
