<style>
  /* Shopify section wrappers must not change the approved layout. */
  .shopify-section-group-header-group,.shopify-section-group-footer-group{display:contents}
  #pdp-form{display:contents}
  [hidden]{display:none!important}
  {% if settings.custom_typography %}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    body{font-family:{{ settings.font_body.family }},{{ settings.font_body.fallback_families }}}
    h1,h2{font-family:{{ settings.font_heading.family }},{{ settings.font_heading.fallback_families }}}
  {% endif %}
  {% if settings.custom_colors %}
    body{color:{{ settings.color_text_dark }}}
    .announcement-bar,.announcement{background:{{ settings.color_bg_announcement }}}
    .add,.shop-card-btn,.design-card-btn{color:{{ settings.color_primary }}}
  {% endif %}
</style>