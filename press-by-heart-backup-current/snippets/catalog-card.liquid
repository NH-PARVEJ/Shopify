{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign badge = product.metafields.custom.badge.value -%}
{%- for tag in product.tags -%}{% assign tag_key = tag | split: ':' | first %}{% assign tag_value = tag | remove_first: tag_key | remove_first: ':' %}{% case tag_key %}{% when 'badge' %}{% assign badge = badge | default: tag_value %}{% when 'shape' %}{% assign card_shape = tag_value %}{% when 'length' %}{% assign card_length = tag_value %}{% when 'colour' %}{% assign card_colour = tag_value %}{% endcase %}{%- endfor -%}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- if kind == 'kids' -%}
<article class="kids-product" data-shopify-product="true" data-tags="{{ product.tags | join: ' ' | escape }}">
  <div class="kids-product-media">
    {% if badge != blank %}<span class="kids-card-badge">{{ badge | escape }}</span>{% endif %}
    {% if product.featured_image != blank %}
      <a href="{{ product.url }}">{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180,300,450,600', sizes: '(max-width:700px) 45vw, 20vw' }}</a>
    {% else %}
      <a href="{{ product.url }}">{{ 'product-1' | placeholder_svg_tag: 'pbh-placeholder' }}</a>
    {% endif %}
  </div>
  <div class="kids-product-copy">
    {% if rating != blank %}<div class="kids-product-rating">★★★★★ <span>{{ rating.rating }}</span></div>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p>{{ product.price | money }}</p>
    <button type="button" class="kids-add" data-variant-id="{{ variant.id }}" data-name="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 400 }}{% else %}{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }} <span class="kids-glyph" data-kids-icon="bag" aria-hidden="true"></span></button>
  </div>
</article>
{%- else -%}
{%- assign prefix = kind | append: '-card' -%}
<article class="{{ prefix }}" data-shopify-product="true" data-shape="{{ product.metafields.custom.shape.value | default: card_shape | handleize }}" data-length="{{ product.metafields.custom.length.value | default: card_length | handleize }}" data-colour="{{ product.metafields.custom.colour.value | default: card_colour | handleize }}" data-tags="{{ product.tags | join: ' ' | escape }}">
  <div class="{{ prefix }}-media">
    {% if product.featured_image != blank %}
      <a href="{{ product.url }}">{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200,400,600,800', sizes: '(max-width:700px) 45vw, 25vw' }}</a>
    {% else %}
      <a href="{{ product.url }}">{{ 'product-1' | placeholder_svg_tag: 'pbh-placeholder' }}</a>
    {% endif %}
    {% if badge != blank %}<span class="{{ prefix }}-badge">{{ badge | escape }}</span>{% endif %}
  </div>
  <div class="{{ prefix }}-body">
    {% if kind == 'design' %}<div class="design-card-tags">{% for key in (1..3) %}{% case key %}{% when 1 %}{% assign tag = product.metafields.custom.shape.value %}{% when 2 %}{% assign tag = product.metafields.custom.length.value %}{% when 3 %}{% assign tag = product.metafields.custom.colour.value %}{% endcase %}{% if tag != blank %}<span class="design-card-tag">{{ tag | escape }}</span>{% endif %}{% endfor %}</div>{% endif %}
    {% if rating != blank %}<div class="{{ prefix }}-rating">★★★★★ <span>{{ rating.rating }}</span></div>{% endif %}
    <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
    <p class="{{ prefix }}-desc">{{ product.metafields.custom.card_description.value | default: product.description | strip_html | truncatewords: 18 }}</p>
    <div class="{{ prefix }}-price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
    <button class="{{ prefix }}-btn" type="button" data-variant-id="{{ variant.id }}" data-name="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 400 }}{% else %}{% endif %}" {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
  </div>
</article>
{%- endif -%}
