<div class="content-container customer-addresses" style="max-width: 800px; margin: 50px auto; padding: 0 16px; min-height: 60vh;">
  <div style="border-bottom: 1px solid #ffdeea; padding-bottom: 16px; margin-bottom: 24px;">
    <h1 style="font-family: 'Times New Roman', serif; font-size: 32px; margin: 0 0 6px;">
      Your Addresses <span style="color: #f93685; font-family: Allura, cursive; font-size: 36px;">♡</span>
    </h1>
    <a href="{{ routes.account_url }}" style="font-size: 12px; color: #ed4c9b; text-decoration: underline;">← Back to Account</a>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
    {%- for address in customer.addresses -%}
      <div style="border: 1px solid #ffdeea; border-radius: 8px; padding: 18px; background: #fff5f8; font-size: 13px; line-height: 1.6;">
        {%- if address == customer.default_address -%}
          <span style="display: inline-block; padding: 2px 8px; font-size: 10px; font-weight: bold; background: #ed4c9b; color: #fff; border-radius: 4px; margin-bottom: 10px;">DEFAULT</span>
        {%- endif -%}
        <p style="margin: 0; color: #333;">
          <strong>{{ address.name }}</strong><br>
          {{ address.address1 }}<br>
          {%- if address.address2 != blank -%}{{ address.address2 }}<br>{%- endif -%}
          {{ address.city }}, {{ address.zip }}<br>
          {{ address.country }}
        </p>
      </div>
    {%- endfor -%}
  </div>
</div>
