<div class="content-container customer-auth" style="max-width: 440px; margin: 60px auto; padding: 0 16px; min-height: 60vh;">
  <h1 style="font-family: 'Times New Roman', serif; font-size: 32px; text-align: center; margin-bottom: 8px;">
    Reset Password <span style="color: #f93685; font-family: Allura, cursive; font-size: 36px;">♡</span>
  </h1>
  <p style="text-align: center; color: #666; font-size: 13px; margin-bottom: 28px;">Enter a new password for your account</p>

  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}

    <div style="margin-bottom: 16px;">
      <label for="ResetPassword" style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">New Password</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required style="width: 100%; height: 42px; border: 1px solid #ffdeea; border-radius: 8px; padding: 0 14px; font-size: 13px; box-sizing: border-box;">
    </div>

    <div style="margin-bottom: 24px;">
      <label for="PasswordConfirmation" style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Confirm New Password</label>
      <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" autocomplete="new-password" required style="width: 100%; height: 42px; border: 1px solid #ffdeea; border-radius: 8px; padding: 0 14px; font-size: 13px; box-sizing: border-box;">
    </div>

    <button type="submit" style="width: 100%; height: 44px; background: #f93685; color: #fff; border: none; border-radius: 22px; font-weight: 600; font-size: 13px; cursor: pointer; letter-spacing: 0.5px;">
      RESET PASSWORD
    </button>
  {%- endform -%}
</div>
