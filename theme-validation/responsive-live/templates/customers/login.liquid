<div class="content-container customer-auth" style="max-width: 440px; margin: 60px auto; padding: 0 16px; min-height: 60vh;">
  <h1 style="font-family: 'Times New Roman', serif; font-size: 32px; text-align: center; margin-bottom: 8px;">
    Welcome Back <span style="color: #f93685; font-family: Allura, cursive; font-size: 36px;">♡</span>
  </h1>
  <p style="text-align: center; color: #666; font-size: 13px; margin-bottom: 28px;">Sign in to your Heart Club account</p>

  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <div style="margin-bottom: 16px;">
      <label for="CustomerEmail" style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Email Address</label>
      <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required style="width: 100%; height: 42px; border: 1px solid #ffdeea; border-radius: 8px; padding: 0 14px; font-size: 13px; box-sizing: border-box;">
    </div>
    {%- if form.password_needed -%}
      <div style="margin-bottom: 20px;">
        <label for="CustomerPassword" style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px;">Password</label>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required style="width: 100%; height: 42px; border: 1px solid #ffdeea; border-radius: 8px; padding: 0 14px; font-size: 13px; box-sizing: border-box;">
      </div>
    {%- endif -%}

    <button type="submit" class="shop-button" style="width: 100%; height: 44px; margin-bottom: 16px; font-size: 11px;">
      SIGN IN <span>👑</span>
    </button>

    <div style="text-align: center; font-size: 12px; color: #666;">
      <p style="margin-bottom: 8px;"><a href="{{ routes.account_register_url }}" style="color: #ed4c9b; text-decoration: underline;">Don't have an account? Create one</a></p>
    </div>
  {%- endform -%}
</div>
