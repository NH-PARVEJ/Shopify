{%- assign free_shipping_threshold = settings.free_shipping_threshold | default: 30.00 -%}
{%- assign standard_shipping = settings.standard_shipping_rate | default: 3.99 -%}
{%- assign cart_total_price_float = cart.total_price | divided_by: 100.0 -%}

<div class="cart-sidebar-drawer" id="cart-sidebar-drawer" aria-hidden="true" role="dialog" aria-labelledby="cart-drawer-title">
  <style>
  /* Cart Sidebar Drawer Container & Slide-over */
  #cart-sidebar-drawer.cart-sidebar-drawer,
  .cart-sidebar-drawer {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    z-index: 999999 !important;
    pointer-events: none !important;
    visibility: hidden !important;
    transition: visibility 0.28s ease !important;
    overflow: hidden !important;
  }

  #cart-sidebar-drawer.cart-sidebar-drawer.is-open,
  .cart-sidebar-drawer.is-open {
    pointer-events: auto !important;
    visibility: visible !important;
  }

  /* Dimmed backdrop overlay */
  #cart-sidebar-drawer .cart-sidebar-overlay,
  .cart-sidebar-overlay {
    position: absolute !important;
    inset: 0 !important;
    background: rgba(20, 8, 14, 0.55) !important;
    backdrop-filter: blur(4px) !important;
    -webkit-backdrop-filter: blur(4px) !important;
    opacity: 0 !important;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1) !important;
    cursor: pointer !important;
  }

  #cart-sidebar-drawer.is-open .cart-sidebar-overlay,
  .cart-sidebar-drawer.is-open .cart-sidebar-overlay {
    opacity: 1 !important;
  }

  /* Sliding Panel */
  #cart-sidebar-drawer .cart-sidebar-panel,
  .cart-sidebar-panel {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 440px !important;
    max-width: 92vw !important;
    height: 100% !important;
    background: #ffffff !important;
    display: flex !important;
    flex-direction: column !important;
    box-shadow: -8px 0 36px rgba(108, 36, 50, 0.22) !important;
    transform: translateX(100%) !important;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1) !important;
    z-index: 2 !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  #cart-sidebar-drawer.is-open .cart-sidebar-panel,
  .cart-sidebar-drawer.is-open .cart-sidebar-panel {
    transform: translateX(0) !important;
  }

  /* Header */
  #cart-sidebar-drawer .cart-sidebar-header,
