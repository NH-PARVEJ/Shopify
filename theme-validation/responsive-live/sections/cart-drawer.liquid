  <div class="cart-sidebar-overlay" aria-hidden="true"></div>
  <div class="cart-sidebar-panel" role="document">
    
    <!-- Drawer Header -->
    <div class="cart-sidebar-header">
      <div class="cart-header-title-wrap">
        <h2 id="cart-drawer-title" class="cart-sidebar-title">
          {{ section.settings.copy_1 | escape }} <span class="cart-heart">♡</span>
        </h2>
        <span class="cart-item-count-badge" id="cart-drawer-item-count">
          {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}
        </span>
      </div>
      <button type="button" class="cart-sidebar-close" id="cart-sidebar-close" aria-label="Close shopping bag">✕</button>
    </div>

    <!-- Free Delivery Goal Bar -->
    <div class="cart-shipping-goal" id="cart-shipping-goal">
      <div class="cart-shipping-label" id="cart-shipping-label">
        {%- if cart_total_price_float >= free_shipping_threshold -%}
          <span>🎉</span> <strong>{{ section.settings.copy_2 | escape }}</strong>
        {%- else -%}
          {%- assign remaining = free_shipping_threshold | minus: cart_total_price_float -%}
          <span>🚚</span> <span>{{ section.settings.copy_3 | escape }} <strong>£{{ remaining | round: 2 }}</strong> {{ section.settings.copy_4 | escape }} <strong>{{ section.settings.copy_5 | escape }}</strong></span>
        {%- endif -%}
      </div>
      <div class="cart-shipping-track">
        {%- assign progress_pct = cart_total_price_float | times: 100 | divided_by: free_shipping_threshold | at_most: 100 -%}
        <div class="cart-shipping-fill {% if progress_pct >= 100 %}unlocked{% endif %}" id="cart-shipping-fill" style="width: {{ progress_pct }}%;"></div>
      </div>
    </div>

    <!-- Drawer Body (Items List or Empty State) -->
    <div class="cart-sidebar-body" id="cart-sidebar-body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty-state">
          <div class="cart-empty-icon-wrap">
            <svg viewBox="0 0 24 24" class="cart-empty-svg" aria-hidden="true">
              <path d="M5 8h14l1 14H4Z" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round"/>
              <path d="M8 9V6a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
              <path d="M12 18c-4-2.5-2.5-5 0-3 2.5-2 4 .5 0 3Z" fill="#fa4087"/>
            </svg>
          </div>
          <h3 class="cart-empty-title">{{ section.settings.copy_8 | escape }}</h3>
          <p class="cart-empty-desc">{{ section.settings.copy_9 | escape }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="cart-empty-cta">
            {{ section.settings.copy_10 | escape }} <span>✨</span>
          </a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <article class="cart-item-card" data-key="{{ item.key }}" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-item-img-wrap" aria-label="View {{ item.product.title | escape }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" loading="lazy" width="70" height="70">
              {%- else -%}
                <img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'product-0.png' | asset_url }}{% endif %}" alt="{{ item.title | escape }}" loading="lazy" width="70" height="70">
              {%- endif -%}
            </a>
            <div class="cart-item-info">
              <div class="cart-item-top">
                <h3 class="cart-item-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                <button type="button" class="cart-item-remove" data-action="remove" data-line="{{ forloop.index }}" data-key="{{ item.key }}" aria-label="Remove {{ item.product.title | escape }} from bag">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                </button>
              </div>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item-details">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="cart-item-bottom">
                <div class="cart-item-stepper">
                  <button type="button" class="cart-step-btn" data-action="decrease" data-line="{{ forloop.index }}" data-key="{{ item.key }}" aria-label="Decrease quantity">−</button>
                  <span class="cart-step-qty" aria-label="Quantity {{ item.quantity }}">{{ item.quantity }}</span>
                  <button type="button" class="cart-step-btn" data-action="increase" data-line="{{ forloop.index }}" data-key="{{ item.key }}" aria-label="Increase quantity">+</button>
                </div>
                <div class="cart-item-pricing">
                  <span class="cart-item-total-price">{{ item.final_line_price | money }}</span>
                  {%- if item.quantity > 1 -%}
                    <small class="cart-item-unit-price">({{ item.final_price | money }} {{ section.settings.copy_11 | escape }}</small>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Drawer Footer -->
    <div class="cart-sidebar-footer" id="cart-sidebar-footer" style="{% if cart.item_count == 0 %}display:none;{% else %}display:flex;{% endif %}">
      <!-- Promo Code Box -->
      <div class="cart-promo-section cart-promo-wrap" style="display: flex !important; flex-direction: column !important; gap: 8px !important; width: 100% !important; box-sizing: border-box !important;">
        <div class="cart-promo-input-wrap cart-promo-input-row" style="display: flex !important; align-items: center !important; gap: 8px !important; width: 100% !important; box-sizing: border-box !important;">
          <input type="text" id="cart-promo-input" class="cart-promo-input" placeholder="{{ section.settings.promo_placeholder | default: 'Promo code (e.g. HEART10)' | escape }}" aria-label="Discount promo code" autocomplete="off" style="flex: 1 1 auto !important; min-width: 0 !important; width: 100% !important; height: 42px !important; padding: 0 14px !important; border: 1.5px solid #f1dde4 !important; border-radius: 8px !important; background: #ffffff !important; font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important; font-size: 13px !important; color: #4a1520 !important; outline: none !important; box-sizing: border-box !important; -webkit-appearance: none !important; appearance: none !important; box-shadow: none !important;">
          <button type="button" id="cart-promo-apply-btn" class="cart-promo-btn" style="padding: 0 18px !important; height: 42px !important; min-height: 42px !important; background: #fdf0f4 !important; border: 1.5px solid #f1dde4 !important; border-radius: 8px !important; color: #fa4087 !important; font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important; font-size: 12px !important; font-weight: 700 !important; letter-spacing: 0.6px !important; cursor: pointer !important; white-space: nowrap !important; flex-shrink: 0 !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; box-sizing: border-box !important; transition: all 0.2s ease !important; text-transform: uppercase !important;">{{ section.settings.copy_12 | default: 'APPLY' | escape }}</button>
        </div>
        <div id="cart-promo-status" class="cart-promo-status" role="status" aria-live="polite" style="font-size: 11px !important; font-family: Poppins, Arial, sans-serif !important; min-height: 14px !important; line-height: 1.3 !important;"></div>
      </div>

      <!-- Financial Summary Table -->
      <div class="cart-summary-table">
        <div class="cart-summary-row">
          <span>{{ section.settings.copy_13 | escape }}</span>
          <span id="cart-summary-subtotal">{{ cart.original_total_price | money }}</span>
        </div>
        {% for discount in cart.cart_level_discount_applications %}<div class="cart-summary-row discount-row cart-discount-row"><span>{{ discount.title | escape }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>{% endfor %}<div class="cart-summary-row discount-row cart-discount-row" id="cart-discount-row" style="display:none;">
          <span>{{ section.settings.copy_14 | escape }}<strong id="cart-discount-code">{{ section.settings.copy_15 | escape }}</strong>)</span>
          <span id="cart-summary-discount">{{ section.settings.copy_16 | escape }}</span>
        </div>
        <div class="cart-summary-row">
          <span>{{ section.settings.copy_17 | escape }}</span>
          <span id="cart-summary-shipping">
            {%- if cart_total_price_float >= free_shipping_threshold -%}
              {{ section.settings.copy_18 | escape }}
            {%- else -%}
              £{{ standard_shipping }}
            {%- endif -%}
          </span>
        </div>
        <div class="cart-summary-row total-row cart-summary-total">
          <span>{{ section.settings.copy_19 | escape }}</span>
          <span id="cart-summary-total">{% if cart_total_price_float >= free_shipping_threshold %}{{ cart.total_price | money }}{% else %}{% assign estimated_shipping = standard_shipping | times: 100 %}{{ cart.total_price | plus: estimated_shipping | money }}{% endif %}</span>
        </div>
      </div>

      <!-- Perks Note -->
      <div class="cart-sidebar-perk">
        <span class="cart-perk-icon">🎁</span>
        <span><strong>{{ section.settings.perk_title | default: 'FREE Luxury Prep Kit' | escape }}</strong> {{ section.settings.perk_desc | default: 'included with every order (Nail glue, buffer & cuticle stick)' | escape }}</span>
      </div>

      <!-- Checkout Action Buttons -->
      <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
        <button type="submit" name="checkout" class="cart-checkout-btn">
          {{ section.settings.copy_20 | escape }} <span>👑</span>
        </button>
      </form>

      <!-- Trust Badges -->
      <div class="cart-trust-footer cart-trust-badges">
        <span>{{ section.settings.copy_21 | escape }}</span>
        <span>•</span>
        <span>{{ section.settings.copy_22 | escape }}</span>
      </div>
    </div>

  </div>
</div>


