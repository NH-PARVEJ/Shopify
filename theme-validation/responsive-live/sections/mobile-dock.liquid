{% if section.settings.show_dock %}<nav class="mobile-app-dock" aria-label="Mobile navigation" style="--dock-items:{{ section.settings.menu.links.size }};margin:0!important;left:0!important;right:0!important;width:100%!important">{% assign defaults = 'home,grid,sparkles,crown,bag' | split: ',' %}{% for link in section.settings.menu.links %}{% assign item_icon = defaults[forloop.index0] | default: 'heart' %}{% assign custom_image = nil %}{% for block in section.blocks %}{% if block.settings.link == link.url %}{% assign item_icon = block.settings.icon %}{% assign custom_image = block.settings.image %}{% endif %}{% endfor %}<a href="{{ link.url }}" class="app-tab{% if link.active %} active{% endif %}{% if link.url == routes.cart_url %} app-tab-bag{% endif %}"{% if link.url == routes.cart_url %} data-cart-trigger{% endif %}><span class="app-tab-icon app-tab-bag-wrap">{% if custom_image %}{{ custom_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}{% else %}{% render 'icon', name: item_icon %}{% endif %}{% if link.url == routes.cart_url %}<span class="app-tab-badge" id="mobile-dock-badge">{{ cart.item_count }}</span>{% endif %}</span><span class="app-tab-label">{{ link.title | escape }}</span></a>{% endfor %}</nav>{% endif %}{% render 'mobile-app-drawer' %}
