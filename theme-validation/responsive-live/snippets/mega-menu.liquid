{% assign options = block.settings %}
<div id="MegaMenu-{{ section.id }}-{{ block.id }}" class="{{ options.layout }}-menu pbh-mega-menu" hidden aria-label="{{ options.trigger_title | escape }}" {{ block.shopify_attributes }}>
  {% case options.layout %}
  {% when 'shop-all' %}
    <div class="shop-all-menu-pointer" aria-hidden="true"></div><div class="shop-all-menu-body"><div class="shop-all-menu-col"><div class="shop-all-menu-links">
      {% for link in options.menu.links %}<a href="{{ link.url }}"><span class="shop-all-glyph">{% render 'navigation-art', link: link, index: forloop.index, section: section %}</span><span class="shop-all-text"><strong>{{ link.title | escape }}</strong>{% render 'menu-item-copy', link: link, section: section %}</span></a>{% endfor %}
    </div>{% if options.secondary_label != blank %}<a class="shop-all-action shop-all-action-outline" href="{{ options.secondary_link }}">{{ options.secondary_label | escape }}{% render 'icon', name: 'chevron', class: 'action-chevron' %}</a>{% endif %}</div><div class="shop-all-menu-col"><div class="shop-all-menu-img-wrap">{% if options.image %}{{ options.image | image_url: width: 900 | image_tag: class: 'shop-all-menu-product', loading: 'lazy' }}{% else %}<img class="shop-all-menu-product" src="{{ 'shop-all-menu-product.png' | asset_url }}" alt="{{ shop.name | escape }}" width="265" height="305">{% endif %}</div>{% if options.button_label != blank %}<a class="shop-all-action shop-all-action-primary" href="{{ options.button_link }}">{{ options.button_label | escape }}{% render 'icon', name: 'chevron' %}</a>{% endif %}</div></div>
  {% when 'kids' %}
    <div class="kids-menu-pointer" aria-hidden="true"></div><div class="kids-menu-copy"><h2>{{ options.heading | escape }} <span>💕</span></h2><p>{{ options.description }}</p><div class="kids-menu-links">{% for link in options.menu.links %}<a href="{{ link.url }}"><span class="kids-glyph">{% render 'navigation-art', link: link, index: forloop.index, section: section %}</span><span><strong>{{ link.title | escape }}</strong>{% render 'menu-item-copy', link: link, section: section %}</span></a>{% endfor %}</div>{% if options.button_label != blank %}<a class="kids-primary" href="{{ options.button_link }}">{{ options.button_label | escape }}{% render 'icon', name: 'arrowRight' %}</a>{% endif %}</div>{% if options.image %}{{ options.image | image_url: width: 900 | image_tag: class: 'kids-menu-product', loading: 'lazy' }}{% else %}<img class="kids-menu-product" src="{{ 'menu-product-hq.png' | asset_url }}" alt="{{ shop.name | escape }}" width="272" height="340">{% endif %}
  {% when 'shop-by-design' %}
    <div class="shop-by-design-pointer" aria-hidden="true"></div><div class="shop-by-design-body">{% for column in (1..3) %}{% assign menu_key = 'menu' %}{% if column > 1 %}{% assign menu_key = 'menu_' | append: column %}{% endif %}{% assign heading_key = 'column_' | append: column | append: '_title' %}<div class="sbd-col"><div><h3 class="sbd-col-title">{{ options[heading_key] | escape }} <span class="sbd-heart">💕</span></h3><div class="{% if column == 3 %}sbd-colours-grid{% else %}sbd-items{% endif %}">{% for link in options[menu_key].links %}<a class="{% if column == 1 %}sbd-shape-item{% elsif column == 2 %}sbd-length-item{% else %}sbd-colour-item{% endif %}" href="{{ link.url }}">{% render 'navigation-art', link: link, column: column, index: forloop.index, section: section %}{% if column == 2 %}<span class="sbd-length-text"><strong>{{ link.title | escape }}</strong>{% render 'menu-item-copy', link: link, section: section %}</span>{% else %}<strong>{{ link.title | escape }}</strong>{% endif %}</a>{% endfor %}</div></div>{% case column %}{% when 1 %}{% assign button_text = options.secondary_label %}{% assign button_link = options.secondary_link %}{% when 2 %}{% assign button_text = options.column_2_button %}{% assign button_link = options.column_2_link %}{% when 3 %}{% assign button_text = options.column_3_button %}{% assign button_link = options.column_3_link %}{% endcase %}{% if button_text != blank %}<a class="sbd-action-btn" href="{{ button_link }}">{{ button_text | escape }}{% render 'icon', name: 'chevron' %}</a>{% endif %}</div>{% endfor %}</div>
  {% endcase %}
</div>
