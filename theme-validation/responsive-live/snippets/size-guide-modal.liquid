<!-- Size Guide Modal -->
<div class="pdp-modal" id="size-guide-modal" aria-hidden="true" role="dialog" aria-labelledby="modal-title">
  <div class="pdp-modal-dialog">
    <button class="pdp-modal-close" id="close-size-guide" type="button" aria-label="Close size guide">✕</button>
    <h3 id="modal-title">{{ section.settings.size_guide_moda_1 | escape }}</h3>
    <p>{{ section.settings.size_guide_moda_2 | escape }}</p>
    <table class="pdp-size-table">
      <thead>
        <tr>
          <th>{{ section.settings.size_guide_moda_3 | escape }}</th>
          <th>{{ section.settings.size_guide_moda_4 | escape }}</th>
          <th>{{ section.settings.size_guide_moda_5 | escape }}</th>
          <th>{{ section.settings.size_guide_moda_6 | escape }}</th>
          <th>{{ section.settings.size_guide_moda_7 | escape }}</th>
          <th>{{ section.settings.size_guide_moda_8 | escape }}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>{{ section.settings.size_guide_moda_9 | escape }}</strong></td>
          <td>{{ section.settings.size_guide_moda_10 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_11 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_12 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_13 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_14 | escape }}</td>
        </tr>
        <tr>
          <td><strong>S</strong></td>
          <td>{{ section.settings.size_guide_moda_15 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_16 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_17 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_18 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_19 | escape }}</td>
        </tr>
        <tr>
          <td><strong>M</strong></td>
          <td>{{ section.settings.size_guide_moda_20 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_21 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_22 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_23 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_24 | escape }}</td>
        </tr>
        <tr>
          <td><strong>L</strong></td>
          <td>{{ section.settings.size_guide_moda_25 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_26 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_27 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_28 | escape }}</td>
          <td>{{ section.settings.size_guide_moda_29 | escape }}</td>
        </tr>
      </tbody>
    </table>
    <p>💡 <em>{{ section.settings.size_guide_moda_30 | escape }}</em></p>
  </div>
</div>
