<form method="get" class="shop-filter-form">
  <label for="Sort-{{ section.id }}">{{ 'collections.sorting.title' | t }}</label>
  <select name="sort_by" id="Sort-{{ section.id }}" data-auto-submit>
    {% for option in results.sort_options %}<option value="{{ option.value }}" {% if results.sort_by == option.value %}selected{% endif %}>{{ option.name }}</option>{% endfor %}
  </select>
  {% for filter in results.filters %}
    <details><summary>{{ filter.label }}</summary>
    {% if filter.type == 'price_range' %}
      <label>{{ filter.min_value.param_name }} <input type="number" name="{{ filter.min_value.param_name }}" min="0" value="{{ filter.min_value.value | divided_by: 100.0 }}" step="0.01"></label>
      <label>{{ filter.max_value.param_name }} <input type="number" name="{{ filter.max_value.param_name }}" min="0" value="{{ filter.max_value.value | divided_by: 100.0 }}" step="0.01"></label>
    {% else %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label }} ({{ value.count }})</label>{% endfor %}{% endif %}
    </details>
  {% endfor %}
  <button class="shop-chip" type="submit">{{ 'collections.filtering.apply' | t }}</button>
</form>
