{% comment %}
  Press By Heart - Bulletproof Review Modal Snippet
  Ensures the 'Write a Review' popup can be rendered and opened reliably anywhere.
{% endcomment %}
<div class="pdp-modal" id="review-modal" role="dialog" aria-hidden="true" aria-labelledby="review-form-title">
  <div class="pdp-modal-dialog pdp-review-modal-dialog" style="background: #ffffff !important; border-radius: 16px !important; max-width: 480px !important; width: 100% !important; padding: 28px 24px !important; box-shadow: 0 20px 48px rgba(80, 20, 36, 0.22) !important; position: relative !important; max-height: 90vh !important; overflow-y: auto !important; box-sizing: border-box !important; border: 1.5px solid #fae2eb !important;">
    <button type="button" class="pdp-modal-close" id="close-review-form" aria-label="Close review form" style="position: absolute !important; top: 16px !important; right: 16px !important; width: 34px !important; height: 34px !important; border-radius: 50% !important; border: 1px solid #ffd2e2 !important; background: #fff0f5 !important; color: #fa4087 !important; font-size: 16px !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; line-height: 1 !important; padding: 0 !important;">✕</button>
    <div class="pdp-review-modal-header" style="margin-bottom: 18px !important; padding-right: 32px !important; text-align: left !important;">
      <h3 id="review-form-title" style="font-family: Georgia, 'Times New Roman', serif !important; font-size: 22px !important; color: #1a1a1a !important; margin: 0 0 6px 0 !important; font-weight: 700 !important; line-height: 1.25 !important;">Write a Review</h3>
      <p class="pdp-review-modal-subtitle" style="font-family: Poppins, Arial, sans-serif !important; font-size: 13px !important; color: #7a6e74 !important; margin: 0 !important; line-height: 1.4 !important;">Share your experience with other nail lovers 💕</p>
    </div>
    {% form 'contact', id: 'product-review-form', class: 'pdp-review-form' %}
      <div class="pdp-review-form-inner" style="display: flex !important; flex-direction: column !important; gap: 14px !important; width: 100% !important; box-sizing: border-box !important;">
        {{ form.errors | default_errors }}
        {% if form.posted_successfully? %}
          <div class="pdp-review-success" role="status" style="display: flex !important; align-items: center !important; gap: 10px !important; padding: 12px 14px !important; background: #f0fdf4 !important; border: 1.5px solid #bbf7d0 !important; border-radius: 8px !important; color: #166534 !important; font-family: Poppins, Arial, sans-serif !important; font-size: 13px !important; line-height: 1.4 !important;">
            <i>🌸</i>
            <p style="margin: 0 !important;"><strong>Thank you for your review!</strong><br>Your feedback has been submitted successfully and will appear after moderation.</p>
          </div>
        {% endif %}
        <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
        <div class="pdp-review-rating-picker" style="display: flex !important; flex-direction: column !important; gap: 6px !important; text-align: left !important; margin-bottom: 2px !important;">
          <label class="pdp-field-label" style="font-family: Poppins, Arial, sans-serif !important; font-size: 13px !important; font-weight: 600 !important; color: #2c2126 !important; display: flex !important; align-items: center !important; gap: 4px !important; margin: 0 !important;">Overall Rating <span class="required" style="color: #fa4087 !important; font-weight: 700 !important;">*</span></label>
          <div class="pdp-star-rating-select" id="pdp-star-rating-select" role="radiogroup" aria-label="Star rating" style="display: flex !important; flex-direction: row-reverse !important; justify-content: flex-end !important; gap: 4px !important;">
            <button type="button" class="pdp-star-btn active" data-rating="5" aria-label="5 stars" aria-checked="true" style="background: none !important; border: none !important; padding: 0 2px !important; font-size: 26px !important; color: #fa4087 !important; cursor: pointer !important; line-height: 1 !important;">★</button>
            <button type="button" class="pdp-star-btn active" data-rating="4" aria-label="4 stars" aria-checked="false" style="background: none !important; border: none !important; padding: 0 2px !important; font-size: 26px !important; color: #fa4087 !important; cursor: pointer !important; line-height: 1 !important;">★</button>
            <button type="button" class="pdp-star-btn active" data-rating="3" aria-label="3 stars" aria-checked="false" style="background: none !important; border: none !important; padding: 0 2px !important; font-size: 26px !important; color: #fa4087 !important; cursor: pointer !important; line-height: 1 !important;">★</button>
            <button type="button" class="pdp-star-btn active" data-rating="2" aria-label="2 stars" aria-checked="false" style="background: none !important; border: none !important; padding: 0 2px !important; font-size: 26px !important; color: #fa4087 !important; cursor: pointer !important; line-height: 1 !important;">★</button>
            <button type="button" class="pdp-star-btn active" data-rating="1" aria-label="1 star" aria-checked="false" style="background: none !important; border: none !important; padding: 0 2px !important; font-size: 26px !important; color: #fa4087 !important; cursor: pointer !important; line-height: 1 !important;">★</button>
          </div>
          <input type="hidden" name="contact[rating]" id="pdp-rating-input" value="5">
        </div>
        <div class="pdp-form-field" style="display: flex !important; flex-direction: column !important; gap: 5px !important; width: 100% !important; text-align: left !important; box-sizing: border-box !important;">
          <label for="review-author-name" class="pdp-field-label" style="font-family: Poppins, Arial, sans-serif !important; font-size: 13px !important; font-weight: 600 !important; color: #2c2126 !important; display: flex !important; align-items: center !important; gap: 4px !important; margin: 0 !important;">Your Name <span class="required" style="color: #fa4087 !important; font-weight: 700 !important;">*</span></label>
          <input id="review-author-name" class="pdp-form-input" required name="contact[name]" autocomplete="name" placeholder="e.g. Sarah Jenkins" style="width: 100% !important; height: 42px !important; padding: 0 14px !important; border: 1.5px solid #f1dde4 !important; border-radius: 8px !important; background: #fffcfd !important; font-family: Poppins, Arial, sans-serif !important; font-size: 13.5px !important; color: #1a1a1a !important; outline: none !important; box-sizing: border-box !important; -webkit-appearance: none !important; appearance: none !important;">
        </div>
        <div class="pdp-form-field" style="display: flex !important; flex-direction: column !important; gap: 5px !important; width: 100% !important; text-align: left !important; box-sizing: border-box !important;">
          <label for="review-author-email" class="pdp-field-label" style="font-family: Poppins, Arial, sans-serif !important; font-size: 13px !important; font-weight: 600 !important; color: #2c2126 !important; display: flex !important; align-items: center !important; gap: 4px !important; margin: 0 !important;">Email Address <span class="required" style="color: #fa4087 !important; font-weight: 700 !important;">*</span></label>
          <input id="review-author-email" class="pdp-form-input" required name="contact[email]" type="email" autocomplete="email" placeholder="e.g. sarah@example.com" style="width: 100% !important; height: 42px !important; padding: 0 14px !important; border: 1.5px solid #f1dde4 !important; border-radius: 8px !important; background: #fffcfd !important; font-family: Poppins, Arial, sans-serif !important; font-size: 13.5px !important; color: #1a1a1a !important; outline: none !important; box-sizing: border-box !important; -webkit-appearance: none !important; appearance: none !important;">
          <span class="pdp-field-hint" style="font-family: Poppins, Arial, sans-serif !important; font-size: 11px !important; color: #92838a !important; margin-top: 2px !important; line-height: 1.3 !important;">Your email is kept private and will never be published.</span>
        </div>
        <div class="pdp-form-field" style="display: flex !important; flex-direction: column !important; gap: 5px !important; width: 100% !important; text-align: left !important; box-sizing: border-box !important;">
          <label for="review-body-text" class="pdp-field-label" style="font-family: Poppins, Arial, sans-serif !important; font-size: 13px !important; font-weight: 600 !important; color: #2c2126 !important; display: flex !important; align-items: center !important; gap: 4px !important; margin: 0 !important;">Your Review <span class="required" style="color: #fa4087 !important; font-weight: 700 !important;">*</span></label>
          <textarea id="review-body-text" class="pdp-form-textarea" required name="contact[body]" rows="4" placeholder="How was the fit, finish, and wear time? What did you love most?" style="width: 100% !important; min-height: 96px !important; padding: 10px 14px !important; border: 1.5px solid #f1dde4 !important; border-radius: 8px !important; background: #fffcfd !important; font-family: Poppins, Arial, sans-serif !important; font-size: 13.5px !important; color: #1a1a1a !important; outline: none !important; resize: vertical !important; box-sizing: border-box !important; line-height: 1.5 !important; -webkit-appearance: none !important; appearance: none !important;"></textarea>
        </div>
        <button type="submit" class="pdp-review-submit-btn" id="pdp-submit-review" style="width: 100% !important; height: 44px !important; min-height: 44px !important; background: linear-gradient(105deg, #fa4087, #f13d84) !important; color: #ffffff !important; border: none !important; border-radius: 8px !important; font-family: Poppins, Arial, sans-serif !important; font-size: 13.5px !important; font-weight: 700 !important; letter-spacing: 0.6px !important; cursor: pointer !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; box-shadow: 0 4px 14px rgba(250, 64, 135, 0.28) !important; transition: all 0.2s ease !important; margin-top: 6px !important; box-sizing: border-box !important; text-transform: uppercase !important;">SUBMIT REVIEW ✨</button>
      </div>
    {% endform %}
  </div>
</div>
