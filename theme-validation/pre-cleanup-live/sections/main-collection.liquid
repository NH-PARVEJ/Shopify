{% assign hero_script = section.settings.copy_1 %}{% assign hero_line1 = section.settings.copy_2 %}{% assign hero_line2 = section.settings.copy_3 %}{% assign hero_description = section.settings.copy_4 %}{% assign hero_description2 = section.settings.copy_5 %}{% assign hero_button = section.settings.copy_7 %}
{% case collection.handle %}{% when 'pedis' %}{% assign hero_script = section.settings.pedis_script %}{% assign hero_line1 = section.settings.pedis_line1 %}{% assign hero_line2 = section.settings.pedis_line2 %}{% assign hero_description = section.settings.pedis_description %}{% assign hero_button = section.settings.pedis_button %}{% assign hero_description2 = '' %}{% when 'bundles' %}{% assign hero_script = section.settings.bundles_script %}{% assign hero_line1 = section.settings.bundles_line1 %}{% assign hero_line2 = section.settings.bundles_line2 %}{% assign hero_description = section.settings.bundles_description %}{% assign hero_button = section.settings.bundles_button %}{% assign hero_description2 = '' %}{% when 'accessories' %}{% assign hero_script = section.settings.accessories_script %}{% assign hero_line1 = section.settings.accessories_line1 %}{% assign hero_line2 = section.settings.accessories_line2 %}{% assign hero_description = section.settings.accessories_description %}{% assign hero_button = section.settings.accessories_button %}{% assign hero_description2 = '' %}{% endcase %}{% if collection.handle == 'kids' %}{% render 'kids-content' %}{% else %}
    <section class="shop-hero" aria-labelledby="shop-hero-title">
      <img class="shop-hero-background" src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'hero-expanded.png' | asset_url }}{% endif %}" alt="Salon quality press-on nails and pink satin ribbon" width="1881" height="836">
      <div class="shop-hero-container">
        <div class="shop-hero-copy">
          <p class="shop-script">{{ hero_script | escape }}</p>
          <h1 id="shop-hero-title">{{ hero_line1 | escape }}<br>{{ hero_line2 | escape }}</h1>
          <p class="shop-description">{{ hero_description | escape }}{% if hero_description2 != blank %}<br>{{ hero_description2 | escape }}{% endif %}</p>
          <a class="shop-primary" href="{{ section.settings.copy_6 | escape }}">{{ hero_button | escape }} <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/><path d="M5 16h14M7 22h10"/></svg></a>
        </div>
      </div>
    </section>

    <div class="content-container shop-all-content">
      <nav class="shop-categories" aria-label="Shop categories">
        <a class="{% if collection.handle == 'all' or collection.handle == 'nails' %}active{% endif %}" href="{{ routes.all_products_collection_url }}" data-category="all"><span class="kids-glyph" data-kids-icon="nails" aria-hidden="true"></span><span>{{ section.settings.copy_8 | escape }}</span></a>
        <a class="{% if collection.handle == 'kids' %}active{% endif %}" href="{{ routes.collections_url }}/kids" data-category="kids"><span class="kids-glyph" data-kids-icon="kids" aria-hidden="true"></span><span>{{ section.settings.copy_9 | escape }}</span></a>
        <a class="{% if collection.handle == 'bundles' %}active{% endif %}" href="{{ routes.collections_url }}/bundles" data-category="bundles"><span class="kids-glyph" data-kids-icon="gift" aria-hidden="true"></span><span>{{ section.settings.copy_10 | escape }}</span></a>
        <a class="{% if collection.handle == 'pedis' %}active{% endif %}" href="{{ routes.collections_url }}/pedis" data-category="pedis"><span class="kids-glyph" data-kids-icon="feet" aria-hidden="true"></span><span>{{ section.settings.copy_11 | escape }}</span></a>
        <a class="{% if collection.handle == 'accessories' %}active{% endif %}" href="{{ routes.collections_url }}/accessories" data-category="accessories"><span class="kids-glyph" data-kids-icon="bagHeart" aria-hidden="true"></span><span>{{ section.settings.copy_12 | escape }}</span></a>
      </nav>

      <section class="shop-filter-bar" aria-label="Filter products">
        <div class="shop-chips" role="tablist" aria-label="Product categories">{% assign filter_setting = collection.handle | append: '_filters' %}{% assign category_filters = section.settings[filter_setting] %}{% if category_filters != blank %}{% assign filters = category_filters | split: ',' %}{% for filter in filters %}{% assign parts = filter | split: '|' %}<a class="shop-chip {% if current_tags contains parts[0] %}active{% elsif current_tags == blank and forloop.first %}active{% endif %}" href="{{ collection.url }}{% unless forloop.first %}/{{ parts[0] | handleize }}{% endunless %}">{{ parts[1] | escape }}</a>{% endfor %}{% else %}
          <a class="shop-chip {% if current_tags contains 'all' %}active{% elsif current_tags == blank and 'all' == 'all' %}active{% endif %}" href="{{ collection.url }}">{{ section.settings.copy_13 | escape }}</a>
          <a class="shop-chip {% if current_tags contains 'new-arrivals' %}active{% elsif current_tags == blank and 'new-arrivals' == 'all' %}active{% endif %}" href="{{ collection.url }}/new-arrivals">{{ section.settings.copy_14 | escape }}</a>
          <a class="shop-chip {% if current_tags contains 'best-sellers' %}active{% elsif current_tags == blank and 'best-sellers' == 'all' %}active{% endif %}" href="{{ collection.url }}/best-sellers">{{ section.settings.copy_15 | escape }}</a>
          <a class="shop-chip {% if current_tags contains 'kids' %}active{% elsif current_tags == blank and 'kids' == 'all' %}active{% endif %}" href="{{ collection.url }}/kids">{{ section.settings.copy_16 | escape }}</a>
          <a class="shop-chip {% if current_tags contains 'pedis' %}active{% elsif current_tags == blank and 'pedis' == 'all' %}active{% endif %}" href="{{ collection.url }}/pedis">{{ section.settings.copy_17 | escape }}</a>
          <a class="shop-chip {% if current_tags contains 'bundles' %}active{% elsif current_tags == blank and 'bundles' == 'all' %}active{% endif %}" href="{{ collection.url }}/bundles">{{ section.settings.copy_18 | escape }}</a>
          <a class="shop-chip {% if current_tags contains 'accessories' %}active{% elsif current_tags == blank and 'accessories' == 'all' %}active{% endif %}" href="{{ collection.url }}/accessories">{{ section.settings.copy_19 | escape }}</a>
        {% endif %}</div>
        <div class="shop-status-text" aria-live="polite">
          {{ section.settings.copy_20 | escape }} <strong id="product-count">{{ collection.products_count }}</strong> {{ section.settings.copy_21 | escape }}
        </div>
      </section>

      {% if section.settings.show_advanced_filters %}{% render 'collection-controls', results: collection %}{% endif %}{% paginate collection.products by section.settings.products_per_page %}<section class="shop-grid" id="shop-all-grid" aria-label="Product list">{% for product in collection.products %}{% render 'catalog-card', product: product, kind: 'shop' %}{% else %}<p>{{ section.settings.empty_text }}</p>{% endfor %}</section>{{ paginate | default_pagination }}{% endpaginate %}

      <section class="shop-benefits" aria-label="Customer benefits">
        <div><i>♧</i><p><b>{{ section.settings.copy_22 | escape }}</b><span>{{ section.settings.copy_23 | escape }}</span></p></div>
        <div><i>♢</i><p><b>{{ section.settings.copy_24 | escape }}</b><span>{{ section.settings.copy_25 | escape }}</span></p></div>
        <div><i>◷</i><p><b>{{ section.settings.copy_26 | escape }}</b><span>{{ section.settings.copy_27 | escape }}</span></p></div>
        <div><i>♡</i><p><b>{{ section.settings.copy_28 | escape }}</b><span>{{ section.settings.copy_29 | escape }}</span></p></div>
      </section>

      <section class="shop-promo-banner" aria-label="Shop promo">
        <img class="promo-emblem" src="{% if section.settings.art_2 != blank %}{{ section.settings.art_2 | image_url: width: 2000 }}{% else %}{{ 'heart-hq.png' | asset_url }}{% endif %}" alt="Golden crowned heart" width="1254" height="1254">
        <div class="shop-promo-copy">
          <h3>{{ section.settings.copy_30 | escape }}</h3>
          <h2>{{ section.settings.copy_31 | escape }}</h2>
          <p>{{ section.settings.copy_32 | escape }}</p>
        </div>
        <div class="shop-promo-action">
          <a class="shop-promo-btn" href="{{ section.settings.copy_33 | escape }}">
            {{ section.settings.copy_34 | escape }} <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/><path d="M5 16h14M7 22h10"/></svg>
          </a>
        </div>
      </section>

      <section id="social" class="social" aria-labelledby="instagram-heading">
        <h2 id="instagram-heading">{{ section.settings.copy_35 | escape }} <a href="{{ section.settings.copy_36 | escape }}" target="_blank" rel="noopener noreferrer">{{ section.settings.copy_37 | escape }}</a> <span>♡</span></h2>
        <div id="social-grid" role="list" aria-label="Demo Instagram feed">
          <a class="instagram-card" href="{{ section.settings.copy_38 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_3 != blank %}{{ section.settings.art_3 | image_url: width: 2000 }}{% else %}{{ 'social-0.png' | asset_url }}{% endif %}" alt="Press By Heart Instagram look 1" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_39 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_4 != blank %}{{ section.settings.art_4 | image_url: width: 2000 }}{% else %}{{ 'social-1.png' | asset_url }}{% endif %}" alt="Press By Heart Instagram look 2" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_40 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_5 != blank %}{{ section.settings.art_5 | image_url: width: 2000 }}{% else %}{{ 'social-2.png' | asset_url }}{% endif %}" alt="Press By Heart Instagram look 3" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_41 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_6 != blank %}{{ section.settings.art_6 | image_url: width: 2000 }}{% else %}{{ 'social-3.png' | asset_url }}{% endif %}" alt="Press By Heart Instagram look 4" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_42 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_7 != blank %}{{ section.settings.art_7 | image_url: width: 2000 }}{% else %}{{ 'social-4.png' | asset_url }}{% endif %}" alt="Press By Heart Instagram look 5" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_43 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_8 != blank %}{{ section.settings.art_8 | image_url: width: 2000 }}{% else %}{{ 'social-5.png' | asset_url }}{% endif %}" alt="Press By Heart Instagram look 6" loading="lazy" width="129" height="81"></a>
        </div>
      </section>
    </div>
  

{% endif %}
