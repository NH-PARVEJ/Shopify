<div class="content-container">
<section class="features" id="features">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <article class="feature" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="200" height="99">
        {%- else -%}
          {%- assign default_idx = forloop.index0 | modulo: 4 -%}
          <img src="{{ 'feature-' | append: default_idx | append: '.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="200" height="99">
        {%- endif -%}
        <div class="feature-content">
          <h2>{{ block.settings.title }}</h2>
          <p>{{ block.settings.description }}</p>
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            {{ block.settings.button_text | default: 'SHOP NOW' }} <span>→</span>
          </a>
        </div>
      </article>
    {%- endfor -%}
  {%- else -%}
    {% comment %} Default Approved Prototype Promo Features {% endcomment %}
    <article class="feature">
      <img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'feature-0.png' | asset_url }}{% endif %}" alt="NEW ARRIVALS" loading="lazy" width="200" height="99">
      <div class="feature-content">
        <h2>{{ section.settings.copy_1 | escape }}</h2>
        <p>{{ section.settings.copy_2 | escape }}</p>
        <a href="{{ routes.all_products_collection_url }}?filter=new-arrivals">{{ section.settings.copy_3 | escape }} <span>→</span></a>
      </div>
    </article>
    <article class="feature">
      <img src="{% if section.settings.art_2 != blank %}{{ section.settings.art_2 | image_url: width: 2000 }}{% else %}{{ 'feature-1.png' | asset_url }}{% endif %}" alt="KIDS COLLECTION" loading="lazy" width="200" height="99">
      <div class="feature-content">
        <h2>{{ section.settings.copy_4 | escape }}</h2>
        <p>{{ section.settings.copy_5 | escape }}<br>{{ section.settings.copy_6 | escape }}</p>
        <a href="{{ routes.collections_url }}/kids">{{ section.settings.copy_7 | escape }} <span>→</span></a>
      </div>
    </article>
    <article class="feature">
      <img src="{% if section.settings.art_3 != blank %}{{ section.settings.art_3 | image_url: width: 2000 }}{% else %}{{ 'feature-2.png' | asset_url }}{% endif %}" alt="BUNDLES &amp; SAVE" loading="lazy" width="200" height="99">
      <div class="feature-content">
        <h2>{{ section.settings.copy_8 | escape }}</h2>
        <p>{{ section.settings.copy_9 | escape }}<br>{{ section.settings.copy_10 | escape }}</p>
        <a href="{{ routes.collections_url }}/bundles">{{ section.settings.copy_11 | escape }} <span>→</span></a>
      </div>
    </article>
    <article class="feature">
      <img src="{% if section.settings.art_4 != blank %}{{ section.settings.art_4 | image_url: width: 2000 }}{% else %}{{ 'feature-3.png' | asset_url }}{% endif %}" alt="ACCESSORIES" loading="lazy" width="200" height="99">
      <div class="feature-content">
        <h2>{{ section.settings.copy_12 | escape }}</h2>
        <p>{{ section.settings.copy_13 | escape }}<br>{{ section.settings.copy_14 | escape }}<br>{{ section.settings.copy_15 | escape }}</p>
        <a href="{{ routes.collections_url }}/accessories">{{ section.settings.copy_16 | escape }} <span>→</span></a>
      </div>
    </article>
  {%- endif -%}
</section>
</div>


