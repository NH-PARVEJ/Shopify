              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="red"><span class="chip-dot" style="background:#eb3b5a;"></span>{{ section.settings.copy_37 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="gems"><img class="chip-dot" src="{% if section.settings.art_2 != blank %}{{ section.settings.art_2 | image_url: width: 2000 }}{% else %}{{ 'swatch-gems.png' | asset_url }}{% endif %}" alt="" style="object-fit:cover;" width="24" height="24">{{ section.settings.copy_38 | escape }}</button>
