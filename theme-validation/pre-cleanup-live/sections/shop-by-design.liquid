          <h3 class="sbd-customizer-title">{{ section.settings.copy_13 | escape }}</h3>
          <button id="sbd-reset-btn" class="sbd-reset-btn" type="button">{{ section.settings.copy_14 | escape }}</button>
        </div>

        <div class="sbd-filters-row">
          <!-- Shape Group -->
          <div class="sbd-filter-group">
            <h4>{{ section.settings.copy_15 | escape }}</h4>
            <div class="sbd-filter-options">
              <button class="sbd-chip active" type="button" data-filter-type="shape" data-filter-value="all">{{ section.settings.copy_16 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="shape" data-filter-value="almond">{{ section.settings.copy_17 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="shape" data-filter-value="square">{{ section.settings.copy_18 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="shape" data-filter-value="oval">{{ section.settings.copy_19 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="shape" data-filter-value="coffin">{{ section.settings.copy_20 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="shape" data-filter-value="ballerina">{{ section.settings.copy_21 | escape }}</button>
            </div>
          </div>

          <!-- Length Group -->
          <div class="sbd-filter-group">
            <h4>{{ section.settings.copy_22 | escape }}</h4>
            <div class="sbd-filter-options">
              <button class="sbd-chip active" type="button" data-filter-type="length" data-filter-value="all">{{ section.settings.copy_23 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="length" data-filter-value="short">{{ section.settings.copy_24 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="length" data-filter-value="medium">{{ section.settings.copy_25 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="length" data-filter-value="long">{{ section.settings.copy_26 | escape }}</button>
            </div>
          </div>

          <!-- Colour Group -->
          <div class="sbd-filter-group">
            <h4>{{ section.settings.copy_27 | escape }}</h4>
            <div class="sbd-filter-options">
              <button class="sbd-chip active" type="button" data-filter-type="colour" data-filter-value="all">{{ section.settings.copy_28 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="pink"><span class="chip-dot" style="background:#ff7aa5;"></span>{{ section.settings.copy_29 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="white"><span class="chip-dot" style="background:#ffffff;border:1rem solid #ddd;"></span>{{ section.settings.copy_30 | escape }}</button>
