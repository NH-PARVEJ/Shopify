              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="black"><span class="chip-dot" style="background:#1a1a1a;"></span>{{ section.settings.copy_32 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="orange"><span class="chip-dot" style="background:#ff9f43;"></span>{{ section.settings.copy_33 | escape }}</button>
              <button class="sbd-chip" type="button" data-filter-type="colour" data-filter-value="yellow"><span class="chip-dot" style="background:#ffd32a;"></span>{{ section.settings.copy_34 | escape }}</button>
