      <nav class="design-categories" aria-label="Shop categories">
        <a href="{{ routes.all_products_collection_url }}" data-category="nails"><span class="kids-glyph" data-kids-icon="nails" aria-hidden="true"></span><span>{{ section.settings.copy_8 | escape }}</span></a>
        <a href="{{ routes.collections_url }}/kids" data-category="kids"><span class="kids-glyph" data-kids-icon="kids" aria-hidden="true"></span><span>{{ section.settings.copy_9 | escape }}</span></a>
        <a href="{{ routes.collections_url }}/bundles" data-category="bundles"><span class="kids-glyph" data-kids-icon="gift" aria-hidden="true"></span><span>{{ section.settings.copy_10 | escape }}</span></a>
        <a href="{{ routes.collections_url }}/pedis" data-category="pedis"><span class="kids-glyph" data-kids-icon="feet" aria-hidden="true"></span><span>{{ section.settings.copy_11 | escape }}</span></a>
        <a href="{{ routes.collections_url }}/accessories" data-category="accessories"><span class="kids-glyph" data-kids-icon="bagHeart" aria-hidden="true"></span><span>{{ section.settings.copy_12 | escape }}</span></a>
      </nav>

      <!-- Interactive Design Customizer Filters -->
      <section class="sbd-customizer" aria-label="Customize designs">
