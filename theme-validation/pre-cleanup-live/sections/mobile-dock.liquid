<nav class="mobile-app-dock" aria-label="Mobile application bottom navigation" style="margin: 0px !important; margin-left: 0px !important; margin-right: 0px !important; left: 0px !important; right: 0px !important; width: 100% !important;">
  <a href="{{ routes.root_url }}" class="app-tab {% if template.name == 'index' %}active{% endif %}">
    <span class="app-tab-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>
    </span>
    <span class="app-tab-label">{{ section.settings.copy_1 | escape }}</span>
  </a>
  <a href="{{ routes.all_products_collection_url }}" class="app-tab {% if template.name == 'collection' and collection.handle != 'kids' %}active{% endif %}">
    <span class="app-tab-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
    </span>
    <span class="app-tab-label">{{ section.settings.copy_2 | escape }}</span>
  </a>
  <a href="{{ routes.root_url }}pages/shop-by-design" class="app-tab {% if template.suffix == 'shop-by-design' %}active{% endif %}">
    <span class="app-tab-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
    </span>
    <span class="app-tab-label">{{ section.settings.copy_3 | escape }}</span>
  </a>
  <a href="{{ routes.collections_url }}/kids" class="app-tab {% if collection.handle == 'kids' %}active{% endif %}">
    <span class="app-tab-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 7 4 5 5-8 5 8 4-5-2 13H5L3 7Z"/><path d="M5 16h14"/></svg>
    </span>
    <span class="app-tab-label">{{ section.settings.copy_4 | escape }}</span>
  </a>
  <a href="#bag" class="app-tab app-tab-bag" id="mobile-dock-bag-btn">
    <span class="app-tab-icon app-tab-bag-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 14H4Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
      <span class="app-tab-badge" id="mobile-dock-badge">{{ cart.item_count | default: 0 }}</span>
    </span>
    <span class="app-tab-label">{{ section.settings.copy_5 | escape }}</span>
  </a>
</nav>

