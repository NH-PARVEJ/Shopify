<div class="content-container">
<section class="benefits" data-section-id="{{ section.id }}" aria-label="Customer benefits">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <i>{{ block.settings.icon | default: '♡' }}</i>
        <p>
          <b>{{ block.settings.title }}</b>
          <span>{{ block.settings.subtitle }}</span>
        </p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div><i>♧</i><p><b>{{ section.settings.item_1_title | default: 'REUSABLE & DURABLE' }}</b><span>{{ section.settings.item_1_sub | default: 'Wear again & again' }}</span></p></div>
    <div><i>♢</i><p><b>{{ section.settings.item_2_title | default: 'SALON QUALITY' }}</b><span>{{ section.settings.item_2_sub | default: 'Premium finish' }}</span></p></div>
    <div><i>◷</i><p><b>{{ section.settings.item_3_title | default: 'QUICK & EASY' }}</b><span>{{ section.settings.item_3_sub | default: 'Apply in minutes' }}</span></p></div>
    <div><i>♡</i><p><b>{{ section.settings.item_4_title | default: 'CRUELTY FREE' }}</b><span>{{ section.settings.item_4_sub | default: 'Made with love' }}</span></p></div>
  {%- endif -%}
</section>
</div>


{% schema %}{
  "name": "Benefits Bar",
  "settings": [
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Benefit 1 Title",
      "default": "REUSABLE & DURABLE"
    },
    {
      "type": "text",
      "id": "item_1_sub",
      "label": "Benefit 1 Subtitle",
      "default": "Wear again & again"
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Benefit 2 Title",
      "default": "SALON QUALITY"
    },
    {
      "type": "text",
      "id": "item_2_sub",
      "label": "Benefit 2 Subtitle",
      "default": "Premium finish"
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Benefit 3 Title",
      "default": "QUICK & EASY"
    },
    {
      "type": "text",
      "id": "item_3_sub",
      "label": "Benefit 3 Subtitle",
      "default": "Apply in minutes"
    },
    {
      "type": "text",
      "id": "item_4_title",
      "label": "Benefit 4 Title",
      "default": "CRUELTY FREE"
    },
    {
      "type": "text",
      "id": "item_4_sub",
      "label": "Benefit 4 Subtitle",
      "default": "Made with love"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Symbol (e.g. ♧, ♢, ◷, ♡)",
          "default": "♡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SALON QUALITY"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Premium finish"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Bar"
    }
  ]
}{% endschema %}
