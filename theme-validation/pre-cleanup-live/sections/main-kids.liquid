
<section class="kids-hero" aria-labelledby="kids-title">
 <img class="kids-hero-background" src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'kids-hero-natural-hand.png' | asset_url }}{% endif %}" alt="Pink daisy and heart nail designs on soft pink satin" width="2025" height="777">
 <div class="kids-hero-container">
  <div class="kids-hero-copy"><p class="kids-script">{{ section.settings.copy_1 | escape }}</p><h1 id="kids-title">{{ section.settings.copy_2 | escape }}<br>{{ section.settings.copy_3 | escape }}</h1><p class="kids-description">{{ section.settings.copy_4 | escape }}<br>{{ section.settings.copy_5 | escape }}</p><a class="kids-primary" href="{{ section.settings.copy_6 | escape }}">{{ section.settings.copy_7 | escape }} <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/><path d="M5 16h14M7 22h10"/></svg></a></div>
 </div>
</section>
<div class="content-container kids-content">
 <nav class="kids-categories" aria-label="Shop categories"><a href="{{ routes.all_products_collection_url }}"><span class="kids-glyph" data-kids-icon="nails" aria-hidden="true"></span><span>{{ section.settings.copy_8 | escape }}</span></a><a class="active" href="{{ section.settings.copy_9 | escape }}" aria-current="page"><span class="kids-glyph" data-kids-icon="kids" aria-hidden="true"></span><span>{{ section.settings.copy_10 | escape }}</span></a><a href="{{ routes.collections_url }}/bundles"><span class="kids-glyph" data-kids-icon="gift" aria-hidden="true"></span><span>{{ section.settings.copy_11 | escape }}</span></a><a href="{{ routes.collections_url }}/pedis"><span class="kids-glyph" data-kids-icon="feet" aria-hidden="true"></span><span>{{ section.settings.copy_12 | escape }}</span></a><a href="{{ routes.collections_url }}/accessories"><span class="kids-glyph" data-kids-icon="bagHeart" aria-hidden="true"></span><span>{{ section.settings.copy_13 | escape }}</span></a></nav>
 <section class="kids-collection" id="kids-collection" aria-labelledby="kids-collection-title"><div class="kids-section-heading"><h2 id="kids-collection-title">{{ section.settings.copy_14 | escape }} <span>💕</span></h2><a href="{{ section.settings.copy_15 | escape }}" data-filter="all">{{ section.settings.copy_16 | escape }} <span class="kids-glyph" data-kids-icon="chevron" aria-hidden="true"></span></a></div>{% paginate collection.products by 20 %}<div class="kids-products">{% for product in collection.products %}{% render 'catalog-card', product: product, kind: 'kids' %}{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}<p class="sr-only" id="kids-filter-status" aria-live="polite"></p></section>
 <section class="kids-benefits" aria-label="Kids collection benefits"><div><span class="kids-glyph" data-kids-icon="shield" aria-hidden="true"></span><p><strong>{{ section.settings.copy_17 | escape }}</strong><span>{{ section.settings.copy_18 | escape }}</span></p></div><div><span class="kids-glyph" data-kids-icon="apply" aria-hidden="true"></span><p><strong>{{ section.settings.copy_19 | escape }}</strong><span>{{ section.settings.copy_20 | escape }}</span></p></div><div><span class="kids-glyph" data-kids-icon="heart" aria-hidden="true"></span><p><strong>{{ section.settings.copy_21 | escape }}</strong><span>{{ section.settings.copy_22 | escape }}</span></p></div><div><span class="kids-glyph" data-kids-icon="reuse" aria-hidden="true"></span><p><strong>{{ section.settings.copy_23 | escape }}</strong><span>{{ section.settings.copy_24 | escape }}</span></p></div></section>
 <section class="kids-promo" aria-label="Quick press, instant happiness"><img class="kids-promo-heart" src="{% if section.settings.art_2 != blank %}{{ section.settings.art_2 | image_url: width: 2000 }}{% else %}{{ 'heart-hq.png' | asset_url }}{% endif %}" alt="Golden crowned heart" width="1254" height="1254"><h2>{{ section.settings.copy_25 | escape }}<br>{{ section.settings.copy_26 | escape }}</h2><div><p>{{ section.settings.copy_27 | escape }}<br>{{ section.settings.copy_28 | escape }}</p><a class="kids-primary" href="{{ section.settings.copy_29 | escape }}">{{ section.settings.copy_30 | escape }} <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/><path d="M5 16h14M7 22h10"/></svg></a></div><img class="kids-promo-product" src="{% if section.settings.art_3 != blank %}{{ section.settings.art_3 | image_url: width: 2000 }}{% else %}{{ 'kids-promo-product.png' | asset_url }}{% endif %}" alt="Pink kids press-on nail gift set" loading="lazy" width="208" height="125"></section>
 <section class="kids-services" aria-label="Customer services"><div><span class="kids-glyph" data-kids-icon="truck" aria-hidden="true"></span><p><strong>{{ section.settings.copy_31 | escape }}</strong><span>{{ section.settings.copy_32 | escape }}</span></p></div><div><span class="kids-glyph" data-kids-icon="quality" aria-hidden="true"></span><p><strong>{{ section.settings.copy_33 | escape }}</strong><span>{{ section.settings.copy_34 | escape }}</span></p></div><div><span class="kids-glyph" data-kids-icon="bag" aria-hidden="true"></span><p><strong>{{ section.settings.copy_35 | escape }}</strong><span>{{ section.settings.copy_36 | escape }}</span></p></div><div><span class="kids-glyph" data-kids-icon="headset" aria-hidden="true"></span><p><strong>{{ section.settings.copy_37 | escape }}</strong><span>{{ section.settings.copy_38 | escape }}</span></p></div></section>
</div>

