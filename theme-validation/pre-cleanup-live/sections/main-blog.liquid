<div class="content-container" style="padding-top: 30px; padding-bottom: 60px;">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-family: 'Times New Roman', serif; font-size: clamp(28px, 4vw, 36px); margin-bottom: 8px;">
      {{ blog.title | default: 'The Heart Edit' }} <span style="color: #f93685; font-family: Allura, cursive; font-size: 1.2em;">♡</span>
    </h1>
    <p style="color: #666; font-size: 14px;">{{ section.settings.copy_1 | escape }}</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
    {%- for article in blog.articles -%}
      <article style="border: 1px solid #ffdeea; border-radius: 16px; overflow: hidden; background: #fff; display: flex; flex-direction: column;">
        {%- if article.image -%}
          <a href="{{ article.url }}">
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" style="width: 100%; height: 200px; object-fit: cover;" width="{{ article.image.width }}" height="{{ article.image.height }}">
          </a>
        {%- endif -%}
        <div style="padding: 20px; flex: 1; display: flex; flex-direction: column;">
          <time style="font-size: 11px; color: #f93685; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">
            {{ article.published_at | date: '%B %d, %Y' }}
          </time>
          <h2 style="font-family: 'Times New Roman', serif; font-size: 20px; margin: 0 0 10px 0; line-height: 1.3;">
            <a href="{{ article.url }}" style="color: #101010; text-decoration: none;">{{ article.title }}</a>
          </h2>
          <p style="color: #666; font-size: 13px; line-height: 1.5; margin-bottom: 16px; flex: 1;">
            {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
          </p>
          <a href="{{ article.url }}" style="font-size: 12px; font-weight: 600; color: #f93685; text-decoration: none;">
            {{ section.settings.copy_2 | escape }}
          </a>
        </div>
      </article>
    {%- else -%}
      <p style="grid-column: 1 / -1; text-align: center; color: #888; padding: 40px 0;">{{ section.settings.copy_3 | escape }}</p>
    {%- endfor -%}
  </div>
</div>


{% schema %}{
  "name": "Blog Posts",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Publication Date",
      "default": true
    },
    {
      "type": "text",
      "id": "copy_1",
      "label": "Copy: Press-on tutorials, styling tips & nail trends",
      "default": "Press-on tutorials, styling tips & nail trends"
    },
    {
      "type": "text",
      "id": "copy_2",
      "label": "Copy: READ ARTICLE →",
      "default": "READ ARTICLE →"
    },
    {
      "type": "text",
      "id": "copy_3",
      "label": "Copy: No articles published yet.",
      "default": "No articles published yet."
    }
  ]
}{% endschema %}
