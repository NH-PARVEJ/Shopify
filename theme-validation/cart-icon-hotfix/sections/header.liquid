<header id="site-header" class="site-header">
<button type="button" class="mobile-app-menu-btn" id="mobile-app-menu-btn" aria-label="Open menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {%- if section.settings.logo != blank -%}
      <img class="logo"
        src="{{ section.settings.logo | image_url: width: 300 }}"
        alt="{{ section.settings.logo.alt | default: shop.name }}"
        width="{{ section.settings.logo_width | default: 122 }}"
        height="42">
    {%- else -%}
      <img class="logo"
        src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'logo-hq-v2.png' | asset_url }}{% endif %}"
        alt="{{ shop.name }}"
        width="{{ section.settings.logo_width | default: 122 }}"
        height="42">
    {%- endif -%}
  </a>

  
  <nav aria-label="Main navigation">
    {%- assign nav_menu = linklists[section.settings.menu] | default: linklists[settings.main_menu] | default: linklists['main-menu'] -%}
    {%- if section.settings.use_custom_menu and nav_menu != blank and nav_menu.links.size > 0 -%}
      {%- for link in nav_menu.links -%}
        {%- assign down_title = link.title | downcase -%}
        {%- assign down_url = link.url | downcase -%}
        {%- if down_url contains 'shop-all' or down_title contains 'shop all' or link.handle == 'shop-all' -%}
          <a class="shop-all-menu-toggle {% if link.active %}active{% endif %}" href="{{ link.url }}" aria-controls="shop-all-menu" aria-expanded="false">
            {{ link.title }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
          </a>
        {%- elsif down_url contains 'shop-by-design' or down_title contains 'design' or link.handle contains 'design' -%}
          <a class="shop-by-design-menu-toggle {% if link.active %}active{% endif %}" href="{{ link.url }}" aria-controls="shop-by-design-menu" aria-expanded="false">
            {{ link.title }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
          </a>
        {%- elsif down_url contains 'kids' or down_title contains 'kid' or link.handle == 'kids' -%}
          <a class="kids-menu-toggle {% if link.active %}active{% endif %}" href="{{ link.url }}" aria-controls="kids-menu" aria-expanded="false">
            {{ link.title }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
          </a>
        {%- elsif link.links.size > 0 -%}
          <div class="nav-dropdown-item" style="position: relative; display: inline-flex; align-items: center;">
            <a class="nav-dropdown-trigger {% if link.active or link.child_active %}active{% endif %}" href="{{ link.url }}">
              {{ link.title }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </a>
            <div class="nav-dropdown-menu" style="display: none; position: absolute; top: 100%; left: 0; min-width: 170px; background: #ffffff; border: 1px solid #f1dde4; border-radius: 8px; box-shadow: 0 8px 24px rgba(108, 36, 50, 0.12); padding: 8px 0; z-index: 1000;">
              {%- for child_link in link.links -%}
                <a href="{{ child_link.url }}" style="display: block; padding: 8px 16px; font-size: 11px; color: #4a1520; text-decoration: none; border-bottom: none; transition: background 0.15s ease;" onmouseover="this.style.background='#fff2f6';this.style.color='#fa4087'" onmouseout="this.style.background='transparent';this.style.color='#4a1520'">{{ child_link.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          {%- assign is_link_active = false -%}
          {%- if link.active or link.current -%}
            {%- assign is_link_active = true -%}
          {%- elsif forloop.first and template.name == 'index' -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
          <a class="{% if is_link_active %}active{% endif %}" href="{{ link.url }}">
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <a class="{% if template.name == 'index' %}active{% endif %}" href="{{ routes.root_url }}">{{ section.settings.copy_1 | default: 'HOME' | escape }}</a>
      <a class="shop-all-menu-toggle" href="{{ routes.all_products_collection_url }}" aria-controls="shop-all-menu" aria-expanded="false">
        {{ section.settings.copy_2 | default: 'SHOP ALL' | escape }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
      </a>
      <a class="shop-by-design-menu-toggle" href="{{ routes.root_url }}pages/shop-by-design" aria-controls="shop-by-design-menu" aria-expanded="false">
        {{ section.settings.copy_3 | default: 'SHOP BY DESIGN' | escape }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
      </a>
      <a class="kids-menu-toggle" href="{{ routes.collections_url }}/kids" aria-controls="kids-menu" aria-expanded="false">
        {{ section.settings.copy_4 | default: 'KIDS' | escape }}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
      </a>
      <a href="{{ routes.collections_url }}/pedis">{{ section.settings.copy_5 | default: 'PEDIS' | escape }}</a>
      <a href="{{ routes.collections_url }}/bundles">{{ section.settings.copy_6 | default: 'BUNDLES' | escape }}</a>
      <a href="{{ routes.collections_url }}/accessories">{{ section.settings.copy_7 | default: 'ACCESSORIES' | escape }}</a>
    {%- endif -%}
  </nav>

  <a id="press-heart-cart" class="nav-bag" href="{{ routes.cart_url }}" data-cart-trigger aria-label="{{ 'sections.cart.title' | t }}"><img class="press-heart-cart-art" src="{{ 'press-heart-bag.svg' | asset_url }}" alt="" width="24" height="24"><span class="bag-count press-heart-cart-count" aria-hidden="true">{{ cart.item_count }}</span></a>

  <a class="book" href="tel:{{ section.settings.booking_phone | default: '07944545406' }}">
    {{ section.settings.booking_button_text | default: 'BOOK NOW' }}
    <svg class="icon crown-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m3 6 4 5 5-8 5 8 4-5-2 13H5L3 6Z"/>
      <path d="M5 16h14M7 22h10"/>
    </svg>
  </a>

  {% render 'mega-menu-kids' %}
  {% render 'mega-menu-shop-all' %}
  {% render 'mega-menu-shop-by-design' %}
</header>



<style>
#press-heart-cart.nav-bag{position:relative!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;box-sizing:border-box!important;flex:0 0 38px!important;width:38px!important;height:38px!important;min-width:38px!important;max-width:38px!important;min-height:38px!important;max-height:38px!important;margin:0!important;padding:0!important;background:#fff5f8!important;border:1px solid #ffd3e2!important;border-radius:50%!important;color:#f93685!important;line-height:1!important;text-decoration:none!important;box-shadow:none!important;overflow:visible!important;transition:background .2s ease,border-color .2s ease!important}
#press-heart-cart.nav-bag:hover{background:#ffeaf1!important;border-color:#f93685!important;transform:none!important}
#press-heart-cart.nav-bag:focus-visible{outline:2px solid #f93685;outline-offset:3px}
#press-heart-cart .press-heart-cart-art{display:block!important;position:static!important;width:24px!important;height:24px!important;min-width:24px!important;max-width:24px!important;min-height:24px!important;max-height:24px!important;margin:0!important;padding:0!important;border:0!important;object-fit:contain!important;background:none!important;pointer-events:none!important}
#press-heart-cart .press-heart-cart-count{position:absolute!important;display:flex!important;align-items:center!important;justify-content:center!important;box-sizing:border-box!important;top:-4px!important;right:-4px!important;bottom:auto!important;left:auto!important;min-width:16px!important;width:auto!important;height:16px!important;min-height:16px!important;max-height:16px!important;margin:0!important;padding:0 4px!important;border:2px solid #fff!important;border-radius:20px!important;background:#f93685!important;color:#fff!important;font-family:Poppins,Arial,sans-serif!important;font-size:9px!important;font-weight:600!important;line-height:1!important;box-shadow:none!important;transform:none!important;pointer-events:none!important}
@media(max-width:700px){#press-heart-cart.nav-bag{flex-basis:34px!important;width:34px!important;height:34px!important;min-width:34px!important;max-width:34px!important;min-height:34px!important;max-height:34px!important}#press-heart-cart .press-heart-cart-art{width:22px!important;height:22px!important;min-width:22px!important;max-width:22px!important;min-height:22px!important;max-height:22px!important}}
</style>
