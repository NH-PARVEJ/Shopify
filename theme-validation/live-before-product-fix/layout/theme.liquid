<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary | default: '#f93685' }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% comment %} Social Meta Tags (Open Graph & Twitter) {% endcomment %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
  {%- if page_image -%}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- else -%}
    <meta property="og:image" content="{{ 'hero-expanded.png' | asset_url }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  <meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">

  {% comment %} Bulletproof Font-Face Declarations {% endcomment %}
  <style>
    @font-face {
      font-family: 'Poppins';
      src: url('{{ "poppins-400.ttf" | asset_url }}') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Poppins';
      src: url('{{ "poppins-500.ttf" | asset_url }}') format('truetype');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Poppins';
      src: url('{{ "poppins-600.ttf" | asset_url }}') format('truetype');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Allura';
      src: url('{{ "allura.ttf" | asset_url }}') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    /* --- BULLETPROOF CRITICAL STYLES FOR PROMO CODE & REVIEW MODAL --- */
    #cart-sidebar-drawer .cart-promo-section,
    .cart-promo-section,
    .cart-promo-wrap {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    #cart-sidebar-drawer .cart-promo-input-wrap,
    #cart-sidebar-drawer .cart-promo-input-row,
    .cart-promo-input-wrap,
    .cart-promo-input-row {
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    #cart-sidebar-drawer input#cart-promo-input,
    #cart-sidebar-drawer .cart-promo-input,
    #cart-promo-input,
    input.cart-promo-input,
    .cart-promo-input {
      flex: 1 1 auto !important;
      min-width: 0 !important;
      width: 100% !important;
      height: 42px !important;
      padding: 0 14px !important;
      border: 1.5px solid #f1dde4 !important;
      border-radius: 8px !important;
      background: #ffffff !important;
      font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important;
      font-size: 13px !important;
      color: #4a1520 !important;
      outline: none !important;
      box-sizing: border-box !important;
      -webkit-appearance: none !important;
      appearance: none !important;
      box-shadow: none !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease !important;
    }
    #cart-sidebar-drawer input#cart-promo-input:focus,
    #cart-promo-input:focus,
    input.cart-promo-input:focus {
      border-color: #fa4087 !important;
      background-color: #fffbfa !important;
      box-shadow: 0 0 0 3px rgba(250, 64, 135, 0.16) !important;
    }
    #cart-sidebar-drawer input#cart-promo-input::placeholder,
    #cart-promo-input::placeholder,
    input.cart-promo-input::placeholder {
      color: #a8848d !important;
      font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important;
      font-size: 11.5px !important;
      opacity: 1 !important;
    }
    #cart-sidebar-drawer button#cart-promo-apply-btn,
    #cart-sidebar-drawer .cart-promo-btn,
    #cart-promo-apply-btn,
    button.cart-promo-btn,
    .cart-promo-btn {
      padding: 0 18px !important;
      height: 42px !important;
      min-height: 42px !important;
      background: #fdf0f4 !important;
      border: 1.5px solid #f1dde4 !important;
      border-radius: 8px !important;
      color: #fa4087 !important;
      font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important;
      font-size: 12px !important;
      font-weight: 700 !important;
      letter-spacing: 0.6px !important;
      cursor: pointer !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
      transition: all 0.2s ease !important;
      text-transform: uppercase !important;
      -webkit-appearance: none !important;
      appearance: none !important;
    }
    #cart-sidebar-drawer button#cart-promo-apply-btn:hover,
    #cart-promo-apply-btn:hover,
    .cart-promo-btn:hover {
      background: #fa4087 !important;
      border-color: #fa4087 !important;
      color: #ffffff !important;
    }

    /* Modal Overlay */
    #review-modal.pdp-modal {
      position: fixed !important;
      inset: 0 !important;
      background: rgba(30, 10, 18, 0.6) !important;
      backdrop-filter: blur(4px) !important;
      -webkit-backdrop-filter: blur(4px) !important;
      z-index: 999999 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 16px !important;
      opacity: 0 !important;
      pointer-events: none !important;
      visibility: hidden !important;
      transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.24s cubic-bezier(0.16, 1, 0.3, 1) !important;
      box-sizing: border-box !important;
    }
    #review-modal.pdp-modal.is-open {
      opacity: 1 !important;
      pointer-events: auto !important;
      visibility: visible !important;
    }
    #review-modal .pdp-review-modal-dialog,
    #review-modal .pdp-modal-dialog {
      background: #ffffff !important;
      border-radius: 16px !important;
      max-width: 480px !important;
      width: 100% !important;
      padding: 28px 24px !important;
      box-shadow: 0 20px 48px rgba(80, 20, 36, 0.22) !important;
      position: relative !important;
      max-height: 90vh !important;
      overflow-y: auto !important;
      box-sizing: border-box !important;
      border: 1.5px solid #fae2eb !important;
    }
    #review-modal .pdp-modal-close,
    #review-modal #close-review-form {
      position: absolute !important;
      top: 16px !important;
      right: 16px !important;
      width: 34px !important;
      height: 34px !important;
      border-radius: 50% !important;
      border: 1px solid #ffd2e2 !important;
      background: #fff0f5 !important;
      color: #fa4087 !important;
      font-size: 16px !important;
      cursor: pointer !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      line-height: 1 !important;
      transition: background 0.18s ease, transform 0.18s ease !important;
      padding: 0 !important;
    }
    #review-modal .pdp-modal-close:hover,
    #review-modal #close-review-form:hover {
      background: #ffe0ec !important;
      transform: scale(1.08) !important;
    }
    #review-modal .pdp-review-modal-header {
      margin-bottom: 18px !important;
      padding-right: 32px !important;
      text-align: left !important;
    }
    #review-modal .pdp-review-modal-header h3,
    #review-modal h3,
    #review-modal #review-form-title {
      font-family: Georgia, 'Times New Roman', serif !important;
      font-size: 22px !important;
      color: #1a1a1a !important;
      margin: 0 0 6px 0 !important;
      font-weight: 700 !important;
      line-height: 1.25 !important;
    }
    #review-modal .pdp-review-modal-subtitle,
    #review-modal p.pdp-review-modal-subtitle {
      font-family: Poppins, Arial, sans-serif !important;
      font-size: 13px !important;
      color: #7a6e74 !important;
      margin: 0 !important;
      line-height: 1.4 !important;
    }
    #review-modal form,
    #review-modal .pdp-review-form,
    #review-modal #product-review-form,
    #review-modal .pdp-review-form-inner {
      display: flex !important;
      flex-direction: column !important;
      gap: 14px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    #review-modal .pdp-review-rating-picker {
      display: flex !important;
      flex-direction: column !important;
      gap: 6px !important;
      text-align: left !important;
      margin-bottom: 2px !important;
    }
    #review-modal .pdp-star-rating-select {
      display: flex !important;
      flex-direction: row-reverse !important;
      justify-content: flex-end !important;
      gap: 4px !important;
    }
    #review-modal .pdp-star-btn {
      background: none !important;
      border: none !important;
      padding: 0 2px !important;
      font-size: 26px !important;
      color: #fa4087 !important;
      cursor: pointer !important;
      line-height: 1 !important;
      transition: transform 0.15s ease, color 0.15s ease !important;
      -webkit-tap-highlight-color: transparent !important;
    }
    #review-modal .pdp-form-field,
    #review-modal label {
      display: flex !important;
      flex-direction: column !important;
      gap: 5px !important;
      width: 100% !important;
      text-align: left !important;
      box-sizing: border-box !important;
    }
    #review-modal .pdp-field-label {
      font-family: Poppins, Arial, sans-serif !important;
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #2c2126 !important;
      display: flex !important;
      align-items: center !important;
      gap: 4px !important;
      margin: 0 !important;
    }
    #review-modal .pdp-field-label .required {
      color: #fa4087 !important;
      font-weight: 700 !important;
    }
    #review-modal .pdp-field-hint {
      font-family: Poppins, Arial, sans-serif !important;
      font-size: 11px !important;
      color: #92838a !important;
      margin-top: 2px !important;
      line-height: 1.3 !important;
    }
    #review-modal input:not([type="hidden"]):not([type="submit"]):not([type="button"]),
    #review-modal .pdp-form-input,
    #review-modal input#review-author-name,
    #review-modal input#review-author-email {
      width: 100% !important;
      height: 42px !important;
      padding: 0 14px !important;
      border: 1.5px solid #f1dde4 !important;
      border-radius: 8px !important;
      background: #fffcfd !important;
      font-family: Poppins, Arial, sans-serif !important;
      font-size: 13.5px !important;
      color: #1a1a1a !important;
      outline: none !important;
      box-sizing: border-box !important;
      -webkit-appearance: none !important;
      appearance: none !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease !important;
    }
    #review-modal input:not([type="hidden"]):not([type="submit"]):not([type="button"]):focus,
    #review-modal .pdp-form-input:focus {
      border-color: #fa4087 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 3px rgba(250, 64, 135, 0.15) !important;
    }
    #review-modal textarea,
    #review-modal .pdp-form-textarea,
    #review-modal textarea#review-body-text {
      width: 100% !important;
      min-height: 96px !important;
      padding: 10px 14px !important;
      border: 1.5px solid #f1dde4 !important;
      border-radius: 8px !important;
      background: #fffcfd !important;
      font-family: Poppins, Arial, sans-serif !important;
      font-size: 13.5px !important;
      color: #1a1a1a !important;
      outline: none !important;
      resize: vertical !important;
      box-sizing: border-box !important;
      line-height: 1.5 !important;
      -webkit-appearance: none !important;
      appearance: none !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease !important;
    }
    #review-modal textarea:focus,
    #review-modal .pdp-form-textarea:focus {
      border-color: #fa4087 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 3px rgba(250, 64, 135, 0.15) !important;
    }
    #review-modal button[type="submit"],
    #review-modal .pdp-review-submit-btn,
    #review-modal #pdp-submit-review,
    #review-modal .pdp-add-btn {
      width: 100% !important;
      height: 44px !important;
      min-height: 44px !important;
      background: linear-gradient(105deg, #fa4087, #f13d84) !important;
      color: #ffffff !important;
      border: none !important;
      border-radius: 8px !important;
      font-family: Poppins, Arial, sans-serif !important;
      font-size: 13.5px !important;
      font-weight: 700 !important;
      letter-spacing: 0.6px !important;
      cursor: pointer !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 4px 14px rgba(250, 64, 135, 0.28) !important;
      transition: all 0.2s ease !important;
      margin-top: 6px !important;
      box-sizing: border-box !important;
      text-transform: uppercase !important;
      -webkit-appearance: none !important;
      appearance: none !important;
    }
    #review-modal button[type="submit"]:hover,
    #review-modal .pdp-review-submit-btn:hover,
    #review-modal #pdp-submit-review:hover,
    #review-modal .pdp-add-btn:hover {
      background: #df2675 !important;
      transform: translateY(-1px) !important;
      box-shadow: 0 6px 18px rgba(223, 38, 117, 0.35) !important;
    }
    #review-modal button[type="submit"]:active,
    #review-modal .pdp-review-submit-btn:active,
    #review-modal #pdp-submit-review:active {
      transform: translateY(1px) !important;
    }
    @media (max-width: 480px) {
      #review-modal .pdp-review-modal-dialog,
      #review-modal .pdp-modal-dialog {
        padding: 22px 18px !important;
        border-radius: 14px !important;
        max-width: 92vw !important;
      }
    }
  </style>

  {% comment %} Stylesheets {% endcomment %}
  {{ 'style.css' | asset_url | stylesheet_tag }}
  {{ 'refinements.css' | asset_url | stylesheet_tag }}
  {% if template.name == 'collection' %}{% if collection.handle == 'kids' %}{{ 'kids.css' | asset_url | stylesheet_tag }}{% else %}{{ 'shop-all.css' | asset_url | stylesheet_tag }}{% endif %}{% elsif template.name == 'product' %}{{ 'product.css' | asset_url | stylesheet_tag }}{% elsif page.handle == 'shop-by-design' %}{{ 'shop-by-design.css' | asset_url | stylesheet_tag }}{% endif %}

  {% comment %} Shopify Required Header Hooks {% endcomment %}
  {{ content_for_header }}
  {% render 'theme-settings' %}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.ShopifyTheme = {
      routes: {
        root: "{{ routes.root_url }}",
        cart: "{{ routes.cart_url }}",
        cart_add_url: "{{ routes.cart_add_url }}",
        cart_change_url: "{{ routes.cart_change_url }}",
        cart_clear_url: "{{ routes.cart_clear_url }}",
        search_url: "{{ routes.search_url }}"
      },
      settings: {
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 30 }},
        standardShippingRate: {{ settings.standard_shipping_rate | default: 3.99 }},
        promoCodeDefault: {{ settings.promo_code_default | json }},
        promoDiscountPercent: {{ settings.promo_discount_percent | default: 10 }}
      },
      assetRoot: "{{ 'product-0.png' | asset_url | split: 'product-0.png' | first }}",
      assets: {
        'product-0.png': '{{ "product-0.png" | asset_url }}',
        'product-1.png': '{{ "product-1.png" | asset_url }}',
        'product-2.png': '{{ "product-2.png" | asset_url }}',
        'product-3.png': '{{ "product-3.png" | asset_url }}',
        'product-4.png': '{{ "product-4.png" | asset_url }}',
        'collection-0.png': '{{ "collection-0.png" | asset_url }}',
        'collection-1.png': '{{ "collection-1.png" | asset_url }}',
        'collection-2.png': '{{ "collection-2.png" | asset_url }}',
        'collection-3.png': '{{ "collection-3.png" | asset_url }}',
        'collection-4.png': '{{ "collection-4.png" | asset_url }}',
        'collection-5.png': '{{ "collection-5.png" | asset_url }}',
        'feature-0.png': '{{ "feature-0.png" | asset_url }}',
        'feature-1.png': '{{ "feature-1.png" | asset_url }}',
        'feature-2.png': '{{ "feature-2.png" | asset_url }}',
        'feature-3.png': '{{ "feature-3.png" | asset_url }}',
        'social-0.png': '{{ "social-0.png" | asset_url }}',
        'social-1.png': '{{ "social-1.png" | asset_url }}',
        'social-2.png': '{{ "social-2.png" | asset_url }}',
        'social-3.png': '{{ "social-3.png" | asset_url }}',
        'social-4.png': '{{ "social-4.png" | asset_url }}',
        'social-5.png': '{{ "social-5.png" | asset_url }}',
        'kids-product-0.png': '{{ "kids-product-0.png" | asset_url }}',
        'kids-product-1.png': '{{ "kids-product-1.png" | asset_url }}',
        'kids-product-2.png': '{{ "kids-product-2.png" | asset_url }}',
        'kids-product-3.png': '{{ "kids-product-3.png" | asset_url }}',
        'kids-product-4.png': '{{ "kids-product-4.png" | asset_url }}',
        'kids-hero-background.png': '{{ "kids-hero-background.png" | asset_url }}',
        'kids-hero-natural-hand.png': '{{ "kids-hero-natural-hand.png" | asset_url }}',
        'kids-promo-product.png': '{{ "kids-promo-product.png" | asset_url }}',
        'menu-product-hq.png': '{{ "menu-product-hq.png" | asset_url }}',
        'shop-all-menu-product.png': '{{ "shop-all-menu-product.png" | asset_url }}',
        'hero-expanded.png': '{{ "hero-expanded.png" | asset_url }}',
        'heart-hq.png': '{{ "heart-hq.png" | asset_url }}',
        'swatch-gems.png': '{{ "swatch-gems.png" | asset_url }}'
      },
      assetUrl: function(name) {
        if (!name) return '';
        if (name.indexOf('//') !== -1 || name.indexOf('http') === 0) return name;
        var clean = name.split('/').pop().split('?')[0];
        if (this.assets && this.assets[clean]) return this.assets[clean];
        if (this.assetRoot) return this.assetRoot + clean;
        return 'assets/' + clean;
      }
    };
  </script>
</head>

<body class="{% if template.name == 'product' %}product-page{% elsif template.name == 'collection' %}{% if collection.handle == 'kids' %}kids-page{% else %}category-page shop-all-page{% endif %}{% elsif page.handle == 'shop-by-design' %}shop-by-design-page{% endif %} template-{{ template.name | handle }} {% if template.suffix %}template-suffix-{{ template.suffix | handle }}{% endif %}">
  <a class="sr-only" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main role="main" id="MainContent" class="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% section 'cart-drawer' %}
  {% section 'mobile-dock' %}

  <div class="toast" role="status" aria-live="polite"></div>

  {% comment %} Core Scripts {% endcomment %}
  <script src="{{ 'icons.js' | asset_url }}" defer></script>
  <script src="{{ 'kids-menu.js' | asset_url }}" defer></script>
  <script src="{{ 'commerce.js' | asset_url }}" defer></script>
</body>
</html>
