
    <div class="content-container pdp-content">
      <!-- Breadcrumb Navigation -->
      <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.copy_1 | escape }}</a>
        <span class="sep">♡</span>
        <a href="{{ routes.all_products_collection_url }}">{{ section.settings.copy_2 | escape }}</a>
        <span class="sep">♡</span>
        <span class="current" id="pdp-bc-current">{{ product.title | escape }}</span>
        <a class="pdp-back-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.copy_3 | escape }}</a>
      </nav>

      <!-- Main Two-Column PDP Section -->
      <section class="pdp-main-grid" aria-label="Product Details">
        <!-- Left: Image Gallery Showcase -->
        <div class="pdp-gallery">
          <div class="pdp-main-media">
            {% if product.featured_media.media_type == 'image' and product.featured_image != blank %}
              <img id="pdp-main-img" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            {% elsif product.featured_image != blank %}
              <img id="pdp-main-img" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            {% else %}
              <img id="pdp-main-img" src="{{ 'product-0.png' | asset_url }}" alt="{{ product.title | escape }}" width="800" height="800">
            {% endif %}
            <span class="pdp-badge gold" id="pdp-badge">{{ section.settings.copy_4 | escape }}</span>
          </div>

          <div class="pdp-thumbnails" role="tablist" aria-label="Product thumbnails">
            {% if product.media.size > 0 %}
              {% for media in product.media %}
                <button class="pdp-thumb-btn {% if forloop.first %}active{% endif %}" type="button" role="tab" aria-selected="{{ forloop.first }}" aria-label="View {{ forloop.index }}" data-media-target="media-{{ media.id }}" data-image-url="{{ media.preview_image | image_url: width: 1200 }}">
                  <img src="{{ media.preview_image | image_url: width: 160 }}" alt="{{ media.alt | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}">
                </button>
              {% endfor %}
            {% else %}
              <button class="pdp-thumb-btn active" type="button" role="tab" data-image-url="{{ 'product-0.png' | asset_url }}"><img src="{{ 'product-0.png' | asset_url }}" alt="Preview 1" width="160" height="160"></button>
              <button class="pdp-thumb-btn" type="button" role="tab" data-image-url="{{ 'collection-0.png' | asset_url }}"><img src="{{ 'collection-0.png' | asset_url }}" alt="Preview 2" width="160" height="160"></button>
              <button class="pdp-thumb-btn" type="button" role="tab" data-image-url="{{ 'shop-all-menu-product.png' | asset_url }}"><img src="{{ 'shop-all-menu-product.png' | asset_url }}" alt="Preview 3" width="160" height="160"></button>
              <button class="pdp-thumb-btn" type="button" role="tab" data-image-url="{{ 'hero-expanded.png' | asset_url }}"><img src="{{ 'hero-expanded.png' | asset_url }}" alt="Preview 4" width="160" height="160"></button>
            {% endif %}
          </div>
          <div class="pdp-extra-media" hidden>{% for media in product.media %}{% unless media.media_type == 'image' %}<div id="media-{{ media.id }}">{{ media | media_tag: image_size: '1200x', controls: true }}</div>{% endunless %}{% endfor %}</div>

          <div class="pdp-trust-row" aria-label="Product assurances">
            <div class="pdp-trust-item">
              <i>🌸</i>
              <div><strong>{{ section.settings.copy_5 | escape }}</strong><span>{{ section.settings.copy_6 | escape }}</span></div>
            </div>
            <div class="pdp-trust-item">
              <i>♻️</i>
              <div><strong>{{ section.settings.copy_7 | escape }}</strong><span>{{ section.settings.copy_8 | escape }}</span></div>
            </div>
            <div class="pdp-trust-item">
              <i>📦</i>
              <div><strong>{{ section.settings.copy_9 | escape }}</strong><span>{{ section.settings.copy_10 | escape }}</span></div>
            </div>
          </div>
        </div>

        <!-- Right: Details & Purchase Customizer -->
        <div class="pdp-details">
          <span class="pdp-brand-tag" id="pdp-brand-tag">{{ section.settings.copy_11 | escape }}</span>
          <h1 class="pdp-title" id="pdp-title">{{ product.title | escape }}</h1>

          <div class="pdp-rating-row">
            <span class="pdp-stars">★★★★★</span>
            {% if product.metafields.reviews.rating_count.value > 0 %}<span class="pdp-review-count">{{ product.metafields.reviews.rating.value.rating }} ({{ product.metafields.reviews.rating_count }} {{ section.settings.copy_12 | escape }}</span>{% endif %}
            <span class="pdp-verified-badge">{{ section.settings.copy_13 | escape }}</span>
          </div>

          <div class="pdp-price-row">
            <span class="pdp-current-price" id="pdp-price">{{ product.selected_or_first_available_variant.price | money }}</span>
            <span class="pdp-compare-price" id="pdp-compare-price">{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}{{ product.selected_or_first_available_variant.compare_at_price | money }}{% endif %}</span>
            <span class="pdp-discount-pill" id="pdp-save-pill">{% assign variant = product.selected_or_first_available_variant %}{% if variant.compare_at_price > variant.price %}{{ section.settings.copy_14 | escape }} {{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}%{% endif %}</span>
          </div>

          <div class="pdp-installments">
            {{ section.settings.copy_15 | escape }} <strong id="pdp-installment-amount">{{ section.settings.copy_16 | escape }}</strong> {{ section.settings.copy_17 | escape }} <strong>{{ section.settings.copy_18 | escape }}</strong> {{ section.settings.copy_19 | escape }} <strong>{{ section.settings.copy_20 | escape }}</strong>.
          </div>

          <p class="pdp-desc-text" id="pdp-desc">{{ product.description }}</p>

          {% form 'product', product, id: 'pdp-form' %}<input type="hidden" name="id" id="pdp-variant-id" value="{{ product.selected_or_first_available_variant.id }}">{% for option in product.options_with_values %}{% assign option_key = option.name | downcase %}<div class="pdp-option-group" data-option-index="{{ forloop.index0 }}"><div class="pdp-option-header"><span>{{ option.name | escape }}: <strong data-selected-option>{{ option.selected_value | escape }}</strong></span>{% if option_key contains 'size' %}<button class="pdp-size-guide-btn" id="open-size-guide" type="button">{{ section.settings.copy_21 | escape }}</button>{% endif %}</div><div class="pdp-option-chips" role="radiogroup" aria-label="{{ option.name | escape }}">{% for value in option.values %}<button class="{% if option_key contains 'shape' %}pdp-shape-chip{% elsif option_key contains 'length' %}pdp-length-chip{% else %}pdp-size-chip{% endif %} {% if option.selected_value == value %}active{% endif %}" type="button" data-option-value="{{ value | escape }}" role="radio" aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}">{% if option_key contains 'shape' %}{% assign icon = value | handleize | prepend: 'shape-' | append: '.png' %}<img src="{{ icon | asset_url }}" alt="" width="800" height="800">{% endif %}{{ value | escape }}</button>{% endfor %}</div></div>{% endfor %}<!-- Quantity -->
          <div class="pdp-actions-row">
            <div class="pdp-qty-wrap" aria-label="Select quantity">
              <button class="pdp-qty-btn" id="pdp-qty-minus" type="button" aria-label="Decrease quantity">−</button>
              <input class="pdp-qty-input" id="pdp-qty" name="quantity" type="number" min="1" value="1" aria-label="Quantity">
              <button class="pdp-qty-btn" id="pdp-qty-plus" type="button" aria-label="Increase quantity">+</button>
            </div>
            <button class="pdp-add-btn" id="pdp-add-btn" type="submit"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 14H4Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
              {{ section.settings.copy_22 | escape }}
            </button>
            <button class="pdp-buy-btn" id="pdp-buy-btn" type="button">{{ section.settings.copy_23 | escape }}</button>
          </div>

          {% endform %}<script type="application/json" data-product-json>{{ product | json }}</script>
<!-- Stock & Shipping Notice -->
          <div class="pdp-stock-banner">
            <span class="pdp-stock-dot"></span>
            <span><strong>{% if product.available %}{{ section.settings.copy_24 | escape }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</strong>{% if product.available %} {{ section.settings.copy_25 | escape }}{% endif %}</span>
          </div>

          <!-- Accordions -->
          <div class="pdp-accordions" aria-label="Product extra information">
            <!-- Accordion 1: Kit Contents -->
            <div class="pdp-accordion-item is-open">
              <button class="pdp-accordion-trigger" type="button" aria-expanded="true">
                <span>{{ section.settings.copy_26 | escape }}</span>
                <svg class="pdp-accordion-icon" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"/></svg>
              </button>
              <div class="pdp-accordion-content">
                <p>{{ section.settings.copy_27 | escape }}</p>
                <div class="pdp-kit-list">
                  <div class="pdp-kit-item"><i>♡</i> {{ section.settings.copy_28 | escape }}</div>
                  <div class="pdp-kit-item"><i>♡</i> {{ section.settings.copy_29 | escape }}</div>
                  <div class="pdp-kit-item"><i>♡</i> {{ section.settings.copy_30 | escape }}</div>
                  <div class="pdp-kit-item"><i>♡</i> {{ section.settings.copy_31 | escape }}</div>
                  <div class="pdp-kit-item"><i>♡</i> {{ section.settings.copy_32 | escape }}</div>
                  <div class="pdp-kit-item"><i>♡</i> {{ section.settings.copy_33 | escape }}</div>
                </div>
              </div>
            </div>

            <!-- Accordion 2: Application Guide -->
            <div class="pdp-accordion-item">
              <button class="pdp-accordion-trigger" type="button" aria-expanded="false">
                <span>{{ section.settings.copy_34 | escape }}</span>
                <svg class="pdp-accordion-icon" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"/></svg>
              </button>
              <div class="pdp-accordion-content">
                <ul>
                  <li><strong>{{ section.settings.copy_35 | escape }}</strong> {{ section.settings.copy_36 | escape }}</li>
                  <li><strong>{{ section.settings.copy_37 | escape }}</strong> {{ section.settings.copy_38 | escape }}</li>
                  <li><strong>{{ section.settings.copy_39 | escape }}</strong> {{ section.settings.copy_40 | escape }}</li>
                  <li><strong>{{ section.settings.copy_41 | escape }}</strong> {{ section.settings.copy_42 | escape }}</li>
                  <li><strong>{{ section.settings.copy_43 | escape }}</strong> {{ section.settings.copy_44 | escape }}</li>
                </ul>
              </div>
            </div>

            <!-- Accordion 3: Sizing & Fit -->
            <div class="pdp-accordion-item">
              <button class="pdp-accordion-trigger" type="button" aria-expanded="false">
                <span>{{ section.settings.copy_45 | escape }}</span>
                <svg class="pdp-accordion-icon" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"/></svg>
              </button>
              <div class="pdp-accordion-content">
                <p>{{ section.settings.copy_46 | escape }}</p>
                <ul>
                  <li><strong>{{ section.settings.copy_47 | escape }}</strong> {{ section.settings.copy_48 | escape }}</li>
                  <li><strong>{{ section.settings.copy_49 | escape }}</strong> {{ section.settings.copy_50 | escape }}</li>
                  <li><strong>{{ section.settings.copy_51 | escape }}</strong> {{ section.settings.copy_52 | escape }}</li>
                  <li><strong>{{ section.settings.copy_53 | escape }}</strong> {{ section.settings.copy_54 | escape }}</li>
                </ul>
                <p>{{ section.settings.copy_55 | escape }}</p>
              </div>
            </div>

            <!-- Accordion 4: Shipping & Returns -->
            <div class="pdp-accordion-item">
              <button class="pdp-accordion-trigger" type="button" aria-expanded="false">
                <span>{{ section.settings.copy_56 | escape }}</span>
                <svg class="pdp-accordion-icon" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"/></svg>
              </button>
              <div class="pdp-accordion-content">
                <p>{{ section.settings.copy_57 | escape }}</p>
                <ul>
                  <li><strong>{{ section.settings.copy_58 | escape }}</strong> {{ section.settings.copy_59 | escape }}</li>
                  <li><strong>{{ section.settings.copy_60 | escape }}</strong> {{ section.settings.copy_61 | escape }}</li>
                  <li><strong>{{ section.settings.copy_62 | escape }}</strong> {{ section.settings.copy_63 | escape }}</li>
                  <li><strong>{{ section.settings.copy_64 | escape }}</strong> {{ section.settings.copy_65 | escape }}</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Customer Benefits Bar -->
      <section class="benefits" aria-label="Customer benefits">
        <div><i>♧</i><p><b>{{ section.settings.copy_66 | escape }}</b><span>{{ section.settings.copy_67 | escape }}</span></p></div>
        <div><i>♢</i><p><b>{{ section.settings.copy_68 | escape }}</b><span>{{ section.settings.copy_69 | escape }}</span></p></div>
        <div><i>◷</i><p><b>{{ section.settings.copy_70 | escape }}</b><span>{{ section.settings.copy_71 | escape }}</span></p></div>
        <div><i>♡</i><p><b>{{ section.settings.copy_72 | escape }}</b><span>{{ section.settings.copy_73 | escape }}</span></p></div>
      </section>

      <!-- Customer Reviews Section -->
      {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}

      {% render 'product-reviews' %}
<!-- Related Products Section -->
      <section class="pdp-related-section" aria-labelledby="related-heading">
        <div class="pdp-related-header">
          <p class="pdp-related-script">{{ section.settings.copy_74 | escape }}</p>
          <h2 class="pdp-related-title" id="related-heading">{{ section.settings.copy_75 | escape }}</h2>
        </div>
        <div class="pdp-related-grid" id="pdp-related-grid" data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
          {%- if recommendations.performed and recommendations.products_count > 0 -%}
            {%- for product in recommendations.products -%}
              {%- render 'catalog-card', product: product, kind: 'design' -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign related_coll = product.collections.first | default: collections.all -%}
            {%- assign rel_count = 0 -%}
            {%- for rel_prod in related_coll.products -%}
              {%- unless rel_prod.id == product.id -%}
                {%- render 'catalog-card', product: rel_prod, kind: 'design' -%}
                {%- assign rel_count = rel_count | plus: 1 -%}
                {%- if rel_count == 4 -%}{%- break -%}{%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </section>

      <!-- Customer Services Row -->
      <section class="design-services" aria-label="Customer guarantees">
        <div>
          <div class="service-glyph">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M1 3h15v13H1z"/>
              <path d="M16 8h4l3 3v5h-7V8z"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <p><strong>{{ section.settings.copy_76 | escape }}</strong><span>{{ section.settings.copy_77 | escape }}</span></p>
        </div>
        <div>
          <div class="service-glyph">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <p><strong>{{ section.settings.copy_78 | escape }}</strong><span>{{ section.settings.copy_79 | escape }}</span></p>
        </div>
        <div>
          <div class="service-glyph">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <p><strong>{{ section.settings.copy_80 | escape }}</strong><span>{{ section.settings.copy_81 | escape }}</span></p>
        </div>
        <div>
          <div class="service-glyph">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <p><strong>{{ section.settings.copy_82 | escape }}</strong><span>{{ section.settings.copy_83 | escape }}</span></p>
        </div>
      </section>

      <!-- Instagram / Social Feed -->
      <section id="social" class="social" aria-labelledby="instagram-heading">
        <h2 id="instagram-heading">{{ section.settings.copy_84 | escape }} <a href="{{ section.settings.copy_85 | escape }}" target="_blank" rel="noopener noreferrer">{{ section.settings.copy_86 | escape }}</a> <span>♡</span></h2>
        <div id="social-grid" role="list" aria-label="Demo Instagram feed">
          <a class="instagram-card" href="{{ section.settings.copy_87 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'social-0.png' | asset_url }}{% endif %}" alt="Press By Heart look 1" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_88 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_2 != blank %}{{ section.settings.art_2 | image_url: width: 2000 }}{% else %}{{ 'social-1.png' | asset_url }}{% endif %}" alt="Press By Heart look 2" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_89 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_3 != blank %}{{ section.settings.art_3 | image_url: width: 2000 }}{% else %}{{ 'social-2.png' | asset_url }}{% endif %}" alt="Press By Heart look 3" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_90 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_4 != blank %}{{ section.settings.art_4 | image_url: width: 2000 }}{% else %}{{ 'social-3.png' | asset_url }}{% endif %}" alt="Press By Heart look 4" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_91 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_5 != blank %}{{ section.settings.art_5 | image_url: width: 2000 }}{% else %}{{ 'social-4.png' | asset_url }}{% endif %}" alt="Press By Heart look 5" loading="lazy" width="129" height="81"></a>
          <a class="instagram-card" href="{{ section.settings.copy_92 | escape }}" target="_blank" rel="noopener noreferrer"><img src="{% if section.settings.art_6 != blank %}{{ section.settings.art_6 | image_url: width: 2000 }}{% else %}{{ 'social-5.png' | asset_url }}{% endif %}" alt="Press By Heart look 6" loading="lazy" width="129" height="81"></a>
        </div>
      </section>
    </div>
  
{% render 'size-guide-modal' %}
<style>
  #review-modal.pdp-modal {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(30, 10, 18, 0.6) !important;
    backdrop-filter: blur(4px) !important;
    -webkit-backdrop-filter: blur(4px) !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 16px !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.24s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-sizing: border-box !important;
  }
  #review-modal.pdp-modal.is-open {
    opacity: 1 !important;
    pointer-events: auto !important;
    visibility: visible !important;
  }
  #review-modal .pdp-review-modal-dialog {
    background: #ffffff !important;
    border-radius: 16px !important;
    max-width: 480px !important;
    width: 100% !important;
    padding: 28px 24px !important;
    box-shadow: 0 20px 48px rgba(80, 20, 36, 0.22) !important;
    position: relative !important;
    max-height: 90vh !important;
    overflow-y: auto !important;
    box-sizing: border-box !important;
    border: 1.5px solid #fae2eb !important;
  }
  #review-modal .pdp-modal-close {
    position: absolute !important;
    top: 16px !important;
    right: 16px !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    border: 1px solid #ffd2e2 !important;
    background: #fff0f5 !important;
    color: #fa4087 !important;
    font-size: 16px !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1 !important;
    transition: background 0.18s ease, transform 0.18s ease !important;
    padding: 0 !important;
  }
  #review-modal .pdp-modal-close:hover {
    background: #ffe0ec !important;
    transform: scale(1.08) !important;
  }
  #review-modal .pdp-review-modal-header {
    margin-bottom: 18px !important;
    padding-right: 32px !important;
    text-align: left !important;
  }
  #review-modal .pdp-review-modal-header h3 {
    font-family: Georgia, 'Times New Roman', serif !important;
    font-size: 22px !important;
    color: #1a1a1a !important;
    margin: 0 0 6px 0 !important;
    font-weight: 700 !important;
    line-height: 1.25 !important;
  }
  #review-modal .pdp-review-modal-subtitle {
    font-family: Poppins, Arial, sans-serif !important;
    font-size: 13px !important;
    color: #7a6e74 !important;
    margin: 0 !important;
    line-height: 1.4 !important;
  }
  #review-modal .pdp-review-form {
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  #review-modal .pdp-review-rating-picker {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    text-align: left !important;
    margin-bottom: 2px !important;
  }
  #review-modal .pdp-star-rating-select {
    display: flex !important;
    flex-direction: row-reverse !important;
    justify-content: flex-end !important;
    gap: 4px !important;
  }
  #review-modal .pdp-star-btn {
    background: none !important;
    border: none !important;
    padding: 0 2px !important;
    font-size: 26px !important;
    color: #fa4087 !important;
    cursor: pointer !important;
    line-height: 1 !important;
    transition: transform 0.15s ease, color 0.15s ease !important;
    -webkit-tap-highlight-color: transparent !important;
  }
  #review-modal .pdp-star-btn:hover,
  #review-modal .pdp-star-btn:hover ~ .pdp-star-btn {
    color: #fa4087 !important;
    transform: scale(1.15) !important;
  }
  #review-modal .pdp-star-rating-select:hover .pdp-star-btn {
    color: #ffd2e2 !important;
