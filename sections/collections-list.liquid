<div class="content-container">
<section id="collections" class="collections">
  <h2 class="collections-title">{{ section.settings.title | default: 'SHOP BY COLLECTION' }} <span>♡</span></h2>
  <p class="intro">{{ section.settings.intro | default: 'Find the perfect set for every mood, moment and occasion.' }}</p>
  <div class="collection-grid" id="collection-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign coll_title = block.settings.title | default: coll.title | default: 'Collection' -%}
        {%- assign coll_url = block.settings.link | default: coll.url | default: routes.all_products_collection_url -%}
        {%- assign coll_desc = block.settings.description | default: coll.description -%}
        <article class="collection" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ coll_title | escape }} press-on nail designs" loading="lazy" width="130" height="154">
          {%- elsif coll.featured_image != blank -%}
            <img src="{{ coll.featured_image | image_url: width: 300 }}" alt="{{ coll_title | escape }} press-on nail designs" loading="lazy" width="130" height="154">
          {%- else -%}
            {%- assign default_img_index = forloop.index0 | modulo: 6 -%}
            <img src="{{ 'collection-' | append: default_img_index | append: '.png' | asset_url }}" alt="{{ coll_title | escape }} press-on nail designs" loading="lazy" width="130" height="154">
          {%- endif -%}
          <h2>{{ coll_title }}</h2>
          <p>{{ coll_desc }}</p>
          <a class="outline" href="{{ coll_url }}" aria-label="Shop {{ coll_title | escape }} collection">
            <span class="collection-button-label">{{ block.settings.button_text | default: 'SHOP COLLECTION' }}</span>
            <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
          </a>
        </article>
      {%- endfor -%}
    {%- else -%}
      {% comment %} Default approved prototype collections {% endcomment %}
      <article class="collection">
        <img src="{% if section.settings.art_1 != blank %}{{ section.settings.art_1 | image_url: width: 2000 }}{% else %}{{ 'collection-0.png' | asset_url }}{% endif %}" alt="The Classics press-on nail designs" loading="lazy" width="130" height="154">
        <h2>{{ section.settings.copy_1 | escape }}</h2>
        <p>{{ section.settings.copy_2 | escape }}<br>{{ section.settings.copy_3 | escape }}</p>
        <a class="outline" href="{{ routes.all_products_collection_url }}" aria-label="Shop The Classics collection">
          <span class="collection-button-label">{{ section.settings.copy_4 | escape }}</span>
          <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
        </a>
      </article>
      <article class="collection">
        <img src="{% if section.settings.art_2 != blank %}{{ section.settings.art_2 | image_url: width: 2000 }}{% else %}{{ 'collection-1.png' | asset_url }}{% endif %}" alt="The Pinks press-on nail designs" loading="lazy" width="130" height="154">
        <h2>{{ section.settings.copy_5 | escape }}</h2>
        <p>{{ section.settings.copy_6 | escape }}<br>{{ section.settings.copy_7 | escape }}</p>
        <a class="outline" href="{{ routes.all_products_collection_url }}" aria-label="Shop The Pinks collection">
          <span class="collection-button-label">{{ section.settings.copy_8 | escape }}</span>
          <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
        </a>
      </article>
      <article class="collection">
        <img src="{% if section.settings.art_3 != blank %}{{ section.settings.art_3 | image_url: width: 2000 }}{% else %}{{ 'collection-2.png' | asset_url }}{% endif %}" alt="The French press-on nail designs" loading="lazy" width="130" height="154">
        <h2>{{ section.settings.copy_9 | escape }}</h2>
        <p>{{ section.settings.copy_10 | escape }}<br>{{ section.settings.copy_11 | escape }}</p>
        <a class="outline" href="{{ routes.all_products_collection_url }}" aria-label="Shop The French collection">
          <span class="collection-button-label">{{ section.settings.copy_12 | escape }}</span>
          <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
        </a>
      </article>
      <article class="collection">
        <img src="{% if section.settings.art_4 != blank %}{{ section.settings.art_4 | image_url: width: 2000 }}{% else %}{{ 'collection-3.png' | asset_url }}{% endif %}" alt="Kawaii press-on nail designs" loading="lazy" width="130" height="154">
        <h2>{{ section.settings.copy_13 | escape }}</h2>
        <p>{{ section.settings.copy_14 | escape }}<br>{{ section.settings.copy_15 | escape }}</p>
        <a class="outline" href="{{ routes.all_products_collection_url }}" aria-label="Shop Kawaii collection">
          <span class="collection-button-label">{{ section.settings.copy_16 | escape }}</span>
          <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
        </a>
      </article>
      <article class="collection">
        <img src="{% if section.settings.art_5 != blank %}{{ section.settings.art_5 | image_url: width: 2000 }}{% else %}{{ 'collection-4.png' | asset_url }}{% endif %}" alt="Never Basic press-on nail designs" loading="lazy" width="130" height="154">
        <h2>{{ section.settings.copy_17 | escape }}</h2>
        <p>{{ section.settings.copy_18 | escape }}<br>{{ section.settings.copy_19 | escape }}<br>{{ section.settings.copy_20 | escape }}</p>
        <a class="outline" href="{{ routes.all_products_collection_url }}" aria-label="Shop Never Basic collection">
          <span class="collection-button-label">{{ section.settings.copy_21 | escape }}</span>
          <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
        </a>
      </article>
      <article class="collection">
        <img src="{% if section.settings.art_6 != blank %}{{ section.settings.art_6 | image_url: width: 2000 }}{% else %}{{ 'collection-5.png' | asset_url }}{% endif %}" alt="Festivities press-on nail designs" loading="lazy" width="130" height="154">
        <h2>{{ section.settings.copy_22 | escape }}</h2>
        <p>{{ section.settings.copy_23 | escape }}<br>{{ section.settings.copy_24 | escape }}<br>{{ section.settings.copy_25 | escape }}</p>
        <a class="outline" href="{{ routes.all_products_collection_url }}" aria-label="Shop Festivities collection">
          <span class="collection-button-label">{{ section.settings.copy_26 | escape }}</span>
          <svg class="collection-button-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
        </a>
      </article>
    {%- endif -%}
  </div>
</section>
</div>


