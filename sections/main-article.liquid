<div class="content-container" style="max-width: 780px; margin: 40px auto 80px auto; padding: 0 16px;">
  <article>
    <div style="text-align: center; margin-bottom: 30px;">
      <time style="font-size: 12px; color: #f93685; font-weight: 600; text-transform: uppercase;">
        {{ article.published_at | date: '%B %d, %Y' }}
      </time>
      <h1 style="font-family: 'Times New Roman', serif; font-size: clamp(30px, 4.5vw, 42px); line-height: 1.25; margin: 12px 0 16px 0;">
        {{ article.title }}
      </h1>
      <span style="font-size: 13px; color: #666;">{{ section.settings.copy_1 | escape }} {{ article.author }}</span>
    </div>

    {%- if article.image -%}
      <div style="margin-bottom: 32px; border-radius: 16px; overflow: hidden;">
        <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.title | escape }}" loading="lazy" style="width: 100%; height: auto; display: block;" width="{{ article.image.width }}" height="{{ article.image.height }}">
      </div>
    {%- endif -%}

    <div class="article-content" style="font-size: 15px; line-height: 1.8; color: #333;">
      {{ article.content }}
    </div>

    <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #ffdeea; text-align: center;">
      <a href="{{ blog.url }}" style="font-size: 13px; font-weight: 600; color: #f93685; text-decoration: none;">
        {{ section.settings.copy_2 | escape }} {{ blog.title }}
      </a>
    </div>
  </article>
</div>


{% schema %}{
  "name": "Article Content",
  "settings": [
    {
      "type": "text",
      "id": "copy_1",
      "label": "Copy: By",
      "default": "By"
    },
    {
      "type": "text",
      "id": "copy_2",
      "label": "Copy: ← Back to",
      "default": "← Back to"
    }
  ]
}{% endschema %}
