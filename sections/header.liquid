<style>

/* ==========================================================================
   BULLETPROOF BRAND LUXURY CART ICON (GLOBAL DESKTOP & MOBILE)
   ========================================================================== */
header .nav-bag,
.site-header .nav-bag,
.nav-bag,
.luxury-cart-btn {
  position: relative !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 38px !important;
  height: 38px !important;
  min-width: 38px !important;
  min-height: 38px !important;
  max-width: 38px !important;
  max-height: 38px !important;
  border-radius: 50% !important;
  background: linear-gradient(135deg, #fff5f8 0%, #ffeaf1 100%) !important;
  border: 1.5px solid #ffd3e2 !important;
  color: #fa4087 !important;
  text-decoration: none !important;
  box-shadow: 0 2px 8px rgba(250, 64, 135, 0.12) !important;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), background 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease !important;
  flex-shrink: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  vertical-align: middle !important;
  box-sizing: border-box !important;
  cursor: pointer !important;
}

header .nav-bag:hover,
.site-header .nav-bag:hover,
.nav-bag:hover,
.luxury-cart-btn:hover {
  transform: translateY(-2px) scale(1.05) !important;
  background: linear-gradient(135deg, #ffeef4 0%, #ffdbe7 100%) !important;
  border-color: #fa4087 !important;
  box-shadow: 0 4px 14px rgba(250, 64, 135, 0.24) !important;
  color: #fa4087 !important;
}

header .nav-bag:active,
.site-header .nav-bag:active,
.nav-bag:active,
.luxury-cart-btn:active {
  transform: translateY(0) scale(0.98) !important;
}

header .nav-bag svg,
header .nav-bag .bag-icon,
header .nav-bag .cart-icon,
header .nav-bag .icon,
.site-header .nav-bag svg,
.site-header .nav-bag .bag-icon,
.site-header .nav-bag .cart-icon,
.site-header .nav-bag .icon,
.nav-bag svg,
.nav-bag .bag-icon,
.nav-bag .cart-icon,
.nav-bag .icon,
.luxury-cart-btn svg {
  display: block !important;
  width: 19px !important;
  height: 19px !important;
  min-width: 19px !important;
  min-height: 19px !important;
  max-width: 19px !important;
  max-height: 19px !important;
  stroke: #fa4087 !important;
  stroke-width: 1.8 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;
  fill: none !important;
  flex-shrink: 0 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  pointer-events: none !important;
}

header .nav-bag svg .heart-accent,
.site-header .nav-bag svg .heart-accent,
.nav-bag svg .heart-accent,
.luxury-cart-btn svg .heart-accent,
header .nav-bag svg path[fill="#fa4087"],
.site-header .nav-bag svg path[fill="#fa4087"],
.nav-bag svg path[fill="#fa4087"] {
  fill: #fa4087 !important;
  stroke: none !important;
}

header .nav-bag svg circle,
.site-header .nav-bag svg circle,
.nav-bag svg circle,
.luxury-cart-btn svg circle {
  fill: #fa4087 !important;
  stroke: none !important;
}

header .nav-bag .bag-count,
.site-header .nav-bag .bag-count,
.nav-bag .bag-count,
.luxury-badge {
  position: absolute !important;
  top: -3px !important;
  right: -3px !important;
  min-width: 17px !important;
  height: 17px !important;
  min-height: 17px !important;
  max-height: 17px !important;
  padding: 0 4px !important;
  background: linear-gradient(135deg, #fa4087, #f13d84) !important;
  color: #ffffff !important;
  border-radius: 999px !important;
  border: 1.5px solid #ffffff !important;
  font-family: Poppins, -apple-system, BlinkMacSystemFont, Arial, sans-serif !important;
  font-size: 9.5px !important;
  font-weight: 700 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  pointer-events: none !important;
  box-sizing: border-box !important;
  box-shadow: 0 2px 6px rgba(250, 64, 135, 0.4) !important;
  z-index: 2 !important;
}

@media (max-width: 700px) {
  header .nav-bag,
  .site-header .nav-bag,
  .nav-bag,
  .luxury-cart-btn {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    min-height: 34px !important;
    max-width: 34px !important;
    max-height: 34px !important;
  }
  header .nav-bag svg,
  header .nav-bag .bag-icon,
  header .nav-bag .cart-icon,
  .site-header .nav-bag svg,
  .site-header .nav-bag .bag-icon,
  .site-header .nav-bag .cart-icon,
  .nav-bag svg,
  .nav-bag .bag-icon,
  .nav-bag .cart-icon,
  .luxury-cart-btn svg {
    width: 17px !important;
    height: 17px !important;
    min-width: 17px !important;
    min-height: 17px !important;
  }
  header .nav-bag .bag-count,
  .site-header .nav-bag .bag-count,
  .nav-bag .bag-count,
  .luxury-badge {
    top: -3px !important;
    right: -3px !important;
    font-size: 8.5px !important;
    min-width: 15px !important;
    height: 15px !important;
    min-height: 15px !important;
    padding: 0 3px !important;
  }
}

</style>
<header id="site-header" class="site-header">
  <a class="header-logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {% if section.settings.logo %}{{ section.settings.logo | image_url: width: 600 | image_tag: class: 'logo', widths: '150,300,600', alt: shop.name }}{% else %}<img class="logo" src="{{ 'logo-hq-v2.png' | asset_url }}" alt="{{ shop.name | escape }}" width="300" height="100">{% endif %}
  </a>
  <nav aria-label="Main navigation">
    {% assign navigation = section.settings.menu %}
    {% for link in navigation.links %}
      {% assign mega = nil %}
      {% assign link_key = link.title | handleize %}
      {% for block in section.blocks %}
        {% assign trigger_key = block.settings.trigger_title | handleize %}
        {% if block.settings.trigger_link == link.url or trigger_key == link_key %}{% assign mega = block %}{% break %}{% endif %}
      {% endfor %}
      {% if mega %}
        <a class="{{ mega.settings.layout }}-menu-toggle{% if link.active %} active{% endif %}" href="{{ link.url }}" data-mega-toggle aria-controls="MegaMenu-{{ section.id }}-{{ mega.id }}" aria-expanded="false"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}{% render 'icon', name: 'chevron_down', class: 'nav-chevron' %}</a>
      {% elsif link.links.size > 0 %}
        <div class="nav-dropdown-item"><a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title | escape }}{% render 'icon', name: 'chevron_down', class: 'nav-chevron' %}</a><div class="nav-dropdown-menu">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</div></div>
      {% else %}<a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
    {% endfor %}
  </nav>
  {% assign cart_icon_name = section.settings.cart_icon_style | default: 'cart' %}
  <a id="press-heart-cart" class="nav-bag luxury-cart-btn" href="{{ routes.cart_url }}" data-cart-trigger aria-label="{{ 'sections.cart.title' | t }}">
    {% if cart_icon_name == 'cart' %}
      <svg class="icon cart-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#f93685" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3h3.2l2.3 11a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.2l1.4-7H6.5"/><circle cx="10" cy="19.5" r="1.5" fill="#f93685" stroke="none"/><circle cx="17.5" cy="19.5" r="1.5" fill="#f93685" stroke="none"/><path class="heart-accent" d="M13.6 11.5c-1.3-.9-2.2-1.8-2.2-2.6 0-.6.5-1.1 1.1-1.1.5 0 .8.3 1 .6.2-.3.5-.6 1-.6.6 0 1.1.5 1.1 1.1 0 .8-.9 1.7-2 2.6Z" fill="#f93685" stroke="none"/></svg>
    {% else %}
      <svg class="icon bag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#f93685" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1l1.2 11.5A2 2 0 0 1 17.2 22H6.8a2 2 0 0 1-2-2.5L6 8Z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7"/><path class="heart-accent" d="M12 16.2c-2.4-1.6-4-3.3-4-4.8 0-1.2.9-2.1 2.1-2.1 1 0 1.6.6 1.9 1.1.3-.5.9-1.1 1.9-1.1 1.2 0 2.1.9 2.1 2.1 0 1.5-1.6 3.2-4 4.8Z" fill="#f93685" stroke="none"/></svg>
    {% endif %}
    <span class="bag-count luxury-badge press-heart-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
  </a>
  {% if section.settings.show_booking %}<a class="book" href="{{ section.settings.booking_link }}">{{ section.settings.booking_button_text | escape }}{% render 'icon', name: 'crown', class: 'crown-icon' %}</a>{% endif %}
  {% for block in section.blocks %}{% if block.type == 'mega_menu' %}{% render 'mega-menu', block: block, section: section %}{% endif %}{% endfor %}
</header>

<style>
#press-heart-cart.nav-bag{position:relative!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;box-sizing:border-box!important;flex:0 0 38px!important;width:38px!important;height:38px!important;min-width:38px!important;max-width:38px!important;min-height:38px!important;max-height:38px!important;margin:0!important;padding:0!important;background:#fff5f8!important;border:1.5px solid #ffd3e2!important;border-radius:50%!important;color:#f93685!important;line-height:1!important;text-decoration:none!important;box-shadow:0 2px 8px rgba(249,54,133,0.12)!important;overflow:visible!important;transition:transform .2s ease,background .2s ease,border-color .2s ease!important;cursor:pointer!important}
#press-heart-cart.nav-bag:hover{transform:translateY(-2px) scale(1.05)!important;background:#ffeaf1!important;border-color:#f93685!important}
#press-heart-cart.nav-bag:active{transform:scale(0.96)!important}
#press-heart-cart.nav-bag:focus-visible{outline:2px solid #f93685;outline-offset:3px}
#press-heart-cart.nav-bag svg{display:block!important;position:static!important;width:19px!important;height:19px!important;min-width:19px!important;max-width:19px!important;min-height:19px!important;max-height:19px!important;margin:0!important;padding:0!important;border:0!important;background:none!important;stroke:#f93685!important;stroke-width:1.8!important;fill:none!important;pointer-events:none!important;flex-shrink:0!important}
#press-heart-cart.nav-bag svg .heart-accent,
#press-heart-cart.nav-bag svg path[fill="#f93685"]{fill:#f93685!important;stroke:none!important}
#press-heart-cart.nav-bag svg circle{fill:#f93685!important;stroke:none!important}
#press-heart-cart.nav-bag .bag-count{position:absolute!important;display:flex!important;align-items:center!important;justify-content:center!important;box-sizing:border-box!important;top:-3px!important;right:-3px!important;bottom:auto!important;left:auto!important;min-width:17px!important;width:auto!important;height:17px!important;min-height:17px!important;max-height:17px!important;margin:0!important;padding:0 4px!important;border:1.5px solid #fff!important;border-radius:999px!important;background:#f93685!important;color:#fff!important;font-family:Poppins,Arial,sans-serif!important;font-size:9.5px!important;font-weight:700!important;line-height:1!important;box-shadow:0 2px 5px rgba(249,54,133,0.35)!important;transform:none!important;pointer-events:none!important;z-index:2!important}
@media(max-width:700px){
  header .mobile-app-menu-btn,
  .site-header .mobile-app-menu-btn,
  .mobile-app-menu-btn { display: none !important; }
  header a:has(.logo),
  header .header-logo-link,
  .site-header .header-logo-link {
    order: 1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    margin-right: auto !important;
    margin-left: 0 !important;
  }
  header .logo,
  .site-header .logo {
    margin: 0 !important;
    margin-right: auto !important;
    display: block !important;
    object-position: left center !important;
    height: 32px !important;
    width: auto !important;
    max-width: 140px !important;
  }
  header .book,
  .site-header .book {
    order: 2 !important;
    margin-left: auto !important;
  }
  #press-heart-cart.nav-bag{
    order: 3 !important;
    flex-basis:34px!important;width:34px!important;height:34px!important;min-width:34px!important;max-width:34px!important;min-height:34px!important;max-height:34px!important
  }
  #press-heart-cart.nav-bag svg{width:17px!important;height:17px!important;min-width:17px!important;max-width:17px!important;min-height:17px!important;max-height:17px!important}
  #press-heart-cart.nav-bag .bag-count{top:-3px!important;right:-3px!important;min-width:15px!important;height:15px!important;min-height:15px!important;font-size:8.5px!important;padding:0 3px!important}
}
</style>
