<div class="content-container error-404-content" style="max-width: 600px; margin: 80px auto; padding: 0 16px; text-align: center; min-height: 50vh;">
  <p style="color: #f93685; font-family: Allura, cursive; font-size: 52px; margin-bottom: 8px;">{{ section.settings.copy_1 | escape }}</p>
  <h1 style="font-family: 'Times New Roman', serif; font-size: 40px; margin-bottom: 16px;">{{ section.settings.copy_2 | escape }}</h1>
  <p style="color: #666; font-size: 14px; line-height: 1.6; margin-bottom: 28px;">
    {{ section.settings.copy_3 | escape }}
  </p>
  <a href="{{ routes.root_url }}" class="shop-button" style="display: inline-flex; text-decoration: none; margin: 0 auto;">
    {{ section.settings.copy_4 | escape }} <span>👑</span>
  </a>
</div>


{% schema %}{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "copy_1",
      "label": "Copy: Oops! ♡",
      "default": "Oops! ♡"
    },
    {
      "type": "text",
      "id": "copy_2",
      "label": "Copy: 404 &ndash; Page Not Found",
      "default": "404 &ndash; Page Not Found"
    },
    {
      "type": "text",
      "id": "copy_3",
      "label": "Copy: The page you are looking for might have been moved or no lo",
      "default": "The page you are looking for might have been moved or no longer exists. Let's get you back to discovering gorgeous press-on nails!"
    },
    {
      "type": "text",
      "id": "copy_4",
      "label": "Copy: BACK TO HOME",
      "default": "BACK TO HOME"
    }
  ]
}{% endschema %}
