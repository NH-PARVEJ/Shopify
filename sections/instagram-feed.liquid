<div class="content-container">
<section id="social" class="social" aria-labelledby="instagram-heading">
  <h2 id="instagram-heading">
    {{ section.settings.heading | default: 'FOLLOW US' }}
    <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/pressbyheart/' }}" target="_blank" rel="noopener noreferrer">
      {{ section.settings.account_handle | default: '@PRESSBYHEART' }}
    </a>
    <span>♡</span>
  </h2>

  <div id="social-grid" role="list" aria-label="Instagram feed">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <a class="instagram-card" role="listitem"
          href="{{ block.settings.url | default: section.settings.instagram_url | default: 'https://www.instagram.com/pressbyheart/' }}"
          target="_blank" rel="noopener noreferrer"
          aria-label="{{ block.settings.caption | default: 'View on Instagram' | escape }}"
          {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.caption | default: 'Instagram post' | escape }}" loading="lazy" width="129" height="81">
          {%- else -%}
            {%- assign default_social_idx = forloop.index0 | modulo: 6 -%}
            <img src="{{ 'social-' | append: default_social_idx | append: '.png' | asset_url }}" alt="{{ block.settings.caption | default: 'Instagram post' | escape }}" loading="lazy" width="129" height="81">
          {%- endif -%}
          <span class="instagram-overlay" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7"/></svg>
            <span>{{ section.settings.copy_1 | escape }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {% comment %} Default Approved Prototype Instagram Feed (6 Cards) {% endcomment %}
      {%- assign demo_captions = "Everyday nude nail inspiration,Pretty in pink press-on nails,Unbox your instant beauty,Your next pink manicure,Glossy French nail designs,A little pink delivery" | split: "," -%}
      {%- for i in (0..5) -%}
        <a class="instagram-card" role="listitem"
          href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/pressbyheart/' }}"
          target="_blank" rel="noopener noreferrer"
          aria-label="{{ demo_captions[i] }} — view @pressbyheart on Instagram">
          <img src="{{ 'social-' | append: i | append: '.png' | asset_url }}" alt="{{ demo_captions[i] }}" loading="lazy" width="129" height="81">
          <span class="instagram-overlay" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7"/></svg>
            <span>{{ section.settings.copy_2 | escape }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
</div>


{% schema %}{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Prefix",
      "default": "FOLLOW US"
    },
    {
      "type": "text",
      "id": "account_handle",
      "label": "Account Handle",
      "default": "@PRESSBYHEART"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile Link"
    },
    {
      "type": "text",
      "id": "copy_1",
      "label": "Copy: View on Instagram",
      "default": "View on Instagram"
    },
    {
      "type": "text",
      "id": "copy_2",
      "label": "Copy: View on Instagram",
      "default": "View on Instagram"
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Accessibility Caption",
          "default": "View on Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed"
    }
  ]
}{% endschema %}
